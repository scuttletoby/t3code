[
  {
    "name": "fork-ci release tags: never moved or deleted",
    "target": "tag",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": { "ref_name": { "include": ["refs/tags/ci/*"], "exclude": [] } },
    "rules": [{ "type": "deletion" }, { "type": "update" }]
  },
  {
    "name": "fork-ci release branch: no force push or delete",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": { "ref_name": { "include": ["refs/heads/ci-release"], "exclude": [] } },
    "rules": [{ "type": "deletion" }, { "type": "non_fast_forward" }]
  }
]
