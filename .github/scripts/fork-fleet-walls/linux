# @/etc/pw) or any other character a path has not. It ends at the word's end, or at any character of NOT_PLAIN_PATH
# (\w is Unicode's: /etc/restic/pässwort), which a file's name may hold or not (/etc/restic/pass,word; /etc/pw,ro):
# each end is read.
PATH_START = re.compile(r'(?<![\w.+-])/')
NOT_PLAIN_PATH = re.compile(r'[^\w.@+/-]')
