def read(path):
    try:
        with open(ROOT + path, encoding='utf-8', errors='replace') as f:
            return f.read().strip()
    except OSError:
        return None


def mounts():
    """(mount point, fs type) of every mount, from mountinfo (points unescaped: \\040 is a space)."""
    text = read('/proc/self/mountinfo')
    if text is None:
        raise ValueError('cannot read /proc/self/mountinfo')
    out = []
    for line in text.splitlines():
        left, _, right = line.partition(' - ')
        fields = left.split()
        if len(fields) < 5 or not right:
            raise ValueError(f'/proc/self/mountinfo has a line that is not a mount: {line[:80]!r}')
        out.append((re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), fields[4]), right.split()[0]))
    return out


def os_wall():
    release = read('/proc/sys/kernel/osrelease')
    if read('/proc/sys/kernel/ostype') != 'Linux' or release is None:
        return 'no Linux /proc/sys/kernel/ostype and osrelease'
    if ('microsoft' in release.lower() or any(glob.glob(glob.escape(ROOT) + m) for m in WSL_MARKS)
            or WSL_CMDLINE in (read('/proc/cmdline') or '')):
        return f'this is WSL ({release}): its walls are fork-fleet-walls/wsl2'
    return None


def kernel_wall():
    m = re.match(r'(\d+)\.(\d+)', read('/proc/sys/kernel/osrelease') or '')
    if not m:
        return 'cannot read the kernel version in /proc/sys/kernel/osrelease'
    if (int(m.group(1)), int(m.group(2))) < (5, 8):
        return f'kernel {m.group(0)}: before 5.8, systemd drops ProtectProc and jobs see every process'
    return None


def systemd_wall():
    comm = read('/proc/1/comm')
    return None if comm == 'systemd' else f'PID 1 is {comm or "unknown"}: the launcher runs jobs as systemd units'


def cgroup_wall():
    kinds = [kind for point, kind in mounts() if point == '/sys/fs/cgroup']
    if kinds[-1:] != ['cgroup2']:
        return (f'/sys/fs/cgroup is {kinds[-1] if kinds else "not mounted"}, not cgroup2: without the unified '
                'hierarchy systemd drops IPAddressDeny, the jobs\' second firewall')
    return None


def cgroup_bpf_wall():
    """CONFIG_CGROUP_BPF, from the first of these that can be read: the kernel's config in /boot or /proc/config.gz,
    or its symbols (/proc/kallsyms names are readable even where their addresses are hidden)."""
    release = read('/proc/sys/kernel/osrelease') or ''
    configs = [f'/boot/config-{release}'] if re.fullmatch(r'[A-Za-z0-9._+-]+', release) else []
    for path, opener in [(p, open) for p in configs] + [('/proc/config.gz', gzip.open)]:
        try:
            with opener(ROOT + path, 'rt', encoding='utf-8', errors='replace') as f:
                found = any(line.strip() == 'CONFIG_CGROUP_BPF=y' for line in f)
        except OSError:
            continue
        return None if found else f'{path} has no CONFIG_CGROUP_BPF=y'
    try:
        with open(ROOT + '/proc/kallsyms', encoding='utf-8', errors='replace') as f:
            found = any(line.rstrip('\n').endswith(' __cgroup_bpf_run_filter_skb') for line in f)
    except OSError:
        return 'cannot read the kernel config (/boot/config-<release>, /proc/config.gz) nor /proc/kallsyms'
    return None if found else '/proc/kallsyms has no __cgroup_bpf_run_filter_skb'


def namespaces_wall():
    missing = [n for n in ('ipc', 'mnt', 'net') if not os.path.lexists(f'{ROOT}/proc/self/ns/{n}')]
    if missing:
        return (f'no {", ".join(missing)} namespaces (/proc/self/ns): systemd drops PrivateIPC without an error, '
                'and the jobs\' own network and file view need the others')
    return None


def seccomp_wall():
    actions = (read('/proc/sys/kernel/seccomp/actions_avail') or '').split()
    if 'errno' not in actions:
        return 'no seccomp filters (/proc/sys/kernel/seccomp/actions_avail): systemd drops the jobs\' system-call walls'
    return None


def container_wall():
    found = [p for p in ('/run/systemd/container', '/.dockerenv', '/run/.containerenv') if os.path.lexists(ROOT + p)]
    if found:
        return f'{found[0]} is there: in a container systemd drops some of the jobs\' walls without an error'
    return None


def ask(verb, what):
    """The lines of a read-only verb of the launcher (`paths`, `tools`), run as the pool runs it: with its conf lookup
    (FORK_FLEET_LAUNCH_CONF too: the one place of it). A launcher not safe as owned_safe wants it, or one that refuses
    (what), raises."""
    st = os.lstat(LAUNCHER)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError(f'{LAUNCHER} is a link, or not owned by uid {os.geteuid()} and writable by it alone')
    env = {'PATH': os.environ.get('PATH', '/usr/sbin:/usr/bin:/sbin:/bin'), 'LC_ALL': 'C'}
    env.update({k: os.environ[k] for k in ('FORK_FLEET_WALLS_ROOT', 'FORK_FLEET_LAUNCH_CONF') if os.environ.get(k)})
    p = subprocess.run([LAUNCHER, verb], env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                       timeout=30, cwd='/')
    if p.returncode != 0:
        why = (p.stderr.strip().splitlines() or [f'exit {p.returncode}'])[-1]
        raise ValueError(f'the launcher refuses {what}: {why}')
    return p.stdout.splitlines()


def job_view():
    """What a job sees of this host's files: `fork-fleet-launch.sh paths`, job_fs's own rule (the one place of it, with
    the launcher's conf lookup and every link resolved): (where in the job, real host path) for each path it binds.
    The launcher refuses a path no job may see (/home, /mnt, ..., or one that leads there): the wall then fails."""
    view = [line.split(' ') for line in ask('paths', 'what jobs would see')]
    if not view or not all(len(v) == 2 and all(PLAIN.fullmatch(x) for x in v) for v in view):
        raise ValueError(f'the launcher\'s `paths` printed no list of "<in the job> <host path>" lines')
    return view


def on_local_disk(table, p):
    """The fs type and point of the mount that holds p: the deepest point, and of two on one point the later one (it
    is on top)."""
    held = [(point, kind) for point, kind in table if p == point or p.startswith(point.rstrip('/') + '/')]
    return max(reversed(held), key=lambda m: len(m[0])) if held else ('', 'nothing')


def mounts_wall():
    """Every mount of this host but those that hold a path jobs see stays out of their units (an allow list, each path
    without its submounts): those few must be this host's own disks. A share, a data disk mounted anywhere (/srv,
    /data, /net, /mnt) or a mount made later is fine: no job sees it."""
    table = mounts()
    shared = []
    for _, real in job_view():
        point, kind = on_local_disk(table, real)
        if kind not in LOCAL_FS:
            shared.append(f'{real} (on {kind} at {point or "?"})')
    if shared:
        return (f'jobs see {", ".join(shared[:3])}: not a disk of this host\'s own; a share\'s I/O goes out past the '
                'network walls')
    return None


def dropins(folders=DROPIN_FOLDERS, units=(), every=None):
    """Every drop-in file (*.conf, a link followed) in these drop-in folders that systemd applies (not shadowed), and
    every unit file of these names, in DROPIN_DIRS: [path], sorted, each once."""
    found = {p[len(ROOT):] for d in DROPIN_DIRS for f in folders
             for p in glob.glob(glob.escape(ROOT + d) + '/' + f + '/*.conf')}
    found = {p for p in found if not shadowed(p, every or {})}
    found |= {d + '/' + u for d in DROPIN_DIRS for u in units}
    return sorted(p for p in found if os.path.isfile(ROOT + p))


def shadowed(path, every):
    """Whether systemd applies another drop-in of path's name instead of it, to every unit path applies to. Of
    drop-ins with one name it applies the first only: by DROPIN_DIRS, and in one of them the unit's own folder first,
    then its prefixes' (longest first), then the type's (every: {folder that applies to every job unit: its place
    there}). So one in the same folder of an earlier dir shadows it, and one in a folder of every that comes first. It
    shadows as a file or a link to /dev/null (a mask); a dangling link may not: kept (it fails closed)."""
    d, f, name = path.rsplit('/', 2)
    i = DROPIN_DIRS.index(d)
    return any((j, every.get(g, 0)) < (i, every.get(f, 0)) and (
                   os.path.isfile(ROOT + f'{e}/{g}/{name}') or os.path.realpath(ROOT + f'{e}/{g}/{name}') == '/dev/null')
               for j, e in enumerate(DROPIN_DIRS[:i + 1]) for g in {f, *every})


def after_reset(values):
    """The words of a list setting that count, as systemd reads a list: an empty assignment drops all before it, and a
    word ends at a blank, a tab or a line end only (UNIT_BLANKS: a form feed is part of a word, which is then none)."""
    last = max((i for i, v in enumerate(values) if not v), default=-1)
    return [w for v in values[last + 1:] for w in re.split(f'[{UNIT_BLANKS}]+', v) if w]


def networks(words):
    """The address prefixes of an IPAddressAllow= or IPAddressDeny= list (ADDRESS_WORDS for the names). A word that is
    neither: ValueError (cannot tell)."""
    out = []
    for w in words:
        for x in ADDRESS_WORDS.get(w, (w,)):
            try:
                out.append(ipaddress.ip_network(x, strict=False))
            except ValueError:
                raise ValueError(f'{w!r} is no address prefix') from None
    return out


def within(prefixes, cover):
    """The prefixes of prefixes no network of cover holds."""
    return [p for p in prefixes if not any(p.version == c.version and p.subnet_of(c) for c in cover)]


def seconds(value):
    """A systemd time span (systemd.time(7): `90`, `5min 20s`, `1h30m`, `infinity`) in seconds; 0 is infinity, as
    systemd reads a stop timeout. Any other text: ValueError (cannot tell)."""
    units = {'us': 1e-6, 'usec': 1e-6, 'µs': 1e-6, 'ms': 1e-3, 'msec': 1e-3, '': 1, 's': 1, 'sec': 1, 'second': 1,
             'seconds': 1, 'm': 60, 'min': 60, 'minute': 60, 'minutes': 60, 'h': 3600, 'hr': 3600, 'hour': 3600,
             'hours': 3600, 'd': 86400, 'day': 86400, 'days': 86400, 'w': 604800, 'week': 604800, 'weeks': 604800,
             'M': 2629800, 'month': 2629800, 'months': 2629800, 'y': 31557600, 'year': 31557600, 'years': 31557600}
    value = value.strip(UNIT_BLANKS)
    if value == 'infinity':
        return float('inf')
    parts = re.findall(f'[{UNIT_BLANKS}]*' + r'(\d+(?:\.\d*)?)' + f'[{UNIT_BLANKS}]*' + r'([A-Za-zµ]*)', value)
    if (not value or ''.join(n + u for n, u in parts) != re.sub(f'[{UNIT_BLANKS}]', '', value)
            or any(u not in units for _, u in parts)):
        raise ValueError(f'{value!r} is no time span')
    total = sum(float(n) * units[u] for n, u in parts)
    return total or float('inf')


def endless(lines, keys):
    """The stop timeouts (keys) these lines set past STOP_MAX: ['Key=value']. An empty one resets the default."""
    return [f'{k}={v}' for _, k, v in lines if k in keys and v and seconds(v) > STOP_MAX]


def file_lines(path, section=None):
    """unit_lines of a file under ROOT; one that cannot be read raises (cannot tell)."""
    with open(ROOT + path, encoding='utf-8', errors='replace') as f:
        return unit_lines(f.read(), section)


def reset_left(path, deny):
    """What a drop-in's IPAddressDeny= lines (deny, its [Service] ones) that start with or hold a reset no longer
    refuse: the reason, or None. systemd writes a reset only in SET_PROPERTY's file, and there the list after it is
    the unit's own list merged with refresh-net's; so it must still hold all of the unit's own list (the host's own
    address too, which JOB_DENY has not), and JOB_DENY. A reset anywhere else, or for a unit that is not here (its
    own file gone: a later unit of that name would take it): a FAIL."""
    m = SET_PROPERTY.fullmatch(path)
    if not m:
        return 'IPAddressDeny= (an empty one: systemd writes that only in set-property\'s own file)'
    try:
        own = after_reset([v for _, k, v in file_lines(f'/run/systemd/transient/{m.group(1)}', 'Service')
                           if k == 'IPAddressDeny'])
    except FileNotFoundError:
        return f'IPAddressDeny= (an empty one, for {m.group(1)}, which is not running)'
    left = within(networks(list(JOB_DENY) + own), networks(after_reset(deny)))
    return f'IPAddressDeny= (an empty one, then a list without {left[0]})' if left else None


def job_units_wall():
    """The launcher starts each job's unit with systemd-run and its properties (the walls): nothing may change them
    on the way. A drop-in that applies to the job units (DROPIN_DIRS, DROPIN_FOLDERS: /etc, /run and /usr, for every
    service or for fork-fleet-*) and sets anything but DROPIN_SAFE (PrivateDevices=no, a BindPaths=, an empty
    SystemCallFilter=, ...), an endless stop timeout, or a reset of IPAddressDeny= (reset_left), turns a wall off
    where the launcher cannot see it; so does a slice above them (SLICE_UNITS, SLICE_FOLDERS) that allows more than
    localhost, or sets another firewall of its own (SLICE_OPENS), and systemd's default stop timeout (MANAGER_MAIN,
    MANAGER_CONFS) when endless. A list counts only in the section systemd reads it in ([Service], [Slice]). A SYSTEMD_RUN or SYSTEMCTL (the launcher's `tools`, as its settings set them) that
    is not systemd's own (LAUNCH_TOOLS) starts the units with a program that may drop any property. A file that
    cannot be read, or a value that cannot be read (an address, a time span): cannot tell."""
    bad = []
    for path in dropins(every=EVERY_JOB_UNIT):
        lines = file_lines(path)
        keys = sorted({k for _, k, v in lines if k not in DROPIN_SAFE and k != 'IPAddressDeny'})
        deny = [v for _, k, v in file_lines(path, 'Service') if k == 'IPAddressDeny']   # systemd drops the others
        left = reset_left(path, deny) if any(not v for v in deny) else None   # without a reset, a list only adds
        if left:
            keys.append(left)
        keys += endless(lines, STOP_TIMEOUTS)
        if keys:
            bad.append(f'{path} sets {", ".join(keys[:4])} for the job units')
    for path in dropins(SLICE_FOLDERS, SLICE_UNITS):
        lines = file_lines(path)
        keys = sorted({k for _, k, _ in lines if SLICE_OPENS.fullmatch(k) and k != 'IPAddressAllow'})
        allow = within(networks(after_reset([v for _, k, v in file_lines(path, 'Slice') if k == 'IPAddressAllow'])),
                       networks(['localhost']))
        if allow:
            keys.append(f'IPAddressAllow={allow[0]}')
        if keys:
            bad.append(f'{path} sets {", ".join(keys[:4])} for the slice the job units sit in')
    main = [p for p in MANAGER_MAIN if os.path.exists(ROOT + p)][:1]   # a link to /dev/null too; not a dangling one
    for path in [p for p in main if os.path.isfile(ROOT + p)] + sorted(
            {p[len(ROOT):] for t in MANAGER_CONFS for p in glob.glob(glob.escape(ROOT) + t) if os.path.isfile(p)}):
        keys = endless(file_lines(path), MANAGER_STOP_TIMEOUTS)
        if keys:
            bad.append(f'{path} sets {", ".join(keys[:2])} for every unit, the job units among them')
    tools = [line.split(' ', 1) for line in ask('tools', 'to say what it starts job units with')]
    if sorted(t[0] for t in tools) != sorted(LAUNCH_TOOLS) or any(len(t) != 2 for t in tools):
        raise ValueError('the launcher\'s `tools` printed no SYSTEMD_RUN and SYSTEMCTL lines')
    bad += [f'the launcher\'s settings set {k}={v}, not systemd\'s own' for k, v in tools if v not in LAUNCH_TOOLS[k]]
    if bad:
        return '; '.join(bad[:3]) + (f' (and {len(bad) - 3} more)' if len(bad) > 3 else '') + \
            ': drop it (or move what it sets elsewhere): the job units must get exactly what the launcher asks'
    return None


def others_read(path, last=0o004):
    """Whether a user with no claim on path (a job's runner user) can read it (last=0o001: enter the folder): every
    folder above it searchable by others, and it readable by others."""
    try:
        parts = path.strip('/').split('/')
        for i in range(len(parts)):
            mode = os.stat(ROOT + '/' + '/'.join(parts[:i + 1])).st_mode
            if not mode & (last if i == len(parts) - 1 else 0o001):
                return False
    except OSError:
        return False
    return True


def readable(patterns):
    """The files (no folders) these globs find under ROOT that others can read, sorted, each once."""
    return sorted({p[len(ROOT):] for t in patterns for p in glob.glob(glob.escape(ROOT) + t)
                   if os.path.isfile(p) and others_read(p[len(ROOT):])})


def secret_kind(name):
    """What a variable's name says it holds: '' no secret (no word of it SECRET_WORD); 'value' a secret; 'file' a
    file that holds one, 'command' a command that gives one (only FILE_WORDS, or only COMMAND_WORDS, after the secret
    word); 'about' something about one (any other ABOUT word after it: AWS_ACCESS_KEY_ID_FILE holds an id)."""
    words = [w.upper() for w in name.split('_') if w]
    last = max((i for i, w in enumerate(words) if SECRET_WORD.fullmatch(w)
                and not (w in ('KEY', 'KEYS') and i and words[i - 1] in PUBLIC_WORDS)), default=None)
    if last is None:
        return ''
    about = {w for w in words[last + 1:] if w in ABOUT}
    if not about:
        return 'value'
    return 'file' if about <= FILE_WORDS else 'command' if about <= COMMAND_WORDS else 'about'


def unquote(value):
    """A value as a shell, fish or systemd file has it, its quotes ('...', "...", $'...', $"...") taken off, and the
    default of ${X:-value} for it."""
    value = value.strip()
    if value[:2] in ('$\'', '$"'):
        value = value[1:]
    if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
        value = value[1:-1]
    m = DEFAULT.fullmatch(value)
    return unquote(m.group(1)) if m else value


def secret_value(value, unit=False):
    """Whether a value is a secret of its own: not empty, not a command ($(...), `...`, fish's (...)), not another
    variable ($X, ${X}), not an array, and none of the shapes that are no secret only when they truly are that kind
    (A_PATH's comment). unit: the value is a unit's (Environment=), where systemd expands a specifier."""
    value = unquote(value)
    if not value or value.startswith(('$', '`', '(')) or value.lower() in NOT_SECRET or HOME_PATH.fullmatch(value):
        return False
    if unit and A_SPECIFIER.fullmatch(value):
        return False
    if A_PATH.fullmatch(value) and os.path.exists(ROOT + value):
        return bool(exposed(value))
    return True


def file_exposed(value, unit=False):
    """Whether a *_FILE value names a file (a folder: a file in it) that is here and others can read: in a unit, its
    specifiers read as unit_paths reads them (%d, the unit's own credentials, is none of this host's files)."""
    value = unquote(value)
    if unit and '%' in value:
        return not value.startswith('%d/') and any(exposed(p) for p in unit_paths(value))
    return bool(A_PATH.fullmatch(value) and exposed(value))


def literal(word):
    """Whether a word of a command is text of its own: not a variable, a command or an option, nor printf's %s."""
    return (not word.startswith(('$', '`', '-'))
            and re.sub(r'%[-#0 +]*\d*(?:\.\d+)?[A-Za-z%]|\\.', '', word).strip() != '')


def command_secret(value, unit=False, depth=0):
    """Whether a *_COMMAND value gives a secret to whoever runs it, as a job could: it holds the secret as text, or
    reads it from a file others can read. Each simple command of it (split at ; & | and brackets) is read: a secret's
    NAME=value or --option=value (--password hunter2); an echo or printf of literal text, and a here-string of it
    (<<<text; a here-document, <<); a script in its words (INLINE, SCRIPTED); any file others can read that it names
    (an argument, an option's value or a redirect's: sed -n 1p /etc/pw, --password-file=/etc/pw, cat</etc/pw) but its
    program (INTERPRETERS' script too) and a LOCKED file; and what a shell runs (sh -c '...'), or any word with a blank
    in it (eval '...', su -c '...'), read again. A value it cannot split, or one nested deeper than 4: a secret."""
    value = unquote(value)
    if depth > 4:
        return True
    try:
        lex = shlex.shlex(value, posix=True, punctuation_chars=';&|()<>')
        lex.whitespace_split = True
        words = list(lex)
    except ValueError:
        return True
    commands = [[]]
    for w in words:
        if w and not w.strip(';&|()'):
            commands.append([])
        else:
            commands[-1].append(w)
    return any(simple_secret(c, unit, depth) for c in commands if c)


def simple_secret(words, unit, depth):
    """command_secret of one simple command: [word]."""
    for i, word in enumerate(words):
        name, eq, v = word.partition('=')
        if eq and re.fullmatch(r'[A-Za-z_]\w*', name) and secret_assignment(name, v, unit):
            return True
        if word.startswith('--'):
            name, eq, v = word[2:].partition('=')
            if secret_kind(name.replace('-', '_')) == 'value' and secret_value(
                    v if eq else (words[i + 1] if i + 1 < len(words) else ''), unit):
                return True
        if word.startswith('<<') and (word != '<<<' or i + 1 == len(words) or literal(words[i + 1])):
            return True
        if i and re.search(r'\s', word) and command_secret(word, unit, depth + 1):
            return True
        prog, rest = os.path.basename(word), words[i + 1:]
        if SHELLS.fullmatch(prog):
            script = next((rest[k + 1] for k, w in enumerate(rest[:-1]) if re.fullmatch(r'-[A-Za-z]*c[A-Za-z]*', w)),
                          None)
            if script is not None and not re.search(r'\s', script) and command_secret(script, unit, depth + 1):
                return True
        elif inline_script(prog, rest) or (prog in ('echo', 'printf') and any(literal(w) for w in rest)):
            return True
    while words and (re.fullmatch(r'[A-Za-z_]\w*=.*', words[0]) or os.path.basename(words[0]) in WRAPPERS):
        words = words[1:]
        while words and words[0].startswith('-'):   # the wrapper's options (env -i, nice -n 5: the 5 is no program)
            words = words[1 + (words[0] in ('-n', '-u', '-a')):]
    if not words:
        return False
    prog, args = os.path.basename(words[0]), words[1:]
    if INTERPRETERS.fullmatch(prog):   # its script is its program: the words before it and it are not its input
        first = next((i for i, w in enumerate(args) if not w.startswith('-')), len(args))
        args = args[first + 1:]
    return any(not m[0].endswith(LOCKED) and exposed(m[0])
               for w in args for m in PATH_IN.finditer(re.sub(r'^-[A-Za-z]', '', w)))


def inline_script(prog, args):
    """Whether a program (a word of a command, args the words after it) runs a script given in those words: awk or
    sed (SCRIPTED), or an interpreter with an option of INLINE (perl -ne, node --eval) before its script's file (the
    first word that is a file here; an option's value may come before it)."""
    if SCRIPTED.fullmatch(prog):
        return True
    flags = INLINE.get(re.sub(r'[\d.]+$', '', prog))
    for w in args if flags else ():
        if w.startswith('--') and w.partition('=')[0] in INLINE_LONG or re.fullmatch(f'-[^-]*[{flags}].*', w):
            return True
        if A_PATH.fullmatch(w) and os.path.isfile(ROOT + w):
            return False
    return False


def secret_assignment(name, value, unit=False):
    """Whether NAME=value sets a secret jobs can read: by the name's kind (secret_kind), its value read as that."""
    kind = secret_kind(name)
    if kind == 'value':
        return secret_value(value, unit)
    if kind == 'file':
        return file_exposed(value, unit)
    if kind == 'command':
        return command_secret(value, unit)
    return False


def kind_of(path):
    """What a file is to this host, for ADVICE: one every login reads, a unit, a mount table, or a file of its own."""
    def under(globs):
        return any(fnmatch.fnmatchcase(path, g) for g in globs)
    if under(ENV_FILES):
        return 'login'
    if under(MOUNT_TABLES):
        return 'mount'
    if any(path.startswith(d + '/') for d in UNIT_DIRS):
        return 'unit'
    return 'file'


def shaped(path, n, line):
    """A known token's shape anywhere on the line (a comment too: the file still holds it), or a URL's password."""
    out = []
    if TOKEN_SHAPE.search(line):
        out.append(f'{path} line {n} (a token)')
    if not line.lstrip().startswith(('#', ';')) and URL_PASSWORD.search(line):
        out.append(f'{path} line {n} (a password in a URL)')
    return out


def env_secrets(path, seen):
    """What a login, session or service environment file (ENV_FILES, SERVICE_FILES, or a unit's EnvironmentFile=)
    holds that is a secret: [(where, path)]."""
    if path in seen:
        return []
    seen.add(path)
    out = []
    for n, line in enumerate((read(path) or '').splitlines(), 1):
        out += shaped(path, n, line)
        if line.lstrip().startswith('#'):
            continue
        sets = [m.groups() for r in (ASSIGN, PAM_ENV, SET_DEFAULT) for m in r.finditer(line)]
        sets += [m.groups() for m in SETENV.finditer(line) if not m.group(2).startswith('#')]   # `#`: a comment
        sets += [m.groups()[1:] for m in FISH_SET.finditer(line)
                 if not m.group(3).startswith('#') and not any(FISH_ASKS.fullmatch(f) for f in m.group(1).split())]
        names = sorted({name for name, value in sets if secret_assignment(name, value)})
        out += [f'{path} line {n} ({name})' for name in names]
    return [(where, path) for where in out]


def unit_lines(text, section=None):
    """(line number, key, value) of each assignment in a systemd unit, drop-in or config file, as systemd reads it
    (systemd.syntax(7)): a line ends at \\n, \\r, \\r\\n or \\0 only (UNIT_LINE_END; not at a form feed or U+2028,
    as Python's splitlines() would), and only blanks, tabs and line ends (UNIT_BLANKS) are stripped; a comment line
    (# or ;) skipped; a line ending in a backslash continued on the next, the
    backslash a blank, a comment line inside it skipped; blanks around the key and the `=` dropped. section (Service,
    Slice, Manager): only the lines in that [section], as systemd takes a setting only in the section it belongs to; it
    drops one in any other section (an X- one, [Unit], [Install]) or before the first, and so does this."""
    out, buf, start, at = [], None, 0, None

    def keep(buf):
        key, eq, value = buf.partition('=')
        if eq and (section is None or at == section):
            out.append((start, key.strip(UNIT_BLANKS), value.strip(UNIT_BLANKS)))
    for n, raw in enumerate(UNIT_LINE_END.split(text), 1):
        line = raw.strip(UNIT_BLANKS)
        if buf is None:
            if line[:1] == '[':
                at = line[1:-1] if line.endswith(']') else None   # a broken header: systemd takes nothing after it
                continue
            if not line or line[0] in '#;':
                continue
            buf, start = '', n
        elif line[:1] in ('#', ';'):
            continue
        if line.endswith('\\'):
            buf += line[:-1] + ' '
            continue
        keep(buf + line)
        buf = None
    if buf:
        keep(buf)
    return out


def files_in(path):
    """path if it is a file others can read; if a folder, each such file in it."""
    full = ROOT + path
    if os.path.isdir(full):
        try:
            return [p for p in (path.rstrip('/') + '/' + f for f in sorted(os.listdir(full)))
                    if os.path.isfile(ROOT + p) and others_read(p)]
        except OSError:
            return []
    return [path] if os.path.isfile(full) and others_read(path) else []


def public_only(path):
    """Whether a file under ROOT plainly holds only public keys and certificates (PUBLIC_BLOCK, SSH_PUBLIC; blank and
    # lines between them): nothing secret in it, whoever reads it."""
    try:
        if os.path.getsize(ROOT + path) > PUBLIC_MAX:
            return False
        with open(ROOT + path, encoding='utf-8', errors='replace') as f:
            text = f.read().replace('\r\n', '\n')
    except OSError:
        return False
    blocks = list(PUBLIC_BLOCK.finditer(text))
    rest = [line.strip() for line in PUBLIC_BLOCK.sub('', text).splitlines()]
    rest = [line for line in rest if line and not line.startswith('#')]
    return (bool(blocks or rest) and all(public_block(m[1], m[2]) for m in blocks)
            and all(ssh_public(line) for line in rest))


def public_block(kind, body):
    """Whether a PUBLIC_BLOCK's body is base64 of what its markers (kind) say, and nothing else: DER, one SEQUENCE
    whose length is all the rest (a TRUSTED CERTIFICATE: a certificate and its trust, two); an OpenPGP public key,
    whose first packet is one (tag 6), in PGP_ARMOR."""
    if kind == 'PGP PUBLIC KEY BLOCK':
        m = PGP_ARMOR.fullmatch(body)
        body = m[2] if m else '!'
    data = ''.join(body.split('\n'))
    if not data or not BASE64.fullmatch(data):
        return False
    raw = base64.b64decode(data)
    if kind == 'PGP PUBLIC KEY BLOCK':
        return raw[0] == 0xc6 or raw[0] & 0xfc == 0x98   # new format tag 6, or old format tag 6
    at, seqs = 0, 0
    while at < len(raw):
        if at + 2 > len(raw) or raw[at] != 0x30:
            return False
        size, at = raw[at + 1], at + 2
        if size & 0x80:
            if not 1 <= size & 0x7f <= 4:
                return False
            size, at = int.from_bytes(raw[at:at + (size & 0x7f)], 'big'), at + (size & 0x7f)
        at, seqs = at + size, seqs + 1
    return at == len(raw) and seqs <= (2 if kind == 'TRUSTED CERTIFICATE' else 1)


def ssh_public(line):
    """Whether a line is one SSH public key (SSH_PUBLIC): its base64 a key of the type it names, its comment short."""
    m = SSH_PUBLIC.fullmatch(line)
    if not m or len(m[3]) > SSH_COMMENT or not BASE64.fullmatch(m[2]):
        return False
    blob = base64.b64decode(m[2])
    size = int.from_bytes(blob[:4], 'big')
    return blob[4:4 + size] == m[1].encode() and len(blob) > 4 + size


def exposed(path):
    """files_in(path) that may hold a secret: those not public_only."""
    return [f for f in files_in(path) if not public_only(f)]


def unit_paths(value):
    """The files a unit's path names, as systemd would on any instance: each specifier (%i, %I, %N, ...) any text, and
    a wildcard (EnvironmentFile= takes one) any file; %% is a %. Sorted, under ROOT."""
    pattern = re.sub(r'%(.)', lambda m: '%' if m.group(1) == '%' else '*', value)
    return sorted(p[len(ROOT):] for p in glob.glob(glob.escape(ROOT) + pattern))


def unit_secrets(path, seen):
    """A unit's, drop-in's or systemd config's secret: a variable with a secret's name and value in Environment=
    (DefaultEnvironment=, ManagerEnvironment=), any SetCredential= value, a LoadCredential= or EnvironmentFile= that
    others can read (one with a secret in it; a wildcard or a specifier in its path read as every file it may name:
    unit_paths); and any line shaped like a token. A LoadCredential= by name alone reads CREDSTORES, read on their
    own (credstores). [(where, path of the file)]"""
    text = read(path) or ''
    out = [(where, path) for n, line in enumerate(text.splitlines(), 1) for where in shaped(path, n, line)]
    for n, key, value in unit_lines(text):
        if key in UNIT_ENV:
            try:
                items = shlex.split(value)
            except ValueError:
                items = value.split()
            names = sorted({k for k, eq, v in (x.partition('=') for x in items)
                            if eq and secret_assignment(k, v, unit=True)})
            out += [(f'{path} line {n} ({name})', path) for name in names]
        elif key == 'SetCredential':
            cred, colon, data = value.partition(':')
            if colon and data.strip():
                out.append((f'{path} line {n} (SetCredential={cred})', path))
        elif key == 'LoadCredential':
            cred, _, source = value.partition(':')
            if source.startswith('/'):
                out += [(f'{f} (LoadCredential={cred} of {path}; others can read it)', f)
                        for found in unit_paths(source) for f in files_in(found)]
        elif key == 'EnvironmentFile':
            env = value[1:] if value.startswith('-') else value
            if env.startswith('/'):
                for found in unit_paths(env):
                    if os.path.isfile(ROOT + found) and others_read(found):
                        out += env_secrets(found, seen)
    return out


def readable_under(top, name=None):
    """Every file under top (and its folders) that others can read and whose name fits name (a regex), sorted."""
    out = []
    for folder, dirs, files in os.walk(ROOT + top):
        dirs[:] = [d for d in dirs if others_read(os.path.join(folder, d)[len(ROOT):], 0o001)]
        out += [p[len(ROOT):] for p in (os.path.join(folder, f) for f in files if not name or name.fullmatch(f))
                if os.path.isfile(p) and others_read(p[len(ROOT):])]
    return sorted(out)


def unit_files():
    """Every unit, drop-in and config file of UNIT_DIRS others can read, each once (a link to a packaged unit, or /lib
    that is /usr/lib, read once: by the file it is)."""
    out, seen = [], set()
    for top in UNIT_DIRS:
        for path in readable_under(top, None if top == '/etc/systemd' else UNIT_FILE):
            try:
                st = os.stat(ROOT + path)
            except OSError:
                continue
            if (st.st_dev, st.st_ino) not in seen:
                seen.add((st.st_dev, st.st_ino))
                out.append(path)
    return out


def credstores():
    """Every credential in CREDSTORES (not .encrypted) others can read: [(where, path)]."""
    return [(f'{f} (a credential; others can read it)', f) for top in CREDSTORES for f in readable_under(top)]


def token_file(path):
    """Whether a file (a plain one, not a link) holds a known token's shape anywhere."""
    try:
        with open(ROOT + path, 'rb') as f:
            data = f.read(SHAPE_MAX + 1)
    except OSError:
        return False
    return len(data) <= SHAPE_MAX and TOKEN_BYTES.search(data) is not None


def etc_secrets_wall():
    """Jobs see this host's /etc (the launcher's list has it) and /usr: no secret may be in either that they can
    read. A credentials file (smbcredentials, *.cred, ...) readable by others; a line of a mount table (MOUNT_TABLES:
    fstab, autofs maps, systemd mount and automount units and their drop-ins) with password= or pass=, or with a
    credentials= or cred= file others can read; a secret in a login or session environment file (ENV_FILES) or a
    service's (SERVICE_FILES: by name and value, by a token's shape, or a URL's password); a secret in a systemd unit
    (UNIT_DIRS: Environment=, SetCredential=, or a LoadCredential= or EnvironmentFile= others can read); a credential
    in systemd's credential stores (CREDSTORES) others can read; a known token's shape in any other file of /etc. A
    file only its owner reads is fine. The advice fits the file (ADVICE): a file every login reads cannot be made
    private, so its secret must move out. Not covered: see ENV_FILES' comment; a
    secret with no known name or shape in some other file of /etc; a unit's secret on its command line (ExecStart=)."""
    found, plain = [], []
    for folder, dirs, files in os.walk(ROOT + '/etc'):
        dirs[:] = [d for d in dirs if others_read(os.path.join(folder, d)[len(ROOT):], 0o001)]   # else no entry
        for name in files:
            path = os.path.join(folder, name)[len(ROOT):]
            if not others_read(path):
                continue
            if SECRET_NAME.fullmatch(name):
                found.append((f'{path} (others can read it)', path))
            elif os.path.isfile(ROOT + path) and not os.path.islink(ROOT + path):
                plain.append(path)
    for table in readable(MOUNT_TABLES):
        for n, line in enumerate((read(table) or '').splitlines(), 1):
            if line.lstrip().startswith(('#', ';')):
                continue
            if MOUNT_PASSWORD.search(line):
                found.append((f'{table} line {n} (a password)', table))
            for cred in MOUNT_CRED.findall(line):
                if cred.startswith('/') and others_read(cred):
                    found.append((f'{table} line {n} ({cred}, which others can read)', cred))
    seen = set()
    for env in readable(ENV_FILES + SERVICE_FILES):
        found += env_secrets(env, seen)
    units = unit_files()
    for unit in units:
        found += unit_secrets(unit, seen)
    found += credstores()
    read_whole = seen | set(units) | set(readable(MOUNT_TABLES))
    found += [(f'{path} (a token)', path) for path in plain if path not in read_whole and token_file(path)]
    if found:
        listed = '; '.join(f'{where}: {ADVICE[kind_of(path)]}' for where, path in found[:3])
        more = f' (and {len(found) - 3} more)' if len(found) > 3 else ''
        return f'jobs can read a secret on this host: {listed}{more}'
    return None


WALLS = [
    ('os', 'a plain Linux kernel, not WSL', os_wall),
    ('kernel', 'kernel 5.8 or newer (per-mount /proc, so jobs see no other process)', kernel_wall),
    ('systemd', 'systemd is PID 1', systemd_wall),
    ('cgroup2', '/sys/fs/cgroup is cgroup2 only', cgroup_wall),
    ('cgroup-bpf', 'the kernel has cgroup BPF (else systemd drops IPAddressDeny without an error)', cgroup_bpf_wall),
    ('namespaces', 'the kernel has IPC, mount and network namespaces', namespaces_wall),
    ('seccomp', 'seccomp filters are available', seccomp_wall),
    ('container', 'not in a container', container_wall),
    ('mounts', 'jobs see only the launcher\'s allow list of system paths, on this host\'s own disks; no other '
               'mount', mounts_wall),
    ('job-units', 'no systemd drop-in nor launcher setting changes the job units the launcher asks for',
     job_units_wall),
    ('etc-secrets', 'no password for a share, nor a secret in the login environment or a unit, in /etc or /usr '
                    'that jobs can read', etc_secrets_wall),
]


def text(s):
    """s on one line, every control character (ESC, CR, ...) and line or bidi mark escaped: a mount's name never
    reaches a terminal raw."""
    return re.sub('[\x00-\x1f\x7f-\x9f\u061c\u200e\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069]',
                  lambda m: f'\\x{ord(m[0]):02x}' if ord(m[0]) < 0x100 else f'\\u{ord(m[0]):04x}', s)


def main(argv):
    if len(argv) != 1 or argv[0] not in ('check', 'describe'):
        print('usage: linux check | describe', file=sys.stderr)
        return 2
    failed = False
    for wall, what, test in WALLS:
        try:
            why = test()
        except Exception as e:   # a wall that cannot be told does not hold
            why = f'cannot tell ({e.__class__.__name__}: {e})'
        failed |= why is not None
        if why is not None:
            print(f'FAIL  {wall}  ' + text(f'{what}: {why}')[:400])
        elif argv[0] == 'describe':
            print(f'PASS  {wall}  {what}')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
