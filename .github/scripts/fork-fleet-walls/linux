def read(path, strip=True):
    """A file's text under ROOT (bytes that are no UTF-8 as U+FFFD), stripped; None when it cannot be read."""
    try:
        with open(ROOT + path, encoding='utf-8', errors='replace') as f:
            return f.read().strip() if strip else f.read()
    except OSError:
        return None


def mounts():
    """(mount point, fs type) of every mount, from mountinfo (points unescaped: \\040 is a space)."""
    text = read('/proc/self/mountinfo')
    if text is None:
        raise ValueError('cannot read /proc/self/mountinfo')
    out = []
    for line in text.splitlines():
        left, _, right = line.partition(' - ')
        fields = left.split()
        if len(fields) < 5 or not right:
            raise ValueError(f'/proc/self/mountinfo has a line that is not a mount: {line[:80]!r}')
        out.append((re.sub(r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), fields[4]), right.split()[0]))
    return out


def os_wall():
    release = read('/proc/sys/kernel/osrelease')
    if read('/proc/sys/kernel/ostype') != 'Linux' or release is None:
        return 'no Linux /proc/sys/kernel/ostype and osrelease'
    if ('microsoft' in release.lower() or any(glob.glob(glob.escape(ROOT) + m) for m in WSL_MARKS)
            or WSL_CMDLINE in (read('/proc/cmdline') or '')):
        return f'this is WSL ({release}): its walls are fork-fleet-walls/wsl2'
    return None


def kernel_wall():
    m = re.match(r'(\d+)\.(\d+)', read('/proc/sys/kernel/osrelease') or '')
    if not m:
        return 'cannot read the kernel version in /proc/sys/kernel/osrelease'
    if (int(m.group(1)), int(m.group(2))) < (5, 8):
        return f'kernel {m.group(0)}: before 5.8, systemd drops ProtectProc and jobs see every process'
    return None


def systemd_wall():
    comm = read('/proc/1/comm')
    return None if comm == 'systemd' else f'PID 1 is {comm or "unknown"}: the launcher runs jobs as systemd units'


def cgroup_wall():
    kinds = [kind for point, kind in mounts() if point == '/sys/fs/cgroup']
    if kinds[-1:] != ['cgroup2']:
        return (f'/sys/fs/cgroup is {kinds[-1] if kinds else "not mounted"}, not cgroup2: without the unified '
                'hierarchy systemd drops IPAddressDeny, the jobs\' second firewall')
    return None


def cgroup_bpf_wall():
    """CONFIG_CGROUP_BPF, from the first of these that can be read: the kernel's config in /boot or /proc/config.gz,
    or its symbols (/proc/kallsyms names are readable even where their addresses are hidden)."""
    release = read('/proc/sys/kernel/osrelease') or ''
    configs = [f'/boot/config-{release}'] if re.fullmatch(r'[A-Za-z0-9._+-]+', release) else []
    for path, opener in [(p, open) for p in configs] + [('/proc/config.gz', gzip.open)]:
        try:
            with opener(ROOT + path, 'rt', encoding='utf-8', errors='replace') as f:
                found = any(line.strip() == 'CONFIG_CGROUP_BPF=y' for line in f)
        except OSError:
            continue
        return None if found else f'{path} has no CONFIG_CGROUP_BPF=y'
    try:
        with open(ROOT + '/proc/kallsyms', encoding='utf-8', errors='replace') as f:
            found = any(line.rstrip('\n').endswith(' __cgroup_bpf_run_filter_skb') for line in f)
    except OSError:
        return 'cannot read the kernel config (/boot/config-<release>, /proc/config.gz) nor /proc/kallsyms'
    return None if found else '/proc/kallsyms has no __cgroup_bpf_run_filter_skb'


def namespaces_wall():
    missing = [n for n in ('ipc', 'mnt', 'net') if not os.path.lexists(f'{ROOT}/proc/self/ns/{n}')]
    if missing:
        return (f'no {", ".join(missing)} namespaces (/proc/self/ns): systemd drops PrivateIPC without an error, '
                'and the jobs\' own network and file view need the others')
    return None


def seccomp_wall():
    actions = (read('/proc/sys/kernel/seccomp/actions_avail') or '').split()
    if 'errno' not in actions:
        return 'no seccomp filters (/proc/sys/kernel/seccomp/actions_avail): systemd drops the jobs\' system-call walls'
    return None


def container_wall():
    found = [p for p in ('/run/systemd/container', '/.dockerenv', '/run/.containerenv') if os.path.lexists(ROOT + p)]
    if found:
        return f'{found[0]} is there: in a container systemd drops some of the jobs\' walls without an error'
    return None


def launcher_safe(st):
    """Raises unless st (the launcher's lstat or fstat) is a plain file owned by this uid and writable by it alone."""
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError(f'{LAUNCHER} is a link, or not owned by uid {os.geteuid()} and writable by it alone')


def ask(verb, what):
    """The lines of a read-only verb of the launcher (`paths`, `tools`), run as the pool runs it: with its conf lookup
    (FORK_FLEET_LAUNCH_CONF too: the one place of it). A launcher not safe as owned_safe wants it, or one that refuses
    (what), raises."""
    launcher_safe(os.lstat(LAUNCHER))
    env = {'PATH': os.environ.get('PATH', '/usr/sbin:/usr/bin:/sbin:/bin'), 'LC_ALL': 'C'}
    env.update({k: os.environ[k] for k in ('FORK_FLEET_WALLS_ROOT', 'FORK_FLEET_LAUNCH_CONF') if os.environ.get(k)})
    p = subprocess.run([LAUNCHER, verb], env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                       timeout=30, cwd='/')
    if p.returncode != 0:
        why = (p.stderr.strip().splitlines() or [f'exit {p.returncode}'])[-1]
        raise ValueError(f'the launcher refuses {what}: {why}')
    return p.stdout.splitlines()


def job_view():
    """What a job sees of this host's files: `fork-fleet-launch.sh paths`, job_fs's own rule (the one place of it, with
    the launcher's conf lookup and every link resolved): (where in the job, real host path) for each path it binds.
    The launcher refuses a path no job may see (/home, /mnt, ..., or one that leads there): the wall then fails."""
    view = [line.split(' ') for line in ask('paths', 'what jobs would see')]
    if not view or not all(len(v) == 2 and all(PLAIN.fullmatch(x) for x in v) for v in view):
        raise ValueError(f'the launcher\'s `paths` printed no list of "<in the job> <host path>" lines')
    return view


def on_local_disk(table, p):
    """The fs type and point of the mount that holds p: the deepest point, and of two on one point the later one (it
    is on top)."""
    held = [(point, kind) for point, kind in table if p == point or p.startswith(point.rstrip('/') + '/')]
    return max(reversed(held), key=lambda m: len(m[0])) if held else ('', 'nothing')


def but_resolv(view):
    """The view but its last line when that is the launcher's own resolv.conf for jobs (`paths` prints it last), kept
    in /etc/fork-fleet by default: no other file there (its conf) and no RESOLV_CONF the owner set elsewhere
    is let off."""
    return view[:-1] if view and list(view[-1]) == ['/etc/resolv.conf', '/etc/fork-fleet/resolv.conf'] else view


def secret_etc(p):
    """Whether p is an /etc entry of SECRET_ETC, is in one, or is a folder that holds one; or has a folder named
    private in it (ssl/private and the like, wherever a tool keeps one). Outside /etc: whether p is a path of
    SECRET_ELSEWHERE, in one, or a folder that holds one (/var)."""
    if not p.startswith('/etc/'):
        return any(p == s or p.startswith(s + '/') or s.startswith(p.rstrip('/') + '/') for s in SECRET_ELSEWHERE)
    return 'private' in p.split('/') or any(
        fnmatch.fnmatchcase(p, s) or fnmatch.fnmatchcase(p, s + '/*') or s.startswith(p + '/') for s in SECRET_ETC)


def secret_inodes():
    """{(device, inode): what} of each SECRET_ETC and SECRET_ELSEWHERE entry this host has and each entry named
    private under /etc (secret_etc's own rule, issue #636) ('the secret path'), and of each folder above one ('a folder
    that holds the secret path', '/' too): a bind mount or hard link of one at another path is the same device and
    inode (issue #613 item 7). One that is not there is skipped; one that cannot be read: cannot tell (ValueError)."""
    entries, holders = {}, {}
    found = [path for pattern in SECRET_ETC + SECRET_ELSEWHERE
             for path in sorted(glob.glob(glob.escape(ROOT) + pattern))]
    private, links = private_entries()
    for path in found + private + links:
        rel = path[len(ROOT):]
        st = stat_or_none(rel)
        if st is None:
            continue
        if path in links:   # its target (stat follows the link) is secret, the folders above that target are not
            entries.setdefault((st.st_dev, st.st_ino), f'{rel}, a link named private (to what it leads to)')
            continue
        entries.setdefault((st.st_dev, st.st_ino), rel)
        folder = rel
        while folder != '/':
            folder = os.path.dirname(folder)
            st = stat_or_none(folder)
            if st is not None:
                holders.setdefault((st.st_dev, st.st_ino), f'{folder}, a folder that holds {rel}')
    return {**holders, **entries}   # an entry that also holds one is named as the entry


def private_entries():
    """Every folder or file named private under /etc, then every link named private there, as paths under ROOT, each
    list sorted: ([], []) when there is no /etc. One that cannot be listed: cannot tell (ValueError). A link (issue
    #656) is not walked into, and secret_inodes counts its target as secret but not the folders above that target
    (a link to /usr/share must not refuse all of /usr, and one to /srv/app-keys still protects the keys); secret_etc
    refuses the link's own path by name."""
    def failed(e):
        if not isinstance(e, (FileNotFoundError, NotADirectoryError)):   # gone while walked: nothing there
            raise ValueError(f'cannot list {(e.filename or "?")[len(ROOT):]} ({e.strerror})')
    if not os.path.isdir(ROOT + '/etc'):
        return [], []
    named = [os.path.join(top, d) for top, dirs, files in os.walk(ROOT + '/etc', onerror=failed)
             for d in dirs + files if d == 'private']
    return sorted(p for p in named if not os.path.islink(p)), sorted(p for p in named if os.path.islink(p))


def stat_or_none(path):
    """os.stat of a path under ROOT, links followed: None when it is not there; any other error: cannot tell."""
    try:
        return os.stat(ROOT + path)
    except (FileNotFoundError, NotADirectoryError):
        return None
    except OSError as e:
        raise ValueError(f'cannot read {path} ({e.strerror})') from None


def same_as_secret(real, inodes):
    """What secret path real is by device and inode, or is inside (a folder above it is a secret entry itself, not
    one that only holds one): None when neither. Not found, as the walls stat only real and the folders above it,
    never what is in real or in a secret folder (.github/fork-fleet.md): a single file or sub-folder of a secret folder
    bind-mounted or hard-linked on its own elsewhere, and a hard link of a secret file inside an allowed folder (a
    bind there is not seen by jobs: norbind). Only root can make either."""
    st = stat_or_none(real)
    if st is not None and (st.st_dev, st.st_ino) in inodes:
        return inodes[(st.st_dev, st.st_ino)]
    folder = real
    while folder != '/':
        folder = os.path.dirname(folder)
        st = stat_or_none(folder)
        what = inodes.get((st.st_dev, st.st_ino), '') if st is not None else ''
        if what and ', a folder that holds ' not in what:
            return f'{what}, a folder that holds it'
    return None


def launcher_refuses(p):
    """Whether today's launcher refuses p itself (LAUNCHER_REFUSES)."""
    return any(fnmatch.fnmatchcase(p, s) for s in LAUNCHER_REFUSES)


def mounts_wall():
    """Every mount of this host but those that hold a path jobs see stays out of their units (an allow list, each path
    without its submounts): those few must be this host's own disks. A share, a data disk mounted anywhere (/srv,
    /data, /net, /mnt) or a mount made later is fine: no job sees it."""
    table = mounts()
    shared = []
    view = job_view()
    # Issue #243: an allow list of /etc, never all of it (the logins, units, cron and backup tools' folders beside the
    # few entries a build needs). Today's launcher refuses that itself; an older one (its kit's list) does not.
    whole = sorted({f'{dest} from {real}' for dest, real in view if '/etc' in (dest, real)})
    if whole:
        return (f'jobs see all of /etc ({", ".join(whole[:3])}): an older kit\'s list; re-run the installer, whose '
                'list names only the /etc entries builds need')
    # Issue #370 item 1: nor an /etc entry that holds secrets, or a folder of one (ALLOW_PATHS=/etc/shadow, /etc/ssl);
    # issue #594: nor one that names this host's accounts (/etc/passwd-, /etc/subuid, /var/backups).
    # Issue #613 item 3: the way out names where the line is. One the launcher refuses itself: an older launcher's
    # (re-run the installer); any other: the owner's ALLOW_PATHS or JOB_PATHS file (the installer's list has none).
    named = [(dest, real) for dest, real in but_resolv(view) if secret_etc(dest) or secret_etc(real)]
    secret = sorted({dest if dest == real else f'{dest} (that is {real})' for dest, real in named})
    if secret:
        # Issue #636: both ways out when both kinds are there (an older launcher's line and the owner's), not one a run.
        older = [launcher_refuses(dest) or launcher_refuses(real) for dest, real in named]
        if all(older):
            fix, more = ('bound by an older launcher, which does not refuse it itself: re-run the installer',
                         'its launcher then refuses it and names where the line is')
        elif any(older):   # both at once: both ways out
            fix, more = ('an older launcher binds some: re-run the installer; take the rest out of ALLOW_PATHS or '
                         'JOB_PATHS', 'the installer\'s own list never has one')
        else:
            fix, more = ('take it out of ALLOW_PATHS, or of the JOB_PATHS file the launcher\'s conf names',
                         'the installer\'s own list never has one; allow only the files a build needs')
        # Issue #656: the way out, short, before the paths, and the rest after them: long paths fill the line's
        # 400-character cap (main) and cut what comes after them, never the way out.
        return (f'jobs see a path that holds this host\'s secrets or account names, or a folder of one: {fix}; the '
                f'paths: {", ".join(secret[:3])} ({more})')
    # Issue #613 item 7: nor one of those at another path (a bind mount, a hard link): the same device and inode.
    inodes = secret_inodes()
    same = sorted({f'{dest} (the same as {what})' for dest, real in but_resolv(view)
                   for what in [same_as_secret(real, inodes)] if what})
    if same:
        return ('jobs see a bind mount or hard link of a path that holds this host\'s secrets or account names: take '
                f'it out of ALLOW_PATHS, or of the JOB_PATHS file the launcher\'s conf names; the paths: '
                f'{", ".join(same[:3])} (allow only the files a build needs)')
    for _, real in view:
        point, kind = on_local_disk(table, real)
        if kind not in LOCAL_FS:
            shared.append(f'{real} (on {kind} at {point or "?"})')
    if shared:
        return (f'jobs see {", ".join(shared[:3])}: not a disk of this host\'s own; a share\'s I/O goes out past the '
                'network walls')
    return None


def entries(folder):
    """The names in a folder under ROOT, as systemd lists one (conf_files: not a hidden one): [] when it is not there
    or is no folder (systemd skips it); one that is there but cannot be listed raises (cannot tell)."""
    if not os.path.isdir(ROOT + folder):
        return []
    try:
        return [n for n in os.listdir(ROOT + folder) if not n.startswith('.')]
    except OSError as e:
        raise ValueError(f'cannot list {folder} ({e.strerror})') from None


def dropins(folders=DROPIN_FOLDERS, units=(), every=None):
    """Every drop-in file (*.conf, a link followed) in these drop-in folders that systemd applies (not shadowed), and
    every unit file of these names, in DROPIN_DIRS: [path], sorted, each once. A folder that cannot be listed: cannot
    tell."""
    found = {f'{d}/{g}/{n}' for d in DROPIN_DIRS for f in folders for g in fnmatch.filter(entries(d), f)
             for n in entries(f'{d}/{g}') if n.endswith('.conf')}
    found = {p for p in found if not shadowed(p, every or {})}
    found |= {d + '/' + u for d in DROPIN_DIRS for u in units}
    return sorted(p for p in found if os.path.isfile(ROOT + p))


def shadowed(path, every):
    """Whether systemd applies another drop-in of path's name instead of it, to every unit path applies to. Of
    drop-ins with one name it applies the first only, in the order systemd lists their folders (src/shared/dropin.c,
    unit_file_find_dropin_paths and unit_file_find_dirs, the same from v255 to v262.2): for each dir of DROPIN_DIRS
    in turn, the unit's own folder, then its prefixes' (longest first); and only after all of those, for each dir
    again, the type's (TYPE_FOLDERS: service.d). conf_files then takes a name from the first folder that has it. So
    the key is (a type's folder, dir, place in the dir: every, {folder that applies to every job unit: its place}):
    one in the same folder of an earlier dir shadows it, and one in a folder of every whose key comes first (a prefix
    folder in /usr shadows service.d in /etc; service.d in /etc never shadows a prefix or own folder anywhere). It
    shadows as a file or a link to /dev/null (a mask); a dangling link may not: kept (it fails closed)."""
    d, f, name = path.rsplit('/', 2)

    def key(e, g):
        return g in TYPE_FOLDERS, DROPIN_DIRS.index(e), every.get(g, 0)
    return any(key(e, g) < key(d, f) and (
                   os.path.isfile(ROOT + f'{e}/{g}/{name}') or os.path.realpath(ROOT + f'{e}/{g}/{name}') == '/dev/null')
               for e in DROPIN_DIRS for g in {f, *every})


def after_reset(values):
    """The words of a list setting that count, as systemd reads a list: an empty assignment drops all before it, and a
    word ends at a blank, a tab or a line end only (UNIT_BLANKS: a form feed is part of a word, which is then none)."""
    last = max((i for i, v in enumerate(values) if not v), default=-1)
    return [w for v in values[last + 1:] for w in re.split(f'[{UNIT_BLANKS}]+', v) if w]


def networks(words):
    """The address prefixes of an IPAddressAllow= or IPAddressDeny= list (ADDRESS_WORDS for the names). A word that is
    neither: ValueError (cannot tell)."""
    out = []
    for w in words:
        for x in ADDRESS_WORDS.get(w, (w,)):
            try:
                out.append(ipaddress.ip_network(x, strict=False))
            except ValueError:
                raise ValueError(f'{w!r} is no address prefix') from None
    return out


def within(prefixes, cover):
    """The prefixes of prefixes no network of cover holds."""
    return [p for p in prefixes if not any(p.version == c.version and p.subnet_of(c) for c in cover)]


def seconds(value):
    """A systemd time span (systemd.time(7): `90`, `5min 20s`, `1h30m`, `infinity`) in seconds; 0 is infinity, as
    systemd reads a stop timeout. Any other text: ValueError (cannot tell)."""
    units = {'us': 1e-6, 'usec': 1e-6, 'µs': 1e-6, 'ms': 1e-3, 'msec': 1e-3, '': 1, 's': 1, 'sec': 1, 'second': 1,
             'seconds': 1, 'm': 60, 'min': 60, 'minute': 60, 'minutes': 60, 'h': 3600, 'hr': 3600, 'hour': 3600,
             'hours': 3600, 'd': 86400, 'day': 86400, 'days': 86400, 'w': 604800, 'week': 604800, 'weeks': 604800,
             'M': 2629800, 'month': 2629800, 'months': 2629800, 'y': 31557600, 'year': 31557600, 'years': 31557600}
    value = value.strip(UNIT_BLANKS)
    if value == 'infinity':
        return float('inf')
    parts = re.findall(f'[{UNIT_BLANKS}]*' + r'(\d+(?:\.\d*)?)' + f'[{UNIT_BLANKS}]*' + r'([A-Za-zµ]*)', value)
    if (not value or ''.join(n + u for n, u in parts) != re.sub(f'[{UNIT_BLANKS}]', '', value)
            or any(u not in units for _, u in parts)):
        raise ValueError(f'{value!r} is no time span')
    total = sum(float(n) * units[u] for n, u in parts)
    return total or float('inf')


def endless(lines, keys):
    """The stop timeouts (keys) these lines set past STOP_MAX: ['Key=value']. An empty one resets the default."""
    return [f'{k}={v}' for _, k, v in lines if k in keys and v and seconds(v) > STOP_MAX]


def file_lines(path, section=None):
    """unit_lines of a file under ROOT; one that cannot be read raises (cannot tell)."""
    with open(ROOT + path, encoding='utf-8', errors='replace') as f:
        return unit_lines(f.read(), section)


def reset_left(path, deny):
    """What a drop-in's IPAddressDeny= lines (deny, its [Service] ones) that start with or hold a reset no longer
    refuse: the reason, or None. systemd writes a reset only in SET_PROPERTY's file, and there the list after it is
    the unit's own list merged with refresh-net's; so it must still hold all of the unit's own list (the host's own
    address too, which JOB_DENY has not), and JOB_DENY. A reset anywhere else, or for a unit that is not here (its
    own file gone: a later unit of that name would take it): a FAIL."""
    m = SET_PROPERTY.fullmatch(path)
    if not m:
        return 'IPAddressDeny= (an empty one: systemd writes that only in set-property\'s own file)'
    try:
        own = after_reset([v for _, k, v in file_lines(f'/run/systemd/transient/{m.group(1)}', 'Service')
                           if k == 'IPAddressDeny'])
    except FileNotFoundError:
        return f'IPAddressDeny= (an empty one, for {m.group(1)}, which is not running)'
    left = within(networks(list(JOB_DENY) + own), networks(after_reset(deny)))
    return f'IPAddressDeny= (an empty one, then a list without {left[0]})' if left else None


def own_stops(lines):
    """The stop timeouts these lines give a unit of its own, as systemd reads them: {key: value} for each key's last
    assignment, unless that is empty (a reset to the default)."""
    last = {k: v for _, k, v in lines if k in STOP_TIMEOUTS}
    return {k: v for k, v in last.items() if v}


def stop_defaults_used():
    """The defaults of JOB_STOP_TIMEOUTS some loaded fork-fleet-* unit leaves to systemd: those its transient unit
    file (systemd writes one from systemd-run's properties, /run/systemd/transient) does not set (own_stops), as in a
    job unit an older launcher started, or a check-net probe's; and ['<file> sets Key=value'] for each such unit that
    sets an endless one of its own. A unit that ends while this reads it (its file gone: --collect) leaves nothing to
    judge (issue #297). A file that cannot be read otherwise: cannot tell."""
    used, bad = set(), []
    for n in entries('/run/systemd/transient'):
        path = f'/run/systemd/transient/{n}'
        if fnmatch.fnmatch(n, 'fork-fleet-*.service') and os.path.isfile(ROOT + path):
            try:
                own = own_stops(file_lines(path, 'Service'))
            except FileNotFoundError:
                continue
            used |= {d for d, k in JOB_STOP_TIMEOUTS.items() if k not in own}
            keys = endless([(0, k, v) for k, v in own.items()], STOP_TIMEOUTS)
            if keys:
                bad.append(f'{path} sets {", ".join(keys[:2])} for its job unit')
    return used, bad


def launcher_shipped():
    """Raises unless the installed launcher is the one these walls ship with, byte for byte (LAUNCHER_SHA256), read
    on one open file (O_NOFOLLOW; a FIFO does not block) that is as safe as launcher_safe wants it. Its start() gives
    every job unit -p TimeoutStopSec=90 -p TimeoutAbortSec=90 (fork-fleet.test.py's test_start runs it), so with it
    systemd's defaults decide no job unit's stop timeouts; and it then reads what systemd really applies (systemctl
    show: drop-ins and defaults included) and kills a unit whose stop timeouts are over STOP_MAX, or cannot be read
    (issue #365 item 1; the same STOP_MAX, a test keeps them one). No reading of bash can tell what another launcher's
    systemd-run gets (issue #316), so any other launcher, an older one too (a kit not installed whole): cannot tell."""
    fd = os.open(LAUNCHER, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, 'O_CLOEXEC', 0))
    with os.fdopen(fd, 'rb') as f:
        launcher_safe(os.fstat(f.fileno()))
        data = f.read()
    if hashlib.sha256(data).hexdigest() != LAUNCHER_SHA256:
        raise ValueError(f'{LAUNCHER} is not the launcher these walls ship with (its sha256 is not LAUNCHER_SHA256): '
                         'install the kit whole, the walls and the launcher from one release')


def job_units_wall():
    """The launcher starts each job's unit with systemd-run and its properties (the walls): nothing may change them
    on the way. A drop-in that applies to the job units (DROPIN_DIRS, DROPIN_FOLDERS: /etc, /run and /usr, for every
    service or for fork-fleet-*) and sets anything but DROPIN_SAFE (PrivateDevices=no, a BindPaths=, an empty
    SystemCallFilter=, ...), an endless stop timeout, or a reset of IPAddressDeny= (reset_left), turns a wall off
    where the launcher cannot see it; so does a slice above them (SLICE_UNITS, SLICE_FOLDERS) that allows more than
    localhost, or sets another firewall of its own (SLICE_OPENS), and systemd's default stop timeout (MANAGER_MAIN,
    MANAGER_CONFS) when endless and a loaded job unit sets none of its own (stop_defaults_used); an endless one of a
    loaded unit's own too. The installed launcher must be the one these walls ship with (launcher_shipped), whose
    start() sets both of its own; any other launcher: cannot tell. A list counts only
    in the section systemd reads it in ([Service], [Slice]). A SYSTEMD_RUN or SYSTEMCTL (the launcher's `tools`, as
    its settings set them) that is not systemd's own (LAUNCH_TOOLS) starts the units with a program that may drop any
    property. A file that cannot be read, or a value that cannot be read (an address, a time span): cannot tell."""
    bad = []
    for path in dropins(every=EVERY_JOB_UNIT):
        lines = file_lines(path)
        keys = sorted({k for _, k, v in lines if k not in DROPIN_SAFE and k != 'IPAddressDeny'})
        deny = [v for _, k, v in file_lines(path, 'Service') if k == 'IPAddressDeny']   # systemd drops the others
        left = reset_left(path, deny) if any(not v for v in deny) else None   # without a reset, a list only adds
        if left:
            keys.append(left)
        keys += endless(lines, STOP_TIMEOUTS)
        if keys:
            bad.append(f'{path} sets {", ".join(keys[:4])} for the job units')
    for path in dropins(SLICE_FOLDERS, SLICE_UNITS):
        lines = file_lines(path)
        keys = sorted({k for _, k, _ in lines if SLICE_OPENS.fullmatch(k) and k != 'IPAddressAllow'})
        allow = within(networks(after_reset([v for _, k, v in file_lines(path, 'Slice') if k == 'IPAddressAllow'])),
                       networks(['localhost']))
        if allow:
            keys.append(f'IPAddressAllow={allow[0]}')
        if keys:
            bad.append(f'{path} sets {", ".join(keys[:4])} for the slice the job units sit in')
    used, units = stop_defaults_used()
    bad += units
    launcher_shipped()
    main = [p for p in MANAGER_MAIN if os.path.exists(ROOT + p)][:1]   # a link to /dev/null too; not a dangling one
    for p in main:   # a link to /dev/null masks the others; a folder (or a socket, ...) is no config: cannot tell
        if not os.path.isfile(ROOT + p) and os.path.realpath(ROOT + p) != '/dev/null':
            raise ValueError(f'{p} is there but is no file: systemd reads no config from it (remove it)')
    for path in [p for p in main if os.path.isfile(ROOT + p)] + sorted(
            {p[len(ROOT):] for t in MANAGER_CONFS for p in glob.glob(glob.escape(ROOT) + t) if os.path.isfile(p)}):
        keys = endless(file_lines(path), used)
        if keys:
            bad.append(f'{path} sets {", ".join(keys[:2])} for every unit, the job units among them')
    tools = [line.split(' ', 1) for line in ask('tools', 'to say what it starts job units with')]
    if sorted(t[0] for t in tools) != sorted(LAUNCH_TOOLS) or any(len(t) != 2 for t in tools):
        raise ValueError('the launcher\'s `tools` printed no SYSTEMD_RUN and SYSTEMCTL lines')
    bad += [f'the launcher\'s settings set {k}={v}, not systemd\'s own' for k, v in tools if v not in LAUNCH_TOOLS[k]]
    if bad:
        return '; '.join(bad[:3]) + (f' (and {len(bad) - 3} more)' if len(bad) > 3 else '') + \
            ': drop it (or move what it sets elsewhere): the job units must get exactly what the launcher asks'
    return None


def real(path):
    """path with every link in it followed, as the kernel does, inside ROOT (an absolute link from ROOT): the real
    path, or None (a loop, a link that cannot be read)."""
    todo, done, hops = [p for p in path.split('/') if p], '', 0
    while todo:
        part = todo.pop(0)
        if part in ('.', '..'):
            done = done.rsplit('/', 1)[0] if part == '..' else done
            continue
        if os.path.islink(ROOT + done + '/' + part):
            hops += 1
            try:
                target = os.readlink(ROOT + done + '/' + part)
            except OSError:
                return None
            if hops > 40:
                return None
            todo = [p for p in target.split('/') if p] + todo
            done = '' if target.startswith('/') else done
            continue
        done += '/' + part
    return done or '/'


def secret_kind(name):
    """What a variable's name says it holds: '' no secret (no word of it SECRET_WORD); 'value' a secret; 'file' a
    file that holds one, 'command' a command that gives one (only FILE_WORDS, or only COMMAND_WORDS, after the secret
    word); 'about' something about one (any other ABOUT word after it: AWS_ACCESS_KEY_ID_FILE holds an id)."""
    words = [w.upper() for w in name.split('_') if w]
    last = max((i for i, w in enumerate(words) if SECRET_WORD.fullmatch(w)
                and not (w in ('KEY', 'KEYS') and i and words[i - 1] in PUBLIC_WORDS)), default=None)
    if last is None:
        return ''
    about = {w for w in words[last + 1:] if w in ABOUT}
    if not about:
        return 'value'
    return 'file' if about <= FILE_WORDS else 'command' if about <= COMMAND_WORDS else 'about'


def unquote(value):
    """A value as a shell, fish or systemd file has it, its quotes ('...', "...", $'...', $"...") taken off, and the
    default of ${X:-value} for it."""
    value = value.strip()
    if value[:2] in ('$\'', '$"'):
        value = value[1:]
    if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
        value = value[1:-1]
    m = DEFAULT.fullmatch(value)
    return unquote(m.group(1)) if m else value


def unit_lines(text, section=None):
    """(line number, key, value) of each assignment in a systemd unit, drop-in or config file, as systemd reads it
    (systemd.syntax(7), conf-parser.c config_parse): a line ends at \\n, \\r, \\r\\n or \\0 only (UNIT_LINE_END; not
    at a form feed or U+2028, as Python's splitlines() would); a comment line (# or ; after blanks) skipped, inside a
    continuation too; then a UTF-8 BOM at the start of the first line that has one (bom_seen: not only the file's
    first line); a line continued on the next only when the line as it is ends in an odd run of backslashes, nothing
    after them (A=b\\\\ and A=b\\<blank> end the line; PR #240 round 3), that backslash a blank; then blanks, tabs
    and line ends (UNIT_BLANKS) stripped, a [header] read, blanks around the key and the `=` dropped. section (Service,
    Slice, Manager): only the lines in that [section], as systemd takes a setting only in the section it belongs to; it
    drops one in any other section (an X- one, [Unit], [Install]) or before the first, and so does this."""
    out, buf, start, at, bom_seen = [], None, 0, None, False

    def keep(text):
        nonlocal at
        line = text.strip(UNIT_BLANKS)
        if line[:1] == '[':
            at = line[1:-1] if line.endswith(']') else None   # a broken header: systemd takes nothing after it
            return
        key, eq, value = line.partition('=')
        if line and eq and (section is None or at == section):
            out.append((start, key.strip(UNIT_BLANKS), value.strip(UNIT_BLANKS)))
    for n, raw in enumerate(UNIT_LINE_END.split(text), 1):
        if raw.lstrip(UNIT_BLANKS)[:1] in ('#', ';'):
            continue
        if not bom_seen and raw.startswith('\ufeff'):   # once per file, before blanks are stripped (conf-parser.c)
            raw, bom_seen = raw[1:], True
        if buf is None:
            buf, start = '', n
        buf += raw
        if (len(raw) - len(raw.rstrip('\\'))) % 2:
            buf = buf[:-1] + ' '
            continue
        keep(buf)
        buf = None
    if buf is not None:
        keep(buf)
    return out


def public_only(path):
    """Whether a file under ROOT plainly holds only public keys and certificates (PUBLIC_BLOCK, SSH_PUBLIC; blank and
    # lines between them): nothing secret in it, whoever reads it."""
    try:
        if os.path.getsize(ROOT + path) > PUBLIC_MAX:
            return False
        with open(ROOT + path, encoding='utf-8', errors='replace') as f:
            text = f.read().replace('\r\n', '\n')
    except OSError:
        return False
    blocks = list(PUBLIC_BLOCK.finditer(text))
    rest = [line.strip() for line in PUBLIC_BLOCK.sub('', text).splitlines()]
    rest = [line for line in rest if line and not line.startswith('#')]
    return (bool(blocks or rest) and all(public_block(m[1], m[2]) for m in blocks)
            and all(ssh_public(line) for line in rest))


# The DER shape of each block (public_block): the tags of the elements in its outer SEQUENCE, in order. A private key
# between the markers has another: PKCS#8 and PKCS#1 start with INTEGER 0 (a version), an encrypted one ends in an
# OCTET STRING. A TRUSTED CERTIFICATE is a certificate, then its trust (any SEQUENCE).
SEQUENCE, INTEGER, BIT_STRING = 0x30, 0x02, 0x03
DER_SHAPE = {'CERTIFICATE': (SEQUENCE, SEQUENCE, BIT_STRING), 'TRUSTED CERTIFICATE': (SEQUENCE, SEQUENCE, BIT_STRING),
             'X509 CRL': (SEQUENCE, SEQUENCE, BIT_STRING), 'PUBLIC KEY': (SEQUENCE, BIT_STRING),
             'RSA PUBLIC KEY': (INTEGER, INTEGER)}
# The OpenPGP packets a public key block may hold (RFC 9580 10.1): a public key and subkeys, user ids and
# attributes, signatures, trust. Not a secret key or subkey (5, 7), nor any data. Also, anywhere in it, the two that
# say nothing (PGP_MARKER, PGP_PADDING): a marker (10, its body "PGP") and padding (21, random bytes; RFC 9580 5.14).
PGP_PUBLIC_TAGS = {6, 14, 13, 17, 2, 12}
PGP_MARKER, PGP_PADDING = 10, 21


def der(raw):
    """The DER elements of raw, all of it: [(tag, contents)], each constructed one's contents parsed in full too. Not
    DER (a cut-off or overlong length, bytes left over): ValueError."""
    out, at = [], 0
    while at < len(raw):
        if at + 2 > len(raw) or raw[at] & 0x1f == 0x1f:   # a tag of more than one byte is in no key or certificate
            raise ValueError('not DER')
        tag, size, at = raw[at], raw[at + 1], at + 2
        if size & 0x80:
            n = size & 0x7f
            if not 1 <= n <= 4 or at + n > len(raw):
                raise ValueError('not DER')
            size, at = int.from_bytes(raw[at:at + n], 'big'), at + n
        if at + size > len(raw):
            raise ValueError('not DER')
        if tag & 0x20:
            der(raw[at:at + size])
        out.append((tag, raw[at:at + size]))
        at += size
    return out


def pgp_packets(raw):
    """The OpenPGP packets of raw, all of it, [(tag, body)] (RFC 9580 4.2: new and old format). A partial or
    indeterminate length (only data packets have one), or bytes left over: ValueError."""
    tags, at = [], 0
    while at < len(raw):
        head = raw[at]
        if not head & 0x80:
            raise ValueError('not OpenPGP')
        if head & 0x40:   # new format
            tag, first, at = head & 0x3f, raw[at + 1] if at + 1 < len(raw) else 255, at + 2
            if first < 192:
                size = first
            elif first < 224 and at < len(raw):
                size, at = ((first - 192) << 8) + raw[at] + 192, at + 1
            elif first == 255 and at + 4 <= len(raw):
                size, at = int.from_bytes(raw[at:at + 4], 'big'), at + 4
            else:
                raise ValueError('not OpenPGP')
        else:   # old format
            tag, n, at = (head >> 2) & 0x0f, (1, 2, 4, 0)[head & 3], at + 1
            if not n or at + n > len(raw):
                raise ValueError('not OpenPGP')
            size, at = int.from_bytes(raw[at:at + n], 'big'), at + n
        if at + size > len(raw):
            raise ValueError('not OpenPGP')
        tags.append((tag, raw[at:at + size]))
        at += size
    return tags


def public_block(kind, body):
    """Whether a PUBLIC_BLOCK's body is base64 of what its markers (kind) say, and nothing else, read in full: DER,
    one SEQUENCE of DER_SHAPE (a TRUSTED CERTIFICATE: a certificate, then its trust), every element in it well formed;
    an OpenPGP public key in PGP_ARMOR, every packet a public one (PGP_PUBLIC_TAGS), the first a public key (6); a
    marker and padding packet skipped."""
    if kind == 'PGP PUBLIC KEY BLOCK':
        m = PGP_ARMOR.fullmatch(body)
        body = m[2] if m else '!'
    data = ''.join(body.split('\n'))
    if not data or not BASE64.fullmatch(data):
        return False
    raw = base64.b64decode(data)
    try:
        if kind == 'PGP PUBLIC KEY BLOCK':
            tags = [t for t, body in pgp_packets(raw)
                    if t != PGP_PADDING and not (t == PGP_MARKER and body == b'PGP')]
            return tags[:1] == [6] and set(tags) <= PGP_PUBLIC_TAGS
        top = der(raw)
    except (ValueError, RecursionError):   # too deep to be a key or certificate
        return False
    want = [SEQUENCE] * (2 if kind == 'TRUSTED CERTIFICATE' else 1)
    if [t for t, _ in top] != want:
        return False
    return tuple(t for t, _ in der(top[0][1])) == DER_SHAPE[kind]


def ssh_public(line):
    """Whether a line is one SSH public key (SSH_PUBLIC): its base64 a key of the type it names, its comment short."""
    m = SSH_PUBLIC.fullmatch(line)
    if not m or len(m[3]) > SSH_COMMENT or not BASE64.fullmatch(m[2]):
        return False
    blob = base64.b64decode(m[2])
    size = int.from_bytes(blob[:4], 'big')
    return blob[4:4 + size] == m[1].encode() and len(blob) > 4 + size


def may(full, st, bit):
    """Whether a job's runner user may have bit (4 read, 1 enter) on the file or folder full, of mode st: the others
    have it; or the group has it and that group is not root's (the runner may be in it), or an ACL is set (with one, the
    group bits are its mask: some user or group it names may have it). Not the owner's bits: a runner user owns no file
    of /etc or /usr (the installer makes it with none)."""
    if st.st_mode & bit:
        return True
    if not st.st_mode & (bit << 3):
        return False
    if st.st_gid != 0:
        return True
    try:
        os.getxattr(full, 'system.posix_acl_access', follow_symlinks=False)
    except OSError:   # none (ENODATA), or a file system without ACLs
        return False
    return True


def job_reads(path, top):
    """Whether a job may read path (a real host path, under top: a real path the launcher binds whole). The folders
    from top down to it decide, and its own read bit (may); the launcher makes the folders above top itself."""
    rest = path[len(top):].strip('/').split('/') if path != top else []
    try:
        at = top
        for name in [''] + rest:
            at = at + '/' + name if name else at
            st = os.lstat(ROOT + at)
            if not may(ROOT + at, st, 0o001 if stat.S_ISDIR(st.st_mode) and at != path else 0o004):
                return False
    except OSError:
        return False
    return True


def in_view(view, path):
    """Where path is on this host if a job sees it ((real path, the top it is bound under) through the launcher's
    `paths`), or None: none of its lines holds it."""
    for dest, top in view:
        if path == dest or path.startswith(dest.rstrip('/') + '/'):
            return top + path[len(dest):], top
    return None


def view_secret(view, path):
    """Why a path a setting names (a secret's file, an EnvironmentFile=, a LoadCredential=) gives a job a secret: it
    sees the file (in_view; every link in it followed, as the kernel does, inside ROOT), may read it (job_reads) and it
    is not plainly public (public_only). '' if not."""
    host = in_view(view, path)
    resolved = host and real(host[0])
    host = resolved and in_view([(top, top) for _, top in view], resolved)
    if not host or not os.path.isfile(ROOT + host[0]) or not job_reads(*host) or public_only(host[0]):
        return ''
    return f'{path}, which jobs can read'


def fixed_part(path, unit):
    """path up to its first name that is not known until systemd or a glob reads it (a specifier but FIXED_SPECIFIERS'
    and %%, a * ? [ or brace): the folder it is in for sure. A path that starts with no / once %E and the like are
    read, or one with a .. in it: Unsure."""
    if '..' in path.split('/') or '�' in path:
        raise Unsure(f'{path[:60]!r} has a .. or bytes that are no UTF-8')
    if unit:
        path = re.sub(r'^%([' + ''.join(FIXED_SPECIFIERS) + '])', lambda m: FIXED_SPECIFIERS[m[1]], path)
    if not path.startswith('/'):
        raise Unsure(f'{path[:60]!r} is no absolute path')
    parts = path.split('/')
    for i, part in enumerate(parts):
        if re.search(r'[*?[{]', part) or (unit and re.search(r'%[^%]', part)):
            return '/'.join(parts[:i]) or '/', False
    return path, True


def path_secret(view, value, unit):
    """Why a path (a *_FILE's value, an EnvironmentFile=, a LoadCredential= source) gives a job a secret ('' if
    not): the file it names (view_secret); a unit's own credentials (%d/..., $CREDENTIALS_DIRECTORY/...) and a home
    (~, %h: no job sees one) are none. One whose name is not known for sure (fixed_part) fails closed when the folder
    it is in for sure is in the job's view, or holds part of it."""
    if HOME_PATH.fullmatch(value) or (unit and re.match(r'(%[dh]|\$\{?CREDENTIALS_DIRECTORY\}?)(/|$)', value)):
        if '..' in value.split('/'):
            raise Unsure(f'{value[:60]!r} has a .. in it')
        return ''
    fixed, whole = fixed_part(value, unit)
    if whole:
        return view_secret(view, fixed)
    if in_view(view, fixed) or any(d == fixed or d.startswith(fixed.rstrip('/') + '/') for d, _ in view):
        raise Unsure(f'{value[:60]!r} may name any file under {fixed}, which jobs see')
    return ''


def setting_secret(view, name, value, unit=False):
    """Why NAME=value gives a job a secret ('' if not), by the name's kind (secret_kind): a value of its own (not
    empty, a variable, a command's output, a yes/no or 0/1, a home path); a file (path_secret); a command, which
    the walls do not run: Unsure. A value that is a path that is there is read as a file too (a password that starts
    with / is not there)."""
    kind = secret_kind(name)
    value = unquote(value)
    if kind in ('', 'about') or not value or value.startswith(('$', '`', '(')) or value.lower() in NOT_SECRET:
        return ''
    if kind == 'command':
        raise Unsure('a command that gives a secret: the walls do not run it')
    if kind == 'file' or (A_PATH.fullmatch(value) and os.path.lexists(ROOT + value)) or HOME_PATH.fullmatch(value) or (
            unit and A_SPECIFIER.fullmatch(value)):
        return path_secret(view, value, unit)
    return 'a secret'


def shell_sets(line):
    """(NAME, value) of each variable a shell, csh, fish or pam_env line sets (ASSIGN, SETENV, FISH_SET, PAM_ENV,
    SET_DEFAULT; not fish's set -q/-e/-n/-S, which set nothing)."""
    sets = [m.groups() for r in (ASSIGN, PAM_ENV, SET_DEFAULT) for m in r.finditer(line)]
    sets += [m.groups() for m in SETENV.finditer(line) if not m.group(2).startswith('#')]
    sets += [m.groups()[1:] for m in FISH_SET.finditer(line)
             if not m.group(3).startswith('#') and not any(FISH_ASKS.fullmatch(f) for f in m.group(1).split())]
    return sets


def unit_secrets(view, text):
    """(line, why) of each secret a unit file, drop-in or systemd config gives a job: a secret in Environment=
    (setting_secret; a backslash fails closed: systemd reads an escape there), any SetCredential= data, a
    LoadCredential= or EnvironmentFile= file a job can read (path_secret; an EnvironmentFile= read as env_secrets)."""
    out = []
    for n, key, value in unit_lines(text):
        try:
            if key in UNIT_ENV:
                if '\\' in value:
                    raise Unsure('a backslash: systemd reads an escape there')
                try:
                    items = shlex.split(value)
                except ValueError:
                    raise Unsure('its quotes do not close') from None
                for k, eq, v in (x.partition('=') for x in items):
                    why = eq and setting_secret(view, k, v, unit=True)
                    out += [(n, f'{k}: {why}')] if why else []
            elif key == 'SetCredential':
                cred, colon, data = value.partition(':')
                out += [(n, f'SetCredential={cred}: a secret')] if colon and data.strip() else []
            elif key in ('LoadCredential', 'EnvironmentFile'):
                source = value.partition(':')[2] if key == 'LoadCredential' else value.removeprefix('-')
                if source and not source.startswith(('/', '%')):
                    continue   # a credential's name: systemd looks in its credential stores (CREDSTORES)
                why = source and path_secret(view, source, True)
                if why and key == 'EnvironmentFile':   # a file a job reads in full: its own lines tell
                    found = in_view(view, source)
                    why = found and next((w for _, w in env_secrets(view, read(found[0], strip=False) or '')), '')
                out += [(n, f'{key}: {why}')] if why else []
        except Unsure as e:
            out.append((n, f'{key}: {e}'))
    return out


def env_secrets(view, text):
    """(line, why) of each secret a login, environment or shell file gives a job: a variable with a secret's name and
    value (shell_sets, setting_secret) on a line that is no comment."""
    out = []
    for n, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith('#'):
            continue
        for name, value in shell_sets(line):
            try:
                why = setting_secret(view, name, value)
            except Unsure as e:
                why = str(e)
            out += [(n, f'{name}: {why}')] if why else []
    return out


def a_script(head, name):
    """Whether a program is a shell script (its #! names a shell of SHELLS, by itself or through env; or a .sh)."""
    if name.endswith('.sh'):
        return True
    if not head.startswith(b'#!'):
        return False
    words = head[2:].split(b'\n', 1)[0].decode('utf-8', 'replace').split()
    words = words[1:] if words and os.path.basename(words[0]) == 'env' else words
    words = [w for w in words if not w.startswith('-')]
    return bool(words) and SHELLS.fullmatch(os.path.basename(words[0])) is not None


def file_secrets(view, path, how):
    """(where, why) of what a file a job can read gives away: a secret's file name (SECRET_FILE; not a plainly public
    one); anywhere in it, a known token's shape or a private key block (TOKEN_BYTES, a comment too: the file still holds
    it); in a text file, a password in a URL (URL_PASSWORD) on a line that is no comment; and by how it is read (how):
    a unit's settings ('unit'), a login, environment or shell file's variables ('env'; 'program': only a shell
    script). A file larger than SHAPE_MAX is read for its name alone."""
    out = []
    if SECRET_FILE.fullmatch(os.path.basename(path)) and not public_only(path):
        out.append((path, 'a secret\'s file name'))
    try:
        with open(ROOT + path, 'rb') as f:
            data = f.read(SHAPE_MAX + 1)
    except FileNotFoundError:   # gone since it was listed: nothing left to read
        return out
    except OSError as e:   # a job may read it (job_reads), the walls cannot: it fails closed
        return out + [(path, f'cannot read it ({e.strerror})')]
    if len(data) > SHAPE_MAX:
        return out
    if TOKEN_BYTES.search(data):
        out.append((path, 'a token or private key'))
    if b'\0' in data[:8192]:   # a program, a database: no lines to read
        return out
    text = data.decode('utf-8', 'replace')
    out += [(f'{path} line {n}', 'a password in a URL') for n, line in enumerate(text.splitlines(), 1)
            if not line.lstrip().startswith(('#', ';')) and URL_PASSWORD.search(line)]
    if how == 'unit':
        found = unit_secrets(view, text)
    elif how == 'env' or (how == 'program' and a_script(data[:256], path)):
        found = env_secrets(view, text)
    else:
        found = []
    return out + [(f'{path} line {n}', why) for n, why in found]


def view_files(view, tops):
    """Every plain file (no link) under each of tops that a job sees and may read: (host path, top), each once (/lib
    and /usr/lib on a host whose /usr is merged: once). A folder a job cannot enter is not walked."""
    out, seen = [], set()
    for top in tops:
        found = in_view(view, top)
        if found is None or not os.path.isdir(ROOT + found[0]) or os.path.islink(ROOT + found[0]):
            if found and os.path.isfile(ROOT + found[0]) and not os.path.islink(ROOT + found[0]):
                out += [found] if job_reads(*found) else []
            continue
        for folder, dirs, files in os.walk(ROOT + found[0]):
            here = folder[len(ROOT):]
            dirs[:] = sorted(d for d in dirs if job_reads(here + '/' + d, found[1]))
            for name in sorted(files):
                path = here + '/' + name
                try:
                    st = os.lstat(ROOT + path)
                except FileNotFoundError:   # gone since the folder was listed
                    continue
                if stat.S_ISREG(st.st_mode) and (st.st_dev, st.st_ino) not in seen and job_reads(path, found[1]):
                    seen.add((st.st_dev, st.st_ino))
                    out.append((path, found[1]))
    return out


def etc_secrets_wall():
    """A lint, not a proof: no secret found in what jobs can still read of /etc and /usr (issue #243 items 5 and 6).
    The fix is the view itself: jobs see only an allow list of /etc (fork-fleet-job-paths.txt and ALLOW_PATHS; the
    known secret entries refused by `mounts`), so a login file, a unit, cron, /etc/default and a backup tool's folder
    are not there to read. This reads, as a job could: every file of that /etc view (a key dropped into ssl/certs);
    the host's own programs and settings in /usr/local (LOCAL_TOPS); the packages' units (UNIT_TOPS) and environment
    files (ENV_TOPS); systemd's credential stores in /usr (CREDSTORES: any file there a job can read is a secret by
    what it is). What it finds (file_secrets): a secret's file name, a token's shape or a private key, a password in
    a URL, a variable with a secret's name and value in a unit, an environment file, a shell script or a file of the
    /etc view. A file a job cannot read (job_reads: no other bit; no group bit, or root's group and no ACL) is fine.
    Not read: the rest of /usr (the packages' own files: a toolchain's test keys are no secret of this host) and
    ALLOW_PATHS outside /etc (a project's caches: each job reads them by the project's choice). Still open, as it is
    a lint: a secret under a name with no secret word, in a form it does not parse (a Python program), or in a file
    larger than SHAPE_MAX."""
    view = but_resolv(job_view())
    etc = [dest for dest, _ in view if dest.startswith('/etc/')]
    found = []
    for path, _ in view_files(view, etc + list(LOCAL_TOPS)):
        found += file_secrets(view, path, 'env' if path.startswith('/etc/') or path.startswith('/usr/local/etc/')
                              else 'program')
    for path, _ in view_files(view, UNIT_TOPS):
        found += file_secrets(view, path, 'unit' if UNIT_FILE.fullmatch(os.path.basename(path)) else 'program')
    for path, _ in view_files(view, ENV_TOPS):
        found += file_secrets(view, path, 'env')
    found += [(path, 'a credential') for path, _ in view_files(view, CREDSTORES)]
    if found:
        listed = '; '.join(f'{where} ({why})' for where, why in found[:3])
        more = f' (and {len(found) - 3} more)' if len(found) > 3 else ''
        return (f'jobs can read a secret on this host: {listed}{more}: make the file readable by root alone (0600) '
                'or move it out of what jobs see')
    return None


WALLS = [
    ('os', 'a plain Linux kernel, not WSL', os_wall),
    ('kernel', 'kernel 5.8 or newer (per-mount /proc, so jobs see no other process)', kernel_wall),
    ('systemd', 'systemd is PID 1', systemd_wall),
    ('cgroup2', '/sys/fs/cgroup is cgroup2 only', cgroup_wall),
    ('cgroup-bpf', 'the kernel has cgroup BPF (else systemd drops IPAddressDeny without an error)', cgroup_bpf_wall),
    ('namespaces', 'the kernel has IPC, mount and network namespaces', namespaces_wall),
    ('seccomp', 'seccomp filters are available', seccomp_wall),
    ('container', 'not in a container', container_wall),
    ('mounts', 'jobs see only the launcher\'s allow list of system paths, on this host\'s own disks, and no /etc '
               'entry that holds secrets; no other mount', mounts_wall),
    ('job-units', 'no systemd drop-in nor launcher setting changes the job units the launcher asks for',
     job_units_wall),
    ('etc-secrets', 'no secret found in what jobs see of /etc and /usr (a lint, not a proof; jobs see only an allow '
                    'list of /etc: issue #243)', etc_secrets_wall),
]


def text(s):
    """s on one line, every control character (ESC, CR, ...) and line or bidi mark escaped: a mount's name never
    reaches a terminal raw."""
    return re.sub('[\x00-\x1f\x7f-\x9f\u061c\u200e\u200f\u2028\u2029\u202a-\u202e\u2066-\u2069]',
                  lambda m: f'\\x{ord(m[0]):02x}' if ord(m[0]) < 0x100 else f'\\u{ord(m[0]):04x}', s)


def main(argv):
    if len(argv) != 1 or argv[0] not in ('check', 'describe'):
        print('usage: linux check | describe', file=sys.stderr)
        return 2
    failed = False
    for wall, what, test in WALLS:
        try:
            why = test()
        except Exception as e:   # a wall that cannot be told does not hold
            why = f'cannot tell ({e.__class__.__name__}: {e})'
        failed |= why is not None
        if why is not None:
            print(f'FAIL  {wall}  ' + text(f'{what}: {why}')[:400])
        elif argv[0] == 'describe':
            print(f'PASS  {wall}  {what}')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
