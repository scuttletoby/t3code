# A secret's name (secret_kind), in any case, its words split on _: a word that holds SECRET, PASSW (password, passwd),
# PASSPHRASE, CREDENTIAL, APIKEY or PRIVATEKEY (DJANGO_SECRETKEY, DBPASSWORD), ends in TOKEN or TOKENS (GH_TOKEN,
# github_token; not TOKENIZERS_PARALLELISM), or is KEY(S), PASS, PAT or PW (OPENAI_API_KEY, api_key, db_pass, GH_PAT);
# and no word after it that says the value is about the secret, not the secret (ABOUT: TOKEN_TTL, PASSWORD_MIN_LENGTH,
# AWS_ACCESS_KEY_ID). Two of those words still say where the secret is, and the value is read as that: a file
# (FILE_WORDS: DB_PASSWORD_FILE) others can read holds it, and a command (COMMAND_WORDS: RESTIC_PASSWORD_COMMAND)
# may print it (an echo or printf of literal text) or hold it (--password=..., NAME=...). The value decides the rest
# (secret_value).
SECRET_WORD = re.compile(r'.*(SECRET|PASSW|PASSPHRASE|CREDENTIAL|APIKEY|PRIVATEKEY).*|.*TOKENS?|KEYS?|PASS|PAT|PW',
                         re.I)
ABOUT = {'FILE', 'FILES', 'PATH', 'DIR', 'DIRECTORY', 'COMMAND', 'CMD', 'HELPER', 'PROMPT', 'TTL', 'LIFETIME',
         'EXPIRY', 'EXPIRES', 'TIMEOUT', 'AGE', 'SECONDS', 'MINUTES', 'HOURS', 'DAYS', 'LENGTH', 'LEN', 'MIN', 'MAX',
         'SIZE', 'COUNT', 'RETRIES', 'ID', 'IDS', 'NAME', 'USER', 'USERNAME', 'TYPE', 'MODE', 'FORMAT', 'ALGORITHM',
         'POLICY', 'URL', 'URI', 'ENDPOINT', 'HOST', 'PORT', 'ENABLED', 'DISABLED', 'REQUIRED'}
FILE_WORDS = {'FILE', 'FILES', 'PATH'}
COMMAND_WORDS = {'COMMAND', 'CMD', 'HELPER'}
# A KEY that a PUBLIC (or PUB) comes right before is a public key (JWT_PUBLIC_KEY_FILE): no secret word. A file that
# plainly holds only public keys and certificates (PUBLIC_BLOCK, SSH_PUBLIC; comments) is no secret either, whatever
# names it; one with anything else in it (a private key after a certificate) still is. Plainly: a block's body is
# base64 (BASE64) of what its markers say (public_block), with nothing else in it but OpenPGP's armor (PGP_ARMOR: a few
# headers, a blank line, a checksum line); an SSH line is a key type, base64 of a key of that type, and at most a short
# plain comment (SSH_COMMENT), after at most a known_hosts host list (SSH_HOSTS; no authorized_keys option with a
# value, environment="..." among them: a value is always quoted).
PUBLIC_WORDS = {'PUBLIC', 'PUB'}
PUBLIC_BLOCK = re.compile(r'-----BEGIN (CERTIFICATE|TRUSTED CERTIFICATE|X509 CRL|PUBLIC KEY|RSA PUBLIC KEY|'
                          r'PGP PUBLIC KEY BLOCK)-----\n(.*?)-----END \1-----', re.S)
BASE64 = re.compile(r'(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?')
PGP_ARMOR = re.compile(r'((?:(?:Version|Comment|Hash|Charset): [ -~]{1,76}\n)*)\n(.*?)(?:=[A-Za-z0-9+/]{4}\n)?', re.S)
# A known_hosts host list: names (a host, [host]:port, a pattern, a hashed |1|salt|hash) split by commas, each 253
# characters at most (the longest DNS name; OpenSSH sets no limit, a longer one is not read as public).
_SSH_HOST = r'[A-Za-z0-9.*?!\[\]:|=+/_-]{1,253}'
SSH_HOSTS = r'(?:@(?:cert-authority|revoked)\s+)?' + _SSH_HOST + r'(?:,' + _SSH_HOST + r')*\s+'
SSH_PUBLIC = re.compile(r'(?:' + SSH_HOSTS + r')?((?:ssh-(?:ed25519|rsa|dss)|ecdsa-sha2-nistp(?:256|384|521)|'
                        r'sk-(?:ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)(?:-cert-v01@openssh\.com)?)\s+'
                        r'([A-Za-z0-9+/]+={0,2})((?:\s+[A-Za-z0-9._@+:-]+){0,4})')
SSH_COMMENT = 64   # characters at most
PUBLIC_MAX = 1 << 20   # a file larger than this is not read as public
# A *_COMMAND's value, read as a command (command_secret): what a shell runs (SHELLS -c ...) is read again; the words
# of WRAPPERS before a program are not it; a file an INTERPRETERS runs is its program, not its input; a file of LOCKED
# needs a key to be read. A script in the command's own words (INLINE: python -c, perl -e, node -p, ...; awk and sed
# take their script so) may read a file whose path it builds from parts: it gives a secret, as main before #213 had
# every literal command (issue #226).
SHELLS = re.compile(r'(?:ba|da|z|k|mk|a)?sh')
WRAPPERS = {'env', 'exec', 'command', 'nice', 'nohup'}
