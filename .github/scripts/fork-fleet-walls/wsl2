#!/usr/bin/python3 -I
"""Fork only: the walls of a WSL2 distro, for fork-fleet-walls.py (its contract is there). A WSL2 distro is Linux to
its kernel, so every wall of the linux file next to this one holds here too and is taken from it, not copied (its
`os` aside): kernel, systemd, cgroup2, cgroup-bpf, namespaces, seccomp, container (WSL's own `wsl` mark aside:
container_wall), mounts (what jobs see, as the
launcher beside this folder says with `fork-fleet-launch.sh paths`: Windows' drives at /mnt/c or /c, WSL's shares at
/mnt/wsl and /usr/lib/wsl are outside it, so no job sees them), job-units and etc-secrets. A wall the linux file
gains is a wall here too. The launcher is one file: the one the linux walls ask (`paths`) is the one whose job units'
properties are read here (unit_props: sandbox(), job_fs() and start()'s systemd-run, every form of -p), and it must be
as safe as they want it. It must also be the launcher this file was checked against (LAUNCHER_SHA256): no reading of
bash can follow every way a changed launcher could hand systemd-run more (eval, a helper, printf -v, source, a quote),
so any other launcher cannot be told. On top, what only WSL2 has:
- interop: WSL runs Windows programs from the distro (a binfmt_misc handler run by /init), as the Windows user,
  outside every Linux wall. It must be off now, and stay off: in /etc/wsl.conf, and masked for systemd-binfmt, which
  registers WSL's handler again at boot. Any handler that runs Windows programs counts, whatever its name;
- sockets: no socket to Windows in a job unit. WSL's interop server listens on unix sockets in /run/WSL, WSLg's X
  server in /tmp/.X11-unix; a path socket is not kept apart by a network namespace, so job units must get a /run and
  a /tmp of their own, what the launcher shows jobs (`paths`) must hold none of them, and nothing else of the host
  is bound in, nor its devices (PrivateDevices=yes: /dev/dxg is WSL2's channel to Windows' GPU driver). And AF_VSOCK
  (Hyper-V sockets, WSL2's channel to Windows, 9p's way to its drives) is not namespaced: the job units close it,
  and the two ways around that filter (io_uring, other-arch system calls). Read in the launcher's job units' properties;
  check-net's probe proves it in a real unit;
- windows-path: WSL appends Windows' PATH to the distro's, so a tool finds Windows programs first;
- userns: a job that can make a user namespace gets CAP_SYS_ADMIN and CAP_NET_ADMIN in it, the usual way into a
  kernel bug, and a kernel bug here is root on the PC. Off for every user (user.max_user_namespaces=0), or for job
  units (RestrictNamespaces in the launcher's job units' properties);
- resolv: WSL makes /etc/resolv.conf a link to /mnt/wsl/resolv.conf; the launcher binds the jobs' resolv.conf where
  that link leads, so job units would get a /mnt. A file of the distro's own, and WSL told not to make the link again;
- networking: mirrored mode puts Windows' localhost and the home network's interfaces into the distro; NAT only.
WSL's update, a restart or an edited .wslconfig can turn each of them back on, so each is read before every start.
Reads files and runs wslinfo and the launcher's read-only `paths` and `tools` only; changes nothing. Standard library
only."""
import configparser, glob, hashlib, os, re, stat, subprocess, sys, types

sys.dont_write_bytecode = True   # the walls folder holds walls files and fixtures only
ROOT = os.environ.get('FORK_FLEET_WALLS_ROOT', '')
ME = os.path.realpath(__file__)
# The sha256 of the launcher (fork-fleet-launch.sh) whose job units unit_props reads as safe: the one this file ships
# with. A changed launcher must be read again and this pin changed with it (fork-fleet-walls-wsl2.test.py checks it).
LAUNCHER_SHA256 = '0b4b4c10cca7f04cde8bcb732fba5dbd2dddc2b42b3535e37e92140c98598bc4'
WSL_CONF = '/etc/wsl.conf'
BINFMT = '/proc/sys/fs/binfmt_misc'
MASK = '/etc/binfmt.d/WSLInterop.conf'   # same name as WSL's /usr/lib/binfmt.d file: systemd-binfmt reads this one
# What runs Windows programs: WSL's /init as a binfmt interpreter, a handler for MZ (PE) files, or for their names.
WINDOWS_EXT = {'exe', 'com', 'bat', 'cmd', 'ps1', 'msi', 'lnk'}
# The folders WSL keeps its sockets in, which a job unit must get its own (empty) copy of; no path jobs see (where in
# the job, or where it comes from) may be in them, in /mnt, or WSL's interop server /init.
OWN_DIRS = ('/run', '/tmp')
WSL_ONLY = ('/init', '/run', '/tmp', '/mnt')
SHUTDOWN = 'then wsl --shutdown from Windows'
USERNS_OFF = (('/proc/sys/user/max_user_namespaces', '0'), ('/proc/sys/kernel/unprivileged_userns_clone', '0'))
SYSCTL = '/etc/sysctl.d/90-fork-fleet.conf'
RESOLV = '/etc/resolv.conf'
NOT_RESOLV = ('/mnt', '/media', '/srv', '/home', '/root', '/usr/lib/wsl')   # never where the jobs' resolv.conf goes
# systemd-run's options in start() that set no property: flags, and options with a value (--unit X, --unit=X). Any
# other option (--scope, --setenv, -E, --pty, an abbreviation) cannot be told.
RUN_FLAGS = ('--quiet', '--collect')
RUN_OPTIONS = ('--unit', '--uid', '--working-directory')
# The properties the launcher gives job units, each known to give a job nothing of the host's beyond what `paths`
# shows (binds only from BINDS, EnvironmentFile= only its own file, RootDirectory= only the unit's own root), and any
# property that only takes away (RESTRICTS). Any other one (DeviceAllow=, LoadCredential=, MountImages=,
# SupplementaryGroups=, ...) cannot be told: the walls must learn it first.
RUN_PROPS = {'Type', 'KillMode', 'EnvironmentFile', 'ReadWritePaths', 'RuntimeMaxSec', 'TimeoutStopSec',
             'TimeoutAbortSec', 'NetworkNamespacePath', 'IPAddressDeny', 'IPAddressAllow', 'RootDirectory',
             'MountAPIVFS', 'MountFlags', 'BindReadOnlyPaths', 'BindPaths', 'TemporaryFileSystem', 'NoNewPrivileges',
             'RemoveIPC', 'PrivateDevices', 'PrivateIPC', 'PrivateTmp', 'PrivateNetwork', 'PrivateUsers',
             'PrivateMounts', 'SystemCallFilter', 'SystemCallArchitectures', 'SystemCallErrorNumber', 'LockPersonality',
             'CapabilityBoundingSet', 'UMask'}
RESTRICTS = re.compile(r'(Protect|Restrict|Memory|CPU|Tasks|IO|Limit)[A-Za-z]*')
READ_LITERAL = {'TemporaryFileSystem', 'RestrictAddressFamilies', 'SystemCallFilter', 'SystemCallArchitectures',
                'RestrictNamespaces', 'PrivateDevices'}   # read by the walls: must be written out, no $
# The only binds a job unit may get, as the launcher writes them (job_fs): what `paths` shows (view_ro), the job's
# own copy, and the jobs' resolv.conf. Any other one (BindReadOnlyPaths=/run/WSL:/run/WSL, a WSLg socket) fails.
BINDS = {('BindReadOnlyPaths', '${ro[*]}'), ('BindPaths', '$rw:$rw:norbind'), ('BindReadOnlyPaths', '$resolv_bind')}
ONLY = {'RootDirectory': '$root', 'EnvironmentFile': '$env_file', 'ReadWritePaths': '$dir'}
# And how job_fs() makes them, the only assignments of those names in the launcher: ro from view_ro alone.
BIND_SOURCES = {'ro': ['ro=()', 'ro+=("$b:norbind")'], 'rw': ['rw=$2'], 'resolv_bind': ['resolv_bind=$b:$resolv']}
TRUE = ('yes', 'true', 'on', '1')
LINUX = None   # the linux walls file, as a module (load_linux; main loads it first)


def read(path):
    try:
        with open(ROOT + path, encoding='utf-8', errors='replace') as f:
            return f.read().strip()
    except OSError:
        return None


def load_linux():
    """The linux walls file next to this one, as a module. It runs as this one does, so it must be no more open: a
    plain file of this file's owner that no one else may write unless they may write this one too. Checked on the
    open file itself, and run from its source (never a cached .pyc beside it), so what is checked is what runs."""
    path = os.path.join(os.path.dirname(ME), 'linux')
    mine = os.stat(ME)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, 'O_CLOEXEC', 0))
    with os.fdopen(fd, 'rb') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != mine.st_uid or st.st_mode & 0o022 & ~mine.st_mode:
            raise ValueError(f'{path} must be a plain file of uid {mine.st_uid}, no more writable than {ME}')
        source = f.read()
    module = types.ModuleType('fork_fleet_walls_linux')
    module.__file__ = path
    exec(compile(source, path, 'exec', dont_inherit=True), module.__dict__)
    return module


def os_wall():
    release = read('/proc/sys/kernel/osrelease')
    if read('/proc/sys/kernel/ostype') != 'Linux' or release is None:
        return 'no Linux /proc/sys/kernel/ostype and osrelease'
    if re.search(r'-Microsoft$', release):
        return f'this is WSL1 ({release}): not supported (wsl --set-version <distro> 2)'
    if ('microsoft' not in release.lower() and not any(glob.glob(glob.escape(ROOT) + m) for m in LINUX.WSL_MARKS)
            and LINUX.WSL_CMDLINE not in (read('/proc/cmdline') or '')):
        return f'not WSL ({release}): its walls are fork-fleet-walls/linux'
    return None


def container_wall():
    """WSL2's own systemd writes `wsl` to /run/systemd/container at every boot (it counts WSL as a container), so that
    mark alone is no container: the walls hold, as the namespaces, seccomp and cgroup-bpf walls read. Any other kind,
    Docker's or podman's mark, or a root that is not the host's (a user namespace, where systemd may drop a wall it
    lacks the right for) is one, as in the linux file. systemd names WSL from the kernel's release before it reads a
    container's own mark, so a container on WSL's kernel (nspawn, privileged LXC: no Docker or podman file, root's
    uid_map) also writes `wsl`: what its manager leaves (/run/host/container-manager, `container=` in pid 1's
    environment, which root reads) is read too."""
    others = [p for p in ('/.dockerenv', '/run/.containerenv') if os.path.lexists(ROOT + p)]
    if others:
        return LINUX.container_wall()
    if os.path.lexists(ROOT + '/run/systemd/container') and read('/run/systemd/container') != 'wsl':
        return LINUX.container_wall()
    if os.path.lexists(ROOT + '/run/host/container-manager'):
        return ('/run/host/container-manager is there: in a container systemd drops some of the jobs\' walls without '
                'an error')
    env = [v for v in (read('/proc/1/environ') or '').split('\0') if v.startswith('container=')]
    if env and env[-1] != 'container=wsl':
        return f'pid 1 runs with {env[-1]}: in a container systemd drops some of the jobs\' walls without an error'
    uid_map = read('/proc/self/uid_map')
    if uid_map is None or uid_map.split() != ['0', '0', '4294967295']:
        return (f'root here is not the host\'s root (/proc/self/uid_map is {uid_map!r}, not 0 0 4294967295): in a '
                'user namespace systemd drops some of the jobs\' walls without an error')
    return None


def systemd_wall():
    why = LINUX.systemd_wall()
    return why and f'{why} ([boot] systemd=true in {WSL_CONF}, {SHUTDOWN})'


def wsl_conf(section, key):
    """A value of /etc/wsl.conf, as WSL reads it: keys as written; a key given twice cannot be told (ValueError)."""
    text = read(WSL_CONF)
    if text is None:
        raise ValueError(f'cannot read {WSL_CONF}')
    cp = configparser.ConfigParser(interpolation=None, strict=True, inline_comment_prefixes=None)
    cp.optionxform = str
    try:
        cp.read_string(text, WSL_CONF)
    except configparser.Error as e:
        raise ValueError(f'{WSL_CONF} cannot be read as WSL does: {str(e).splitlines()[0]}')
    return cp.get(section, key, fallback='not set').strip().lower()


def windows_handler(name, text):
    """Why binfmt_misc handler name (its /proc text) runs Windows programs, or None. Enabled or not: root, or WSL
    itself, can turn one on again."""
    if name.startswith('WSLInterop'):
        return name
    if text is None:
        return f'{name} (cannot read it)'
    fields = dict(line.partition(' ')[::2] for line in text.splitlines())
    interpreter, magic = fields.get('interpreter', '').strip(), fields.get('magic', '').strip().lower()
    if interpreter == '/init' or interpreter.startswith('/mnt/') or re.search(r'wsl|\.exe$', interpreter, re.I):
        return f'{name} (run by {interpreter})'
    if magic.startswith('4d5a'):
        return f'{name} (MZ files: Windows programs)'
    if fields.get('extension', '').strip().lower().lstrip('.') in WINDOWS_EXT:
        return f'{name} (.{fields["extension"].strip().lstrip(".")} files)'
    return None


def interop_wall():
    bad = []
    if not os.path.lexists(ROOT + BINFMT + '/status'):
        bad.append(f'{BINFMT} is not mounted, so whether Windows programs run here cannot be told')
    handlers = sorted(p for p in glob.glob(glob.escape(ROOT + BINFMT) + '/*')
                      if os.path.basename(p) not in ('status', 'register'))
    found = [why for p in handlers if (why := windows_handler(os.path.basename(p), read(p[len(ROOT):])))]
    if found:
        bad.append('Windows programs run here: ' + ', '.join(found))
    value = wsl_conf('interop', 'enabled')
    if value != 'false':
        bad.append(f'{WSL_CONF}: [interop] enabled is {value}, not false ({SHUTDOWN})')
    mask = ROOT + MASK
    if not (os.path.islink(mask) and os.readlink(mask) == '/dev/null' or
            not os.path.islink(mask) and os.path.isfile(mask) and os.path.getsize(mask) == 0):
        bad.append(f'{MASK} is not empty or a link to /dev/null, so systemd-binfmt may register WSL\'s handler at boot '
                   f'(ln -sf /dev/null {MASK})')
    return '; '.join(bad) or None


def path_wall():
    value = wsl_conf('interop', 'appendWindowsPath')
    return None if value == 'false' else f'{WSL_CONF}: [interop] appendWindowsPath is {value}, not false ({SHUTDOWN})'


def networking_wall():
    try:
        p = subprocess.run([ROOT + '/usr/bin/wslinfo', '--networking-mode'], stdin=subprocess.DEVNULL,
                           capture_output=True, timeout=20, cwd='/')
    except FileNotFoundError:
        return 'no /usr/bin/wslinfo: this WSL is too old to tell (wsl --update)'
    mode = p.stdout.decode('utf-8', 'replace').strip().lower() if p.returncode == 0 else ''
    if mode != 'nat':
        return (f'networking mode is {mode or f"unknown (wslinfo exit {p.returncode})"}, not nat '
                f'(networkingMode=nat in .wslconfig, {SHUTDOWN})')
    return None


def _close(text, i, closer):
    """The index after the closer of a construct whose body starts at text[i] (`)` of $( or (, `}` of ${, `"`, `'`
    or a backquote), quotes and nested constructs inside it skipped as bash skips them."""
    while i < len(text):
        c = text[i]
        if c == closer:
            return i + 1
        if c == '\\' and closer != "'":
            i += 2
        elif closer == "'":
            i += 1
        elif c == "'" and closer != '"':
            i = _close(text, i + 1, "'")
        elif c == '"' and closer != '"':
            i = _close(text, i + 1, '"')
        elif c == '`':
            i = _close(text, i + 1, '`')
        elif text.startswith('$(', i):
            i = _close(text, i + 2, ')')
        elif text.startswith('${', i):
            i = _close(text, i + 2, '}')
        elif c == '(' and closer == ')':
            i = _close(text, i + 1, ')')
        else:
            i += 1
    raise ValueError('the launcher has a quote or bracket that is never closed')


def _word(text, i):
    """The shell word at text[i]: (its text with quotes taken off and expansions as written, whether bash would
    expand some of it unquoted (a $ or backquote out of double quotes, a glob), the index after it)."""
    out, bare = '', False
    while i < len(text) and text[i] not in ' \t\n;&|<>()':
        c = text[i]
        if text.startswith('\\\n', i):
            i += 2
        elif c == '\\':
            out, i = out + text[i + 1:i + 2], i + 2
        elif c == "'":
            j = _close(text, i + 1, "'")
            out, i = out + text[i + 1:j - 1], j
        elif c == '"':
            j = _close(text, i + 1, '"')
            out += re.sub(r'\\([$`"\\])', r'\1', text[i + 1:j - 1].replace('\\\n', ''))
            i = j
        elif c in '$`':
            bare = True
            if text.startswith('$(', i) or text.startswith('${', i):
                j = _close(text, i + 2, ')' if text[i + 1] == '(' else '}')
            elif c == '`':
                j = _close(text, i + 1, '`')
            else:
                j = re.match(r'\$(\w+|.)?', text[i:]).end() + i
            out, i = out + text[i:j], j
        else:
            bare |= c in '*?['
            out, i = out + c, i + 1
    return out, bare, i


def shell_words(text, i, array):
    """The words from text[i]: of an array's ( ... ) (array: up to its `)`), or of one command (up to the end of its
    line, a ; & or |). Comments and line continuations left out. ([(word, bare)], the index after them)."""
    words = []
    while True:
        while i < len(text) and (text[i] in ' \t' or text.startswith('\\\n', i)):
            i += 2 if text[i] == '\\' else 1
        if i >= len(text):
            if array:
                raise ValueError('the launcher has an array that is never closed')
            return words, i
        c = text[i]
        if c == '#':
            i = text.find('\n', i)
            i = len(text) if i < 0 else i
        elif c == '\n' and array:
            i += 1
        elif c == ')' and array or c in '\n;&|' and not array:
            return words, i + 1
        elif c in ';&|<>()':
            raise ValueError(f'the launcher has {c!r} where the walls read its job units\' properties')
        else:
            word, bare, i = _word(text, i)
            words.append((word, bare))


def uncommented(text):
    """text with each comment blanked out, the same length (an index in it is one in text)."""
    return re.sub(r'(^|[ \t])(#[^\n]*)', lambda m: m.group(1) + ' ' * len(m.group(2)), text, flags=re.M)


def bind_sources(code):
    """The launcher makes ro, rw and resolv_bind (BINDS's values) only as BIND_SOURCES says: from view_ro (what
    `paths` shows), the job's own copy ($2) and the jobs' resolv.conf. Any other assignment cannot be told."""
    found = {name: [] for name in BIND_SOURCES}
    for m in re.finditer(r'(?<![\w$-])(ro|rw|resolv_bind)(?![\w-])', code):
        if code[m.start() - 2:m.start()] == '${':
            continue   # read
        line = code[code.rfind('\n', 0, m.start()) + 1:code.find('\n', m.start())]
        word = re.match(r'(\w+)(\+?=(\([^()]*\)|[^\s;&|()]*))?', code[m.start():]).group(0)
        if re.match(r'\s*local\s', line) and word == m.group(1):
            continue   # declared
        found[m.group(1)].append(word)
    for name, words in found.items():
        if sorted(words) != sorted(BIND_SOURCES[name]):
            raise ValueError(f'the launcher makes {name} (a bind of the job units) by {", ".join(words) or "nothing"},'
                             f' not by {", ".join(BIND_SOURCES[name])} alone: what it binds cannot be told')


def function(text, name):
    """The span in text of the body of the launcher's function name, defined once (bash runs the last one)."""
    m = re.search(rf'^{name}\(\) \{{\n(.*?)^\}}', text, re.M | re.S)
    if not m:
        raise ValueError(f'the launcher has no {name}() (the job units\' properties)')
    if len(re.findall(rf'(^|[\s;&|(){{}}])(function\s+)?{name}\s*(\(\s*\)|\{{)', uncommented(text))) != 1:
        raise ValueError(f'the launcher defines {name}() more than once, or in another way')
    return m.start(1), m.end(1)


def property_words(words, where):
    """The NAME=VALUE of each property in words, as systemd-run reads its options: -p X, -pX, --property X and
    --property=X. Any other word, an abbreviated option (--prop=X) among them, cannot be told: ValueError."""
    out, it = [], iter(words)
    for word, bare in it:
        if bare:
            raise ValueError(f'{where}: bash expands {word!r} (unquoted): its properties cannot be told')
        if word in ('-p', '--property'):
            word, bare = next(it, ('', None))
            if bare is None:
                raise ValueError(f'{where}: {word!r} with no property after it')
            if bare:
                raise ValueError(f'{where}: bash expands {word!r} (unquoted): its properties cannot be told')
            out.append(word)
        elif word.startswith('--property='):
            out.append(word[len('--property='):])
        elif word.startswith('-p'):
            out.append(word[2:])
        else:
            raise ValueError(f'{where}: {word!r} is no property word the walls can read (-p X, -pX, --property X, '
                             '--property=X)')
    return out


def unit_props(text):
    """{property: [values, in order]} of the job units the launcher starts, as systemd-run gets them: start()'s one
    "$SYSTEMD_RUN" command, with sandbox()'s props array where it says "${props[@]}", and job_fs()'s props_fs where
    that says "${props_fs[@]}". Each property in each form systemd-run takes (property_words); values as written
    (quotes off, expansions as in the text). What cannot be told is a ValueError: props or props_fs set or changed
    anywhere else or in another way, another word or option in them, or a property RUN_PROPS does not know."""
    text = text or ''
    sandbox, job_fs, start = (function(text, n) for n in ('sandbox', 'job_fs', 'start'))
    code = uncommented(text)   # where the arrays are used
    sets = {'props': [], 'props_fs': []}
    for m in re.finditer(r'(?<![\w$])(props|props_fs)(?!\w)', code):
        name, at, after = m.group(1), m.start(), code[m.end():]
        line = code[code.rfind('\n', 0, at) + 1:at]
        if code[at - 3:at] == '"${' and after.startswith('[@]}"'):
            continue   # "${props[@]}": read where it is
        if re.fullmatch(r'\s*local\s+-a(\s+\w+(=\(\))?)*\s+', line) and after[:1] in (' ', '\t', '\n'):
            continue   # a declaration
        if after.startswith(('=(', '+=(')):
            span = sandbox if name == 'props' else job_fs
            if span[0] <= at < span[1] and (name == 'props_fs' or after.startswith('=(')):
                sets[name].append(text.index('(', m.end()) + 1)
                continue
        raise ValueError(f'the launcher sets or uses {name} on line {code.count(chr(10), 0, at) + 1} in a way the '
                         'walls cannot read')
    if len(sets['props']) != 1 or not sets['props_fs'] or not code[job_fs[0]:job_fs[1]].count('props_fs=('):
        raise ValueError('the launcher\'s sandbox() must set props once, and job_fs() set props_fs')
    fs = [w for at in sets['props_fs'] for w in shell_words(text, at, True)[0]]
    props = shell_words(text, sets['props'][0], True)[0]
    if props.count(('${props_fs[@]}', False)) != 1:
        raise ValueError('the launcher\'s props must hold "${props_fs[@]}" (what jobs see) once')
    i = props.index(('${props_fs[@]}', False))
    props = props[:i] + fs + props[i + 1:]
    runs = [m.start() for m in re.finditer(r'"\$SYSTEMD_RUN"', code[start[0]:start[1]])]
    if len(runs) != 1:
        raise ValueError('the launcher\'s start() must run "$SYSTEMD_RUN" once')
    words = shell_words(text, start[0] + runs[0], False)[0][1:]
    if ('--', False) not in words:
        raise ValueError('the launcher\'s start() runs systemd-run with no -- before the command')
    words = words[:words.index(('--', False))]
    if words.count(('${props[@]}', False)) != 1:
        raise ValueError('the launcher\'s start() must hand systemd-run "${props[@]}" once')
    unit, rest = [], iter(words)
    for word, bare in rest:
        if (word, bare) == ('${props[@]}', False):
            unit += props
        elif word in RUN_FLAGS:
            continue
        elif word in RUN_OPTIONS:
            next(rest, None)
        elif word.split('=', 1)[0] in RUN_OPTIONS and '=' in word:
            continue
        else:
            unit.append((word, bare))
    bind_sources(code)
    out = {}
    for prop in property_words(unit, 'the launcher\'s job units'):
        name, eq, value = prop.partition('=')
        if not eq or not re.fullmatch(r'[A-Z][A-Za-z]*', name):
            raise ValueError(f'the launcher\'s job units: {prop!r} is not NAME=VALUE')
        if name not in RUN_PROPS and not RESTRICTS.fullmatch(name):
            raise ValueError(f'the launcher\'s job units get {name}=, which the walls do not know (RUN_PROPS): '
                             'add it there once it is known to open nothing')
        if name in READ_LITERAL and re.search(r'[$`]', value):
            raise ValueError(f'the launcher\'s job units: {name}={value} is not written out, so it cannot be told')
        out.setdefault(name, []).append(value)
    return out


def props_after_reset(values):
    """The assignments of a property that count, as systemd reads them: an empty one drops all before it."""
    values = values or []
    last = max((i for i, v in enumerate(values) if not v.strip()), default=-1)
    return values[last + 1:]


def merged(values):
    """The words a list property ends up with, as systemd merges it: every assignment adds its words."""
    return [w for v in props_after_reset(values) for w in v.split()]


def launcher_props():
    """The job units' properties (unit_props) of the launcher the linux walls ask what jobs see (LINUX.LAUNCHER,
    beside this folder: the one the pool runs, also under FORK_FLEET_LAUNCH_CONF), checked as they check it, on the
    open file itself, if it is the launcher this file was checked against (LAUNCHER_SHA256)."""
    path = LINUX.LAUNCHER
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, 'O_CLOEXEC', 0))   # a FIFO: no wait
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
            raise ValueError(f'{path} is not a plain file owned by uid {os.geteuid()} and writable by it alone')
        with os.fdopen(fd, 'rb') as f:
            fd = None
            data = f.read()
        if hashlib.sha256(data).hexdigest() != LAUNCHER_SHA256:
            raise ValueError(f'{path} is not the launcher these walls were checked against (its sha256 is not '
                             f'LAUNCHER_SHA256): install the kit whole, the walls and the launcher from one release')
        return unit_props(data.decode('utf-8', 'replace'))
    finally:
        if fd is not None:
            os.close(fd)


def vsock_wall():
    """Part of the sockets wall: the job units close AF_VSOCK, and io_uring and other-arch calls, which pass that."""
    props = launcher_props()
    families = [v.split() for v in props.get('RestrictAddressFamilies', [])]
    filters = [v.split() for v in props.get('SystemCallFilter', [])]
    arches = merged(props.get('SystemCallArchitectures'))
    bad = []
    if not families or any(not f or not f[0].startswith('~') for f in families) or \
            'AF_VSOCK' not in {w.lstrip('~') for f in families for w in f}:
        bad.append('AF_VSOCK is not on a RestrictAddressFamilies=~ list of its own')
    if not filters or any(not f or not f[0].startswith('~') for f in filters) or \
            'io_uring_setup' not in {w.lstrip('~').split(':')[0] for f in filters for w in f}:
        bad.append('io_uring_setup is not on a SystemCallFilter=~ list of its own (IORING_OP_SOCKET passes the first)')
    if not arches or set(arches) != {'native'}:
        bad.append(f'SystemCallArchitectures is {" ".join(arches) or "not set"}, not native alone (i386 or x32 calls '
                   'pass the first)')
    if bad:
        return f'the launcher\'s job units ({LINUX.LAUNCHER}): ' + '; '.join(bad) + ' (the launcher walls, D1)'
    return None


def binds_wall():
    """Part of the sockets wall: a job unit gets the host's files only through what `paths` shows. Its binds are the
    launcher's own (BINDS: what `paths` shows, the job's copy, the jobs' resolv.conf), its root and environment file
    its own (ONLY), and no device of the host: PrivateDevices= true, as systemd merges it (the last one wins), so
    /dev/dxg (WSL's GPU channel to Windows) and the like stay out. [reasons, empty if none]"""
    props, bad = launcher_props(), []
    extra = sorted({f'{name}={value}' for name in ('BindPaths', 'BindReadOnlyPaths')
                    for value in props.get(name, []) if (name, value) not in BINDS}
                   | {f'{name}={value}' for name, only in ONLY.items() for value in props.get(name, [])
                      if value != only})
    if extra:
        bad.append(f'its job units get {", ".join(extra[:3])} beside what `paths` shows ({LINUX.LAUNCHER})')
    devices = props.get('PrivateDevices', [])
    if not devices or devices[-1].strip().lower() not in TRUE:   # a boolean: the last one wins, an empty one resets
        now = (devices[-1].strip() or 'reset') if devices else 'not set'
        bad.append(f'its job units see this host\'s /dev (PrivateDevices is {now} in {LINUX.LAUNCHER}, not yes: '
                   '/dev/dxg reaches Windows\' GPU driver)')
    return bad


def sockets_wall():
    """No socket to Windows in a job unit. Job units get a /run and a /tmp of their own (TemporaryFileSystem), and
    what the launcher shows them (`paths`, through the linux walls: the same view, asked once more) holds none of
    those folders, /mnt nor /init, where it comes from: WSL's interop sockets (/run/WSL) and WSLg's X socket
    (/tmp/.X11-unix) stay out. Nothing else of the host is bound in, nor its devices (binds_wall). And AF_VSOCK is
    closed to them (vsock_wall)."""
    own = {entry.split(':')[0].rstrip('/') or '/' for entry in merged(launcher_props().get('TemporaryFileSystem'))}
    bad = [f'its job units see this host\'s {d} (no TemporaryFileSystem={d} for them in {LINUX.LAUNCHER})'
           for d in OWN_DIRS if d not in own]
    shown = sorted({real for _, real in LINUX.job_view()   # the host path a job reaches, wherever it sits there
                    if any(real == d or real.startswith(d + '/') for d in WSL_ONLY)})
    if shown:
        bad.append(f'the launcher\'s `paths` lets jobs see {", ".join(shown[:3])} (its launch.conf, ALLOW_PATHS or '
                   'JOB_PATHS)')
    if bad:
        bad[-1] += ' (WSL\'s interop sockets are in /run/WSL)'
    bad += binds_wall()
    why = vsock_wall()
    return '; '.join(bad + [why] if why else bad) or None


def userns_wall():
    """Jobs make no user namespace: the host allows none (a knob of USERNS_OFF), or the launcher's job units refuse
    them (RestrictNamespaces, as systemd merges it: every assignment since the last empty one says so). AppArmor's
    restriction does not count: it has known ways around it."""
    if any(read(path) == off for path, off in USERNS_OFF):
        return None
    values = props_after_reset(launcher_props().get('RestrictNamespaces'))
    words = [v.split() for v in values]
    if values and (all(v.strip().lower() in ('yes', 'true', 'on', '1') for v in values)
                   or all(w[0].startswith('~') and 'user' in [w[0][1:]] + w[1:] for w in words)
                   or all(not w[0].startswith('~') and w[0].lower() not in ('no', 'false', 'off', '0')
                          and 'user' not in w for w in words)):
        return None
    now = read(USERNS_OFF[0][0])
    return (f'jobs can make user namespaces ({USERNS_OFF[0][0]} is {now or "not readable"}, no RestrictNamespaces '
            f'that refuses user for the job units of {LINUX.LAUNCHER}): echo user.max_user_namespaces=0 > {SYSCTL}; '
            'sysctl --system')


def resolve(path):
    """Where path leads under ROOT, every link followed (an absolute one from ROOT): a path, or ValueError."""
    parts, out, hops = path.strip('/').split('/'), '', 0
    while parts:
        part = parts.pop(0)
        if part in ('', '.'):
            continue
        if part == '..':
            out = out.rsplit('/', 1)[0]
            continue
        if os.path.islink(ROOT + out + '/' + part):
            hops += 1
            if hops > 40:
                raise ValueError(f'{path} leads round in a loop of links')
            target = os.readlink(ROOT + out + '/' + part)
            out = '' if target.startswith('/') else out
            parts = target.strip('/').split('/') + parts
        else:
            out += '/' + part
    return out or '/'


def resolv_wall():
    bad = []
    value = wsl_conf('network', 'generateResolvConf')
    if value != 'false':
        bad.append(f'{WSL_CONF}: [network] generateResolvConf is {value}, not false, so WSL makes {RESOLV} a link to '
                   f'/mnt/wsl/resolv.conf at every start ({SHUTDOWN})')
    target = resolve(RESOLV)
    if any(target == d or target.startswith(d + '/') for d in NOT_RESOLV):
        bad.append(f'{RESOLV} leads to {target}, so job units would get that folder (rm {RESOLV}, then write a file '
                   'with this host\'s nameservers there)')
    elif not os.path.isfile(ROOT + target):
        bad.append(f'{RESOLV} leads to {target}, which is not a file')
    return '; '.join(bad) or None


OWN = [
    ('interop', 'WSL interop is off and stays off: no Windows program runs from here', interop_wall),
    ('sockets', 'job units reach no socket to Windows: their /run and /tmp are their own, no other bind nor device, '
     'AF_VSOCK is closed',
     sockets_wall),
    ('userns', 'jobs cannot make a user namespace (the way into kernel bugs)', userns_wall),
    ('resolv', f'{RESOLV} is the distro\'s own file, not a link into /mnt that WSL makes', resolv_wall),
    ('windows-path', 'Windows\' PATH is not appended to the distro\'s', path_wall),
    ('networking', 'WSL networking mode is nat (not mirrored)', networking_wall),
]


def walls():
    """Every wall: this file's os, each of the linux file's other walls as it has them, then WSL2's own."""
    out = [('os', 'a WSL2 kernel (not WSL1, not plain Linux)', os_wall)]
    for wall, what, test in LINUX.WALLS:
        if wall != 'os':
            out.append((wall, what, {'systemd': systemd_wall, 'container': container_wall}.get(wall, test)))
    return out + OWN


def main(argv):
    global LINUX
    if len(argv) != 1 or argv[0] not in ('check', 'describe'):
        print('usage: wsl2 check | describe', file=sys.stderr)
        return 2
    try:   # without the linux walls this file cannot even name its walls: a broken install, not a FAIL list
        LINUX = load_linux()
        every = walls()
    except Exception as e:
        print(f'wsl2: cannot load the linux walls ({e.__class__.__name__}: {e})', file=sys.stderr)
        return 2
    failed = False
    for wall, what, test in every:
        try:
            why = test()
        except Exception as e:   # a wall that cannot be told does not hold
            why = f'cannot tell ({e.__class__.__name__}: {e})'
        failed |= why is not None
        if why is not None:
            print(f'FAIL  {wall}  ' + LINUX.text(f'{what}: {why}')[:400])
        elif argv[0] == 'describe':
            print(f'PASS  {wall}  {what}')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
