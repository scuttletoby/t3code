#!/usr/bin/python3 -IB
"""schedule-kick: the schedule-kick kit (lib/schedulekick). Starts listed GitHub workflows at their cron times.
-I: no environment variable, user site folder or current folder changes what Python loads. The code is loaded
only from this file's real folder."""
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))
from schedulekick import kick  # noqa: E402
sys.exit(kick.main(sys.argv[1:]))
