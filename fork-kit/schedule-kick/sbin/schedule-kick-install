#!/usr/bin/python3 -IB
"""schedule-kick-install: install, uninstall or check the schedule-kick kit, as root (fork-kit/schedule-kick/README.md).

  schedule-kick-install install --source KIT_FOLDER --sha RELEASE_SHA [--timer | --no-timer]
  schedule-kick-install uninstall
  schedule-kick-install self-check

install copies bin/schedule-kick, sbin/schedule-kick-install, lib/schedulekick/, systemd/, README.md and
fork-kit/common/{kit_install,machine_file,alert}.py of one release into /usr/local/libexec/schedule-kick/versions/<sha>/ (with
MANIFEST.sha256), checks the copy, switches the link `current` to it and links /usr/local/bin/schedule-kick and
/usr/local/sbin/schedule-kick-install to it. With --timer it also writes the kit's timers: the user units
schedule-kick.service and schedule-kick.timer in /etc/systemd/user/, which run `schedule-kick tick` every 5 minutes,
and schedule-kick-keep-on.service and .timer, which run `schedule-kick keep-on` every 15 seconds, for each user who
enables them (that user's own config file names the workflows and the token); --no-timer removes them. The choice is kept in /etc/schedule-kick/config.json, so a run without either option keeps it. Safe
to run again, and to stop at any step; one installer at a time. The steps every kit shares are in
fork-kit/common/kit_install.py.
"""
import os, sys
_kit = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_common = os.path.join(_kit, 'common')
sys.path[:0] = [_common if os.path.isdir(_common) else os.path.join(os.path.dirname(_kit), 'common')]
try:
    import kit_install  # noqa: E402
except ImportError as e:     # a copy without common/kit_install.py (changed or partly removed by hand)
    sys.exit(f'schedule-kick-install: cannot load its installer code ({e}): install again with the bootstrap, as '
             'root (fork-kit/schedule-kick/README.md, Install)')

UNIT_DIR = '/etc/systemd/user'
TIMER_UNITS = ('schedule-kick.service', 'schedule-kick.timer', 'schedule-kick-keep-on.service',
               'schedule-kick-keep-on.timer')
UNIT_HEADER = '# schedule-kick kit: written by schedule-kick-install.'
ENABLE = ('systemctl --user daemon-reload && systemctl --user enable --now schedule-kick.timer (and, with keepOn, '
          'schedule-kick-keep-on.timer)')
DISABLE = 'systemctl --user disable --now schedule-kick.timer schedule-kick-keep-on.timer'


class ScheduleKickInstaller(kit_install.Installer):
    PROG = 'schedule-kick-install'
    PROGRAM = __file__
    KIT = 'schedule-kick'
    ETC = '/etc/schedule-kick'
    LIBEXEC = '/usr/local/libexec/schedule-kick'
    LINKS = {'/usr/local/bin/schedule-kick': 'bin/schedule-kick',
             '/usr/local/sbin/schedule-kick-install': 'sbin/schedule-kick-install'}
    SOURCE_FILES = ('bin/schedule-kick', 'sbin/schedule-kick-install', 'README.md', 'common/kit_install.py',
                    'common/machine_file.py', 'common/alert.py') + tuple(f'systemd/{u}' for u in TIMER_UNITS)
    EXECUTABLE = frozenset({'bin/schedule-kick', 'sbin/schedule-kick-install'})
    PACKAGE = 'schedulekick'
    MODULES = ('__init__', 'cron', 'github', 'heads', 'keepon', 'kick', 'late')
    HELP = ('bin/schedule-kick', 'schedule-kick tick')
    HAS_CONFIG = True
    KIT_STEPS = ('timer-units',)

    def add_install_options(self, parser):
        parser.add_argument('--timer', dest='timer', action='store_true', default=None)
        parser.add_argument('--no-timer', dest='timer', action='store_false')

    def unit_paths(self):
        return [f'{UNIT_DIR}/{name}' for name in TIMER_UNITS]

    def ours_unit(self, path):
        """A unit file this kit wrote (its first line says so), and no link."""
        real = self.p(path)
        if os.path.islink(real):
            return False
        try:
            with open(real, encoding='utf-8') as f:
                return f.readline().startswith(UNIT_HEADER)
        except OSError:
            return False

    def plan(self, a):
        timer = a.timer if a.timer is not None else bool(self.read_config().get('timer'))
        foreign = [u for u in self.unit_paths() if os.path.lexists(self.p(u)) and not self.ours_unit(u)]
        if timer and foreign:
            raise self.Refused(f'{foreign[0]} exists and was not written by this kit: remove it and run again, or '
                               'run with --no-timer to leave it alone')
        return {'timer': timer}

    def config(self, a, plan):
        return {'version': 1, 'timer': plan['timer']}

    def kit_step(self, step, a, plan, dest):
        # after the links: the timer is only written once the release it runs is the one in use
        for name, path in zip(TIMER_UNITS, self.unit_paths()):
            if plan['timer']:
                if os.path.lexists(self.p(path)) and not self.ours_unit(path):
                    raise self.Refused(f'{path} exists and was not written by this kit: remove it and run again, '
                                       'or run with --no-timer to leave it alone')
                self.ensure_dir(UNIT_DIR)
                with open(os.path.join(dest, 'systemd', name), encoding='utf-8') as f:
                    if self.write_file(path, f.read()):
                        self.say(f'wrote {path}: each user with a config runs `{ENABLE}`')
            elif self.ours_unit(path):
                os.unlink(self.p(path))
                self.say(f'removed {path} (users run `{DISABLE}`)')

    def kit_rows(self, plan):
        if not plan['timer']:
            return []
        return [(path, 'file', kit_install.sha256_file(self.p(path))) for path in self.unit_paths()]

    def kit_uninstall(self):
        for path in self.unit_paths():
            if self.ours_unit(path):
                os.unlink(self.p(path))
                self.say(f'removed {path} (users run `{DISABLE}`)')

    def installed_summary(self, plan):
        return ', timer units written (tick every 5 minutes, keep-on every 15 seconds)' if plan['timer'] else ', no timer'


INSTALLER = ScheduleKickInstaller()


def main(argv, stop_after=None):
    return INSTALLER.main(argv, stop_after, doc=__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
