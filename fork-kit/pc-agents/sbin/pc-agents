#!/usr/bin/python3 -I
"""pc-agents: wall a WSL2 distro in, then run T3 Code in it as an unprivileged user (fork-kit/pc-agents/README.md).

  pc-agents setup --source DIR --sha SHA   as root, in a fresh distro: make or repair everything; safe to run again
  pc-agents check [--enforce]              every wall, PASS or FAIL; exit 0 only when all hold. --enforce also
                                           stops T3 when one fails (the daily timer). T3's unit runs it before
                                           every start, so T3 never starts on a failed wall.
Standard library only."""
import os, re, stat, sys

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
COMMON = os.path.join(os.path.dirname(HERE), 'common')
sys.path[:0] = [os.path.join(HERE, 'lib')] + ([COMMON] if os.path.isdir(COMMON) else [])
sys.dont_write_bytecode = True
import machine_file  # noqa: E402
import pc_agents as k  # noqa: E402


def say(text):
    print(f'pc-agents: {text}', flush=True)


def put(path, data, mode, link=False):
    """Write a file (or a link) whole: a new file beside it, then one rename. Returns True when it changed."""
    real = k.ROOT + path
    st = k.lstat(path)
    if link and st and stat.S_ISLNK(st.st_mode) and os.readlink(real) == data:
        return False
    if not link and st and stat.S_ISREG(st.st_mode) and stat.S_IMODE(st.st_mode) == mode and st.st_uid == k.OWNER:
        with open(real, 'rb') as f:
            if f.read() == (data.encode() if isinstance(data, str) else data):
                return False
    os.makedirs(os.path.dirname(real), mode=0o755, exist_ok=True)
    tmp = f'{real}.pc-agents-new'
    if os.path.lexists(tmp):
        os.unlink(tmp)
    if link:
        os.symlink(data, tmp)
    else:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(data.encode() if isinstance(data, str) else data)
            os.fchmod(f.fileno(), mode)
            if not k.ROOT:
                os.fchown(f.fileno(), 0, 0)
            os.fsync(f.fileno())
    os.replace(tmp, real)
    return True


def fresh(path, st):
    """A file a fresh distro has where the kit writes its own: replaced without asking."""
    if path == '/etc/resolv.conf':
        return stat.S_ISLNK(st.st_mode) or 'generated by WSL' in open(k.ROOT + path, errors='replace').read()
    if path == '/etc/wsl.conf' and stat.S_ISREG(st.st_mode):
        text = re.sub(r'(?m)^\s*[#;].*\n?|\s+', '', open(k.ROOT + path, errors='replace').read()).lower()
        return text in ('', '[boot]systemd=true')
    return False


def preflight(c, files):
    """Every reason not to touch this distro, before anything is written."""
    bad = [why] if (why := k.user_problem(c, False)) else []
    done = k.record()
    for path, (text, _) in files.items():
        st = k.lstat(path)
        if st is None or fresh(path, st):
            continue
        if not stat.S_ISREG(st.st_mode):
            bad.append(f'{path} is not a plain file')
            continue
        with open(k.ROOT + path, 'rb') as f:
            now = k.sha(f.read())
        if now != k.sha(text) and done.get(path) != now:
            bad.append(f'{path} was not written by this kit, or was edited since (move it away to go on)')
    for path in k.MASKS:
        st = k.lstat(path)
        if st and not (stat.S_ISLNK(st.st_mode) and os.readlink(k.ROOT + path) == '/dev/null'):
            bad.append(f'{path} exists and is not a mask (a link to /dev/null)')
    return bad


def setup(source, sha):
    if not re.fullmatch(r'[0-9a-f]{40}', sha) or not os.path.isdir(source):
        return say('usage: pc-agents setup --source DIR --sha 40-HEX-SHA') or 2
    if not k.ROOT and os.geteuid() != 0:
        return say('run this as root') or 2
    os.umask(0o022)
    try:
        c = k.config()
    except machine_file.MachineFileError as e:
        return say(f'{e} (fork-kit/pc-agents/README.md has an example)') or 2
    files = k.render(c)
    bad = preflight(c, files)
    if bad:
        return say('refused, nothing changed:\n  ' + '\n  '.join(bad)) or 1
    if k.USER not in k.users()[0]:
        r = k.run(['/usr/sbin/useradd', '--create-home', '--home-dir', k.HOME, '--shell', '/bin/bash',
                   '--uid', str(c['agentUid']), '--user-group', k.USER])
        if r.returncode:
            return say(f'useradd failed: {r.stderr.strip()[-300:]}') or 1
    if k.lstat('/usr/sbin/nft') is None and k.run(['/usr/bin/apt-get', 'install', '-y', 'nftables']).returncode:
        return say('cannot install nftables (apt-get install -y nftables)') or 1
    version = f'{k.OPT}/{sha}'
    for src, (dst, mode) in k.CODE.items():
        with open(os.path.join(source, src), 'rb') as f:
            put(f'{version}/{dst}', f.read(), mode)
    changed = put(f'{k.OPT}/current', sha, None, link=True)
    done = k.record()
    for path, (text, mode) in files.items():   # each one recorded as soon as it is written: a stop leaves no stranger
        changed |= put(path, text, mode)
        done[path] = k.sha(text)
        put(k.RECORD, ''.join(f'{h}\t{p}\n' for p, h in sorted(done.items())), 0o644)
    for path in k.MASKS:
        put(path, '/dev/null', None, link=True)
    if k.lstat(k.runtime(c)) is None:
        say(f'installing T3 {c["t3Version"]} for {k.USER}')
        r = k.run(['/usr/sbin/runuser', '-u', k.USER, '--', '/usr/bin/env', '-i', f'HOME={k.HOME}',
                   'PATH=/usr/bin:/bin', f'T3CODE_HOME={k.HOME}/.t3', f'T3CODE_VERSION={c["t3Version"]}',
                   f'T3CODE_RELEASE_BASE_URL={c["t3ReleaseBaseUrl"]}', '/bin/sh', f'{version}/share/install.sh'])
        if r.returncode or k.lstat(k.runtime(c)) is None:
            return say(f'T3 install failed: {(r.stderr or r.stdout).strip()[-400:]}') or 1
    k.run(['/usr/bin/systemctl', 'daemon-reload'])
    k.run(['/usr/sbin/nft', '-f', k.STATE + '/firewall.nft'])   # as T3's unit does before each start
    units = [k.UNIT, k.WALLS + '.timer']
    if check(False) != 0:
        k.run(['/usr/bin/systemctl', 'disable', '--now'] + units)
        return say('a wall does not hold, so T3 is not enabled. After a first run: wsl --terminate <this distro> '
                   'from Windows, then run setup again') or 3
    r = k.run(['/usr/bin/systemctl', 'enable', '--now'] + units)
    if r.returncode == 0 and changed:
        r = k.run(['/usr/bin/systemctl', 'restart', k.UNIT])
    if r.returncode:
        return say(f'systemctl failed: {r.stderr.strip()[-300:]}') or 1
    say(f'done: T3 serves on port {c["port"]}. Next: tailscale up --advertise-tags={c["tailscaleTag"]}')
    return 0


def own_walls(c):
    """(wall, what, why or None) for the walls this kit adds to fork-fleet-walls/wsl2."""
    out, done = [], k.record()
    for path, (text, mode) in k.render(c).items():
        st = k.lstat(path)
        why = k.safe(path, st, stat.S_ISREG)
        if why is None:
            with open(k.ROOT + path, 'rb') as f:
                why = None if f.read() == text.encode() and done.get(path) == k.sha(text) else \
                    f'{path} differs from what the kit writes (pc-agents setup)'
        out.append(('file:' + os.path.basename(path), f'{path} is the kit\'s, root-owned', why))
    masks = [p for p in k.MASKS if not (k.lstat(p) and os.path.islink(k.ROOT + p)
                                       and os.readlink(k.ROOT + p) == '/dev/null')]
    out.append(('masks', 'WSL interop, cron, at and ssh are masked', masks and 'not masked: ' + ', '.join(masks)))
    extra = [f'{d}/{n}' for d in k.UNIT_DIRS for n in (k.UNIT + '.d', k.WALLS + '.service.d') + (
        ('service.d',) if d in k.UNIT_DIRS[:2] else ()) + ((k.UNIT,) if d != k.UNIT_DIRS[0] else ())
        if k.lstat(f'{d}/{n}')]
    out.append(('drop-ins', 'nothing overrides the unit', extra and 'found ' + ', '.join(extra)))
    out.append(('agent', f'one login user, {k.USER}, in no group but its own', k.user_problem(c, True)))
    code = []
    for top, dirs, names in os.walk(k.ROOT + k.OPT + '/current/'):
        for n in dirs + names:
            p = os.path.join(top, n)[len(k.ROOT):]
            code += [why] if (why := k.safe(p, k.lstat(p), lambda m: stat.S_ISDIR(m) or stat.S_ISREG(m))) else []
    current = k.lstat(k.OPT + '/current')
    code += [] if current and current.st_uid == k.OWNER else [f'{k.OPT}/current is not the kit\'s']
    out.append(('kit-code', f'{k.OPT}/current is root-owned', code[:3] and '; '.join(code[:3])))
    mounts = []
    try:
        with open(k.ROOT + '/proc/self/mountinfo', encoding='utf-8', errors='replace') as f:
            for line in f:
                fields = line.split(' - ')
                where, fstype = fields[0].split()[4], (fields[1].split() or [''])[0] if len(fields) > 1 else ''
                if fstype in ('9p', 'drvfs', 'virtiofs') and not where.startswith('/usr/lib/wsl'):
                    mounts.append(f'{where} ({fstype})')
    except (OSError, IndexError) as e:
        mounts.append(f'cannot read /proc/self/mountinfo ({e})')
    out.append(('automount', 'no Windows drive is mounted', mounts and 'mounted: ' + ', '.join(mounts[:3])))
    r = k.run(['/usr/sbin/nft', 'list', 'table', 'inet', 'pc_agents'])
    nft_ok = r.returncode == 0 and f'skuid != {c["agentUid"]}' in r.stdout and ' drop' in r.stdout
    out.append(('firewall', 'the agent firewall is loaded', None if nft_ok else 'table inet pc_agents is not loaded'))
    gateway = None
    try:
        with open(k.ROOT + '/proc/net/route', encoding='utf-8') as f:
            row = next((line.split() for line in f if line.split()[1:2] == ['00000000']), None)
        gateway = row and k.ipaddress.ip_address(bytes.fromhex(row[2])[::-1])
    except (OSError, ValueError) as e:
        gateway = f'unknown ({e})'
    blocked = isinstance(gateway, k.ipaddress.IPv4Address) and \
        any(gateway in k.ipaddress.ip_network(n) for n in k.BLOCKED4)
    out.append(('gateway', 'the Windows host (the default gateway) is in a blocked range',
                None if blocked else f'the gateway is {gateway}, not in a blocked range'))
    return out


def wsl2_walls():
    """(wall, what, why or None) of the fleet's wsl2 walls (fork-fleet-walls.py, its contract enforced there)."""
    env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LC_ALL': 'C'}
    if k.ROOT:
        env['FORK_FLEET_WALLS_ROOT'] = k.ROOT
    try:
        p = k.subprocess.run([k.ROOT + k.WALLS_PY, 'describe'], env=env, stdin=k.subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=120, cwd='/')
    except (OSError, k.subprocess.TimeoutExpired) as e:
        return [('wsl2', 'the fleet\'s wsl2 walls ran', f'cannot run them ({e})')]
    lines = [m.groups() for m in re.finditer(r'^(PASS|FAIL)  (\S+)  (.*)$', p.stdout, re.M)]
    if p.returncode not in (0, 1) or not lines:
        return [('wsl2', 'the fleet\'s wsl2 walls ran', f'exit {p.returncode}: {p.stderr.strip()[-300:]}')]
    return [(f'wsl2:{w}', what, None if mark == 'PASS' else what) for mark, w, what in lines if w not in k.UNIT_WALLS]


def check(enforce):
    try:
        c = k.config()
        results = wsl2_walls() + own_walls(c)
    except Exception as e:   # a wall that cannot be told does not hold
        results = [('check', 'the walls can be read', f'{e.__class__.__name__}: {e}')]
    for wall, what, why in results:
        print(f'FAIL  {wall}  {what}: {why}'[:500] if why else f'PASS  {wall}  {what}', flush=True)
    failed = any(why for _, _, why in results)
    if failed and enforce:
        k.run(['/usr/bin/systemctl', 'stop', k.UNIT])
        say(f'a wall does not hold: stopped {k.UNIT}')
    return 1 if failed else 0


def main(argv):
    if argv[:1] == ['check'] and argv[1:] in ([], ['--enforce']):
        return check(argv[1:] == ['--enforce'])
    if argv[:1] == ['setup'] and len(argv) == 5 and argv[1] == '--source' and argv[3] == '--sha':
        return setup(argv[2], argv[4])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
