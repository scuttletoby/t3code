{
  "version": 1,
  "heavy": {
    "sweep": {
      "stop": false,
      "minAgeSeconds": 600,
      "longLivedSeconds": 7200,
      "busyCpuPercent": 20,
      "report": "~/.local/state/heavy-sweep",
      "knownUnits": ["example-app.service", "dbus.service"],
      "knownContainers": ["example-dev-db"],
      "testPatterns": [
        "(^|[ /])pytest( |$)",
        "\\.test\\.(py|sh|cjs)( |$)",
        "GradleWorkerMain( |$)",
        "testcontainers"
      ],
      "ignorePatterns": ["^(tmux|screen|SCREEN)( |:|$)", "^-", "^ssh-agent"]
    }
  },
  "golive": {
    "home": "/srv/example/t3-home",
    "targetVersion": "0.0.0-example.fork.1",
    "stageDir": "/srv/example/golive/stage",
    "backupDir": "/srv/example/golive/backups",
    "stateDir": "/srv/example/golive/state",
    "freeFloorMb": 2048
  },
  "pc-agents": {
    "organization": "Example home lab",
    "t3Version": "0.0.30",
    "t3ReleaseBaseUrl": "https://github.com/example/t3code/releases/download",
    "port": 3773,
    "maxRuntimeMode": "full-access",
    "lockedSettings": { "agentSlots.enabled": true, "agentSlots.maxPerMachine": 2 },
    "memoryMax": "8G",
    "cpuQuota": "400%",
    "nameservers": ["1.1.1.1", "9.9.9.9"],
    "tailscaleTag": "tag:pc-agents"
  }
}
