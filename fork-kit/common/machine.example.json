{
  "version": 1,
  "heavy": {
    "sweep": {
      "stop": false,
      "minAgeSeconds": 600,
      "longLivedSeconds": 7200,
      "busyCpuPercent": 20,
      "report": "~/.local/state/heavy-sweep",
      "knownUnits": ["example-app.service", "dbus.service"],
      "knownContainers": ["example-dev-db"],
      "testPatterns": [
        "(^|[ /])pytest( |$)",
        "\\.test\\.(py|sh|cjs)( |$)",
        "GradleWorkerMain( |$)",
        "testcontainers"
      ],
      "ignorePatterns": ["^(tmux|screen|SCREEN)( |:|$)", "^-", "^ssh-agent"]
    },
    "capacity": {
      "holds": [{ "label": "ci-slice", "cgroup": "ci.slice/ci-runners.slice", "users": ["ci-*"] }]
    },
    "disk": { "floorGb": 25, "path": "~" }
  },
  "golive": {
    "home": "/srv/example/t3-home",
    "targetVersion": "0.0.0-example.fork.1",
    "stageDir": "/srv/example/golive/stage",
    "backupDir": "/srv/example/golive/backups",
    "stateDir": "/srv/example/golive/state",
    "freeFloorMb": 2048,
    "quietCommand": "/srv/example/golive/bin/quiet",
    "preHooks": ["/srv/example/golive/bin/pause-jobs"],
    "postHooks": ["/srv/example/golive/bin/resume-jobs"],
    "quietWaitSeconds": 7200,
    "stopLimitSeconds": 1800,
    "rehearsalMaxAgeHours": 72
  },
  "pc-agents": {
    "organization": "Example home lab",
    "t3Version": "0.1.9",
    "t3ReleaseBaseUrl": "https://github.com/example/t3code/releases/download",
    "port": 3773,
    "maxRuntimeMode": "full-access",
    "lockedSettings": {},
    "memoryMax": "8G",
    "cpuQuota": "400%",
    "nameservers": ["1.1.1.1", "9.9.9.9"],
    "peers": ["100.101.102.103/32"],
    "tailscaleTag": "tag:pc-agents"
  },
  "model-guard": {
    "policyFile": "/etc/fork-kit/model-policy.json",
    "t3ModelManifests": ["/srv/example/t3-home/userdata/model-manifest.json"]
  },
  "agent-guards": {
    "actionsDisable": {
      "stateDir": "~/.local/state/actions-disable-guard",
      "refuseScripts": [
        { "name": "example_garden.py", "flag": "--fix", "why": "disables workflows in the forks" }
      ]
    },
    "capacityPipe": { "commands": ["t3-capacity"] },
    "memoryIndex": { "maxChars": 6000, "maxLine": 160, "stateDir": "~/.cache/memory-index-guard" },
    "bgGuard": {
      "skipSessionsFiles": ["~/.local/state/example-orch/slot-sessions.txt"],
      "maxBlocks": 3,
      "stateDir": "~/.local/state/bg-guard"
    },
    "agentSlots": {
      "sessionsFile": "~/.local/state/example-orch/slot-sessions.txt",
      "queue": "/srv/example/QUEUE.md",
      "readyHeading": "## Ready",
      "maxAlive": 10,
      "processName": "claude",
      "note": "at most 4 build agents"
    }
  },
  "cleaner": {
    "logFile": "~/.local/state/fork-cleaner/cleaner.log",
    "mustKeep": ["/srv/example/ledger"],
    "worktrees": {
      "repos": [
        {
          "root": "~/worktrees",
          "github": "example-owner/example-repo",
          "regenerable": ["dist"],
          "branches": ["work/*"],
          "mergedBranches": true
        }
      ]
    },
    "tmp": { "root": "/tmp", "patterns": { "example-build-*": 7 } },
    "docker": { "enabled": true, "days": 7 },
    "agentScratch": { "enabled": true, "days": 3 },
    "compressCold": { "folders": [{ "path": "~/.codex/sessions", "days": 30 }] },
    "dedupe": { "folders": [{ "path": "~/mirrors", "days": 30 }], "writtenInPlace": [] },
    "report": { "warnFreeGB": 60 },
    "daily": {
      "mode": "compare",
      "oldTimers": ["example-retention.timer"],
      "compare": [
        {
          "name": "example-retention",
          "command": ["/usr/local/bin/example-retention", "--dry-run"],
          "pattern": "^would remove (/.+?) \\("
        }
      ]
    }
  },
  "update-policy": {
    "role": "dev",
    "quietHour": "05:00",
    "timeZone": "Europe/London",
    "windowMinutes": 120,
    "retryMinutes": 15,
    "alertCommand": ["/srv/example/bin/notify-owner", "--topic", "updates"],
    "alertOnBoot": false,
    "containerUsers": ["example-agent"],
    "systemDocker": true,
    "ignoreContainers": ["example-dev-db"],
    "heavySlice": "heavy.slice",
    "busyScripts": ["/srv/example/bin/busy-while-running"],
    "baseline": {
      "ports": ["tcp/22@100.64.0.0/10", "udp/41641", "tcp/3773@100.64.0.0/10"],
      "ignoreLoopback": true,
      "diskPercent": 90,
      "diskPaths": ["/"],
      "pendingDays": 3,
      "sshUsers": ["root", "example-agent"]
    },
    "exposure": {
      "enabled": true,
      "epssMin": 0.1,
      "fixWaitingDays": 3,
      "staleDays": 3,
      "maxFeedMb": 64,
      "maxXmlMb": 1024,
      "timeoutSeconds": 60,
      "ignore": [
        {
          "cve": "CVE-2021-1789",
          "reason": "example: the package is not used here",
          "until": "2026-12-31"
        }
      ]
    }
  },
  "desk": {
    "pool": "pc",
    "host": "fleet-host.example",
    "hostKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "slots": 2,
    "reserveMb": 4096,
    "freeCommand": "/opt/fork-fleet/free-memory"
  }
}
