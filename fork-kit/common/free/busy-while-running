#!/bin/sh
# A free/v1 script (FREE.md): busy while one of the programs in NAMES runs, say a game or a video editor, so the
# machine is left to its person. Copy it, put your programs' process names (as `ps -e -o comm=` shows them) in
# NAMES, make the copy root's and not writable by others, and name the copy as the free command.
# It matches the process name, not the command line: `python3 game.py` shows as python3. Wine usually names its
# process after the .exe (`game.exe`, cut to 15 characters), not wine.
# It sees the processes of this system only: in WSL, Windows programs are not visible (interop is off, on purpose).
NAMES='example-game example-editor'

at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
running=$(ps -e -o comm=) || { echo '{"v": 1, "free": false, "reason": "ps failed", "at": "'"$at"'"}'; exit 1; }
for name in $NAMES; do
  short=$(printf '%.15s' "$name")   # the kernel keeps only the first 15 characters of a process name
  if printf '%s\n' "$running" | grep -qxF -- "$short"; then
    echo '{"v": 1, "free": false, "reason": "'"$name"' is running", "at": "'"$at"'"}'
    exit 75
  fi
done
echo '{"v": 1, "free": true, "at": "'"$at"'"}'
