#!/usr/bin/python3 -IB
"""fork-cleaner-install: install, uninstall or check the cleaner kit, as root (fork-kit/cleaner/README.md).

  fork-cleaner-install install --source KIT_FOLDER --sha RELEASE_SHA [--timer | --no-timer]
  fork-cleaner-install uninstall
  fork-cleaner-install self-check

install copies bin/fork-cleaner, sbin/fork-cleaner-install, lib/cleaner/, systemd/, README.md and
fork-kit/common/machine_file.py of one release into /usr/local/libexec/fork-cleaner/versions/<sha>/ (with
MANIFEST.sha256), checks the copy, switches the link `current` to it and links /usr/local/bin/fork-cleaner and
/usr/local/sbin/fork-cleaner-install to it. With --timer it also writes the kit's one timer: the user units
fork-cleaner.service and fork-cleaner.timer in /etc/systemd/user/, which run `fork-cleaner daily` once a day for each
user who enables the timer; --no-timer removes them. The choice is kept in /etc/fork-cleaner/config.json, so a run
without either option keeps it. What `daily` does (compare: plan, report and compare, nothing deleted; run: deletes,
and refuses while an old tool's timer is on) is set in the machine file (cleaner.daily), not here. Safe to run again,
and to stop at any step; one installer at a time.
"""
import argparse, contextlib, ctypes, errno, fcntl, hashlib, json, os, re, shutil, stat, subprocess, sys, tempfile

PREFIX = ''          # tests only: every fixed path below is read under this folder
ROOT_UID = 0         # tests only: who must run the installer and own the installed files

ETC = '/etc/fork-cleaner'
CONFIG = ETC + '/config.json'
INSTALLED = ETC + '/installed.tsv'
LOCK = ETC + '/install.lock'
LIBEXEC = '/usr/local/libexec/fork-cleaner'
VERSIONS = LIBEXEC + '/versions'
CURRENT = LIBEXEC + '/current'
COMMAND = '/usr/local/bin/fork-cleaner'
INSTALLER = '/usr/local/sbin/fork-cleaner-install'
UNIT_DIR = '/etc/systemd/user'
LINKS = {COMMAND: CURRENT + '/bin/fork-cleaner', INSTALLER: CURRENT + '/sbin/fork-cleaner-install'}

MODULES = ('__init__', 'compare', 'compress', 'config', 'daily', 'engine', 'facts', 'guard', 'report', 'rules')
SOURCE_FILES = (('bin/fork-cleaner', 'sbin/fork-cleaner-install', 'README.md', 'common/machine_file.py',
                 'systemd/fork-cleaner.service', 'systemd/fork-cleaner.timer')
                + tuple(f'lib/cleaner/{name}.py' for name in MODULES))
TIMER_UNITS = ('fork-cleaner.service', 'fork-cleaner.timer')
UNIT_HEADER = '# cleaner kit: written by fork-cleaner-install.'
EXECUTABLE = {'bin/fork-cleaner', 'sbin/fork-cleaner-install'}
SHA_RE = re.compile(r'^[0-9a-f]{40}\Z')
STEPS = ('check', 'folders', 'copy', 'self-test', 'config', 'switch', 'links', 'timer-units', 'record')


class Refused(Exception):
    pass


def p(path):
    return PREFIX + path


DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
AT_FDCWD, RENAME_EXCHANGE = -100, 2


def source_base(source, rel):
    """The folder a kit file is read from: common/ is shared by the kits and sits next to them (fork-kit/common);
    a source folder that has its own common/ (a copy) is used as it is."""
    if rel.startswith('common/') and not os.path.lexists(os.path.join(source, rel)):
        return os.path.dirname(os.path.normpath(source))
    return source


def read_source(source, rel):
    """The bytes of one kit file of the source. Below the source folder no link is followed: a link (to a file
    only root may read, say) is refused, never copied, and so is anything that is not a regular file."""
    base, parts = source_base(source, rel), rel.split('/')
    try:
        fd = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError as e:
        raise Refused(f'--source {source}: {e.strerror} (point it at the fork-kit/cleaner folder)') from None
    try:
        for part in parts[:-1]:
            new = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = new
        ffd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=fd)
    except OSError as e:
        if e.errno in (errno.ELOOP, errno.ENOTDIR):
            raise Refused(f'--source {source}: {rel}: a link is on its way or it is not a file (the installer '
                          'copies no links)') from None
        raise Refused(f'--source {source}: {rel}: {e.strerror} (point it at the fork-kit/cleaner folder)') from None
    finally:
        os.close(fd)
    try:
        if not stat.S_ISREG(os.fstat(ffd).st_mode):
            raise Refused(f'--source {source}: {rel} is not a regular file')
        with os.fdopen(ffd, 'rb', closefd=False) as f:
            return f.read()
    finally:
        os.close(ffd)


def say(msg):
    print(f'fork-cleaner-install: {msg}', flush=True)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 16), b''):
            h.update(block)
    return h.hexdigest()


def ensure_dir(path, mode=0o755):
    real = p(path)
    if os.path.lexists(real) and (os.path.islink(real) or not os.path.isdir(real)):
        raise Refused(f'{path} exists and is not a folder: remove it by hand and run again')
    os.makedirs(real, mode=0o755, exist_ok=True)
    os.chmod(real, mode)


def write_file(path, text, mode=0o644):
    """Atomic: a temporary file in the same folder, then renamed over the old one. Unchanged text is not rewritten."""
    real = p(path)
    with contextlib.suppress(OSError):
        with open(real, encoding='utf-8') as f:
            if f.read() == text and stat.S_IMODE(os.lstat(real).st_mode) == mode and not os.path.islink(real):
                return False
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix='.' + os.path.basename(real) + '.', suffix='.tmp')
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, real)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    return True


def switch_link(path, target):
    """Point path at target in one step (a new link renamed over the old one)."""
    real = p(path)
    if os.path.islink(real) and os.readlink(real) == target:
        return
    os.makedirs(os.path.dirname(real), mode=0o755, exist_ok=True)
    tmp = f'{real}.new-link'
    with contextlib.suppress(FileNotFoundError):
        os.unlink(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, real)


def ours(path, target):
    real = p(path)
    return os.path.islink(real) and os.readlink(real) == target


def ours_unit(path):
    """A unit file this kit wrote (its first line says so), and no link."""
    real = p(path)
    if os.path.islink(real):
        return False
    try:
        with open(real, encoding='utf-8') as f:
            return f.readline().startswith(UNIT_HEADER)
    except OSError:
        return False


def unit_paths():
    return [f'{UNIT_DIR}/{name}' for name in TIMER_UNITS]


@contextlib.contextmanager
def install_lock():
    """One installer at a time: a second one is refused while the first runs (it never waits)."""
    ensure_dir(ETC)
    fd = os.open(p(LOCK), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | getattr(os, 'O_CLOEXEC', 0), 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Refused('another fork-cleaner-install is running: wait for it to finish and run again') from None
        yield
    finally:
        os.close(fd)


def read_manifest(folder):
    out = {}
    with open(os.path.join(folder, 'MANIFEST.sha256'), encoding='utf-8') as f:
        for line in f:
            digest, _, rel = line.rstrip('\n').partition('  ')
            out[rel] = digest
    return out


def tree_problems(folder):
    """What differs between a version folder and its manifest, or is not root-owned, or others may write."""
    try:
        want = read_manifest(folder)
    except OSError as e:
        return [f'{folder}: no readable MANIFEST.sha256 ({e.strerror})']
    problems, seen = [], set()
    for dirpath, dirnames, filenames in os.walk(folder):
        for name in dirnames + filenames + ([] if dirpath != folder else ['.']):
            path = os.path.normpath(os.path.join(dirpath, name))
            st = os.lstat(path)
            if st.st_uid != ROOT_UID or st.st_mode & 0o022 or stat.S_ISLNK(st.st_mode):
                problems.append(f'{path}: not root-owned, writable by others, or a link')
        for name in filenames:
            rel = os.path.relpath(os.path.join(dirpath, name), folder)
            if rel == 'MANIFEST.sha256':
                continue
            seen.add(rel)
            if rel not in want:
                problems.append(f'{rel}: not in the manifest')
            elif sha256_file(os.path.join(dirpath, name)) != want[rel]:
                problems.append(f'{rel}: changed since install')
    problems += [f'{rel}: missing' for rel in sorted(set(want) - seen)]
    return problems


def _renameat2():
    """libc's renameat2, or None where there is none."""
    try:
        fn = ctypes.CDLL(None, use_errno=True).renameat2
    except (OSError, AttributeError):
        return None
    fn.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    fn.restype = ctypes.c_int
    return fn


def exchange(new, dest):
    """Puts the folder `new` at `dest` and the old `dest` at `new`, in one step where the kernel and the
    filesystem can (renameat2 RENAME_EXCHANGE): `dest` is never missing. Elsewhere two renames, with a moment in
    which it is (the unit then skips its run: ConditionPathExists)."""
    fn = _renameat2()
    if fn is not None:
        if fn(AT_FDCWD, os.fsencode(new), AT_FDCWD, os.fsencode(dest), RENAME_EXCHANGE) == 0:
            return
        err = ctypes.get_errno()
        if err not in (errno.ENOSYS, errno.EINVAL, errno.ENOTSUP):
            raise OSError(err, os.strerror(err), dest)
    aside = new + '-old'
    os.rename(dest, aside)
    try:
        os.rename(new, dest)
    except BaseException:
        os.rename(aside, dest)          # the old copy back where it was
        raise
    os.rename(aside, new)


def copy_tool(source, sha):
    """versions/<sha>, checked: the copy there when it is whole and unchanged, else a new copy made beside it and
    self-tested first, and only then put in its place in one step. A copy that fails stops here, and the version
    in use is the one it was. Refused when a self-test fails."""
    versions = p(VERSIONS)
    dest = os.path.join(versions, sha)
    if os.path.lexists(dest) and os.path.isdir(dest) and not os.path.islink(dest) and not tree_problems(dest) \
            and set(read_manifest(dest)) == set(SOURCE_FILES):
        problems = self_test(dest)
        if problems:
            raise Refused('the copy failed its self-test (nothing was changed):\n  ' + '\n  '.join(problems))
        return dest
    for name in os.listdir(versions):   # a run that stopped while copying (or an old copy it swapped out)
        if name.startswith('.tmp-'):
            shutil.rmtree(os.path.join(versions, name), ignore_errors=True)
    tmp = tempfile.mkdtemp(prefix=f'.tmp-{sha[:12]}-', dir=versions)
    try:
        lines = []
        for rel in sorted(SOURCE_FILES):
            dst = os.path.join(tmp, rel)
            os.makedirs(os.path.dirname(dst), mode=0o755, exist_ok=True)
            data = read_source(source, rel)
            with open(dst, 'wb') as f:
                f.write(data)
            os.chmod(dst, 0o755 if rel in EXECUTABLE else 0o644)
            lines.append(f'{hashlib.sha256(data).hexdigest()}  {rel}')
        with open(os.path.join(tmp, 'MANIFEST.sha256'), 'w', encoding='utf-8') as f:
            f.write('\n'.join(lines) + '\n')
        os.chmod(os.path.join(tmp, 'MANIFEST.sha256'), 0o644)
        for dirpath, dirnames, _ in os.walk(tmp):
            for name in dirnames:
                os.chmod(os.path.join(dirpath, name), 0o755)
        os.chmod(tmp, 0o755)
        problems = self_test(tmp)
        if problems:
            raise Refused('the new copy failed its self-test (the version in use is unchanged):\n  '
                          + '\n  '.join(problems))
        if not os.path.lexists(dest):
            os.rename(tmp, dest)
            return dest
        say(f'versions/{sha} is incomplete or changed: made again')
        if os.path.islink(dest) or not os.path.isdir(dest):
            os.unlink(dest)
            os.rename(tmp, dest)
            return dest
        exchange(tmp, dest)             # the old copy is now at tmp, removed below
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return dest


def read_config():
    try:
        with open(p(CONFIG), encoding='utf-8') as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        raise Refused(f'{CONFIG} cannot be read ({e}): fix or remove it and run again')
    if not isinstance(data, dict):
        raise Refused(f'{CONFIG} is not a JSON object: fix or remove it and run again')
    return data


def check_old_state():
    """Refuse, before writing anything, what the installer must not overwrite."""
    for path, target in LINKS.items():
        if os.path.lexists(p(path)) and not ours(path, target):
            raise Refused(f'{path} exists and is not the kit\'s link: remove it by hand and run again')
    for path in (ETC, LIBEXEC, VERSIONS):
        real = p(path)
        if os.path.lexists(real) and (os.path.islink(real) or not os.path.isdir(real)):
            raise Refused(f'{path} exists and is not a folder: remove it by hand and run again')
    if os.path.lexists(p(CURRENT)) and not os.path.islink(p(CURRENT)):
        raise Refused(f'{CURRENT} exists and is not a link: remove it by hand and run again')


def check_options(a):
    if not SHA_RE.match(a.sha or ''):
        raise Refused('--sha must be the full 40-character release commit')
    for rel in SOURCE_FILES:
        read_source(os.path.realpath(a.source or ''), rel)


def self_test(dest):
    problems = tree_problems(dest)
    r = subprocess.run([sys.executable, '-I', '-B', os.path.join(dest, 'bin', 'fork-cleaner'), '--help'],
                       capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    if r.returncode != 0 or 'fork-cleaner daily' not in r.stdout:
        problems.append(f'bin/fork-cleaner --help failed: {(r.stderr or r.stdout).strip()[:200]}')
    return problems


def record_rows(sha, timer):
    rows = [(path, 'link', target) for path, target in sorted(LINKS.items())]
    rows.append((CURRENT, 'link', f'{VERSIONS}/{sha}'))
    for rel, digest in sorted(read_manifest(p(f'{VERSIONS}/{sha}')).items()):
        rows.append((f'{VERSIONS}/{sha}/{rel}', 'file', digest))
    rows.append((CONFIG, 'file', sha256_file(p(CONFIG))))
    if timer:
        rows += [(path, 'file', sha256_file(p(path))) for path in unit_paths()]
    return rows


ENABLE = 'systemctl --user daemon-reload && systemctl --user enable --now fork-cleaner.timer'
DISABLE = 'systemctl --user disable --now fork-cleaner.timer'


def install(a, stop_after=None):
    def done(step):
        if step == stop_after:
            raise SystemExit(f'stopped after {step} (test)')

    if os.geteuid() != ROOT_UID:
        raise Refused('run this as root')
    check_options(a)
    check_old_state()
    with install_lock():
        return _install(a, done)


def _install(a, done):
    check_old_state()       # again, now that no other installer runs
    old = read_config()
    timer = a.timer if a.timer is not None else bool(old.get('timer'))
    foreign = [u for u in unit_paths() if os.path.lexists(p(u)) and not ours_unit(u)]
    if timer and foreign:
        raise Refused(f'{foreign[0]} exists and was not written by this kit: remove it and run again, or run with '
                      f'--no-timer to leave it alone')
    done('check')
    for path in (ETC, LIBEXEC, VERSIONS):
        ensure_dir(path)
    done('folders')
    dest = copy_tool(os.path.realpath(a.source), a.sha)     # self-tested before it is used
    done('copy')
    done('self-test')
    write_file(CONFIG, json.dumps({'version': 1, 'timer': timer}, indent=2, sort_keys=True) + '\n')
    done('config')
    switch_link(CURRENT, f'{VERSIONS}/{a.sha}')
    done('switch')
    for path, target in LINKS.items():
        switch_link(path, target)
    done('links')
    # after the links: the timer is only written once the release it runs is the one in use
    for name, path in zip(TIMER_UNITS, unit_paths()):
        if timer:
            if os.path.lexists(p(path)) and not ours_unit(path):
                raise Refused(f'{path} exists and was not written by this kit: remove it and run again, or run '
                              f'with --no-timer to leave it alone')
            ensure_dir(UNIT_DIR)
            with open(os.path.join(dest, 'systemd', name), encoding='utf-8') as f:
                if write_file(path, f.read()):
                    say(f'wrote {path}: each user runs `{ENABLE}`')
        elif ours_unit(path):
            os.unlink(p(path))
            say(f'removed {path} (users run `{DISABLE}`)')
    done('timer-units')
    rows = record_rows(a.sha, timer)
    write_file(INSTALLED, '# path\tkind\twant (written by fork-cleaner-install; read by its self-check)\n'
               + ''.join('\t'.join(r) + '\n' for r in rows))
    done('record')
    say(f'installed release {a.sha}' + (', daily timer units written' if timer else ', no timer'))
    for path, kind, want in rows:
        say(f'  {path}  {kind}  {want}')
    return 0


def uninstall():
    if os.geteuid() != ROOT_UID:
        raise Refused('run this as root')
    with install_lock():                # never from under a running install
        return _uninstall()


def _uninstall():
    for path, target in LINKS.items():
        if ours(path, target):
            os.unlink(p(path))
    for path in unit_paths():
        if ours_unit(path):
            os.unlink(p(path))
            say(f'removed {path} (users run `{DISABLE}`)')
    for path in (LIBEXEC, ETC):
        if os.path.isdir(p(path)) and not os.path.islink(p(path)):
            shutil.rmtree(p(path))
    say('uninstalled (the machine file and what fork-cleaner wrote in each home stay)')
    return 0


def self_check():
    problems = []
    try:
        with open(p(INSTALLED), encoding='utf-8') as f:
            rows = [line.rstrip('\n').split('\t') for line in f if line.strip() and not line.startswith('#')]
    except OSError as e:
        print(f'PROBLEM: cannot read {INSTALLED} ({e.strerror}): not installed?')
        return 1
    for row in rows:
        if len(row) != 3:
            problems.append(f'bad row {row!r}')
            continue
        path, kind, want = row
        try:
            ok = (os.readlink(p(path)) == want) if kind == 'link' else (sha256_file(p(path)) == want)
        except OSError:
            ok = False
        if not ok:
            problems.append(f'{path}: differs from what was installed ({kind})')
    if os.path.islink(p(CURRENT)):
        problems += tree_problems(p(os.readlink(p(CURRENT))))
    for prob in problems:
        print(f'PROBLEM: {prob}')
    print(f'self-check: {len(rows)} installed paths, ' + ('OK' if not problems else f'{len(problems)} problems'))
    return 0 if not problems else 1


def main(argv, stop_after=None):
    ap = argparse.ArgumentParser(prog='fork-cleaner-install', description=__doc__.split('\n\n')[0])
    sub = ap.add_subparsers(dest='cmd', required=True)
    i = sub.add_parser('install')
    i.add_argument('--source', required=True)
    i.add_argument('--sha', required=True)
    i.add_argument('--timer', dest='timer', action='store_true', default=None)
    i.add_argument('--no-timer', dest='timer', action='store_false')
    sub.add_parser('uninstall')
    sub.add_parser('self-check')
    a = ap.parse_args(argv)
    os.umask(0o022)
    try:
        if a.cmd == 'install':
            return install(a, stop_after)
        if a.cmd == 'uninstall':
            return uninstall()
        return self_check()
    except Refused as e:
        print(f'fork-cleaner-install: {e}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
