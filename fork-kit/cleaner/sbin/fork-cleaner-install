#!/usr/bin/python3 -IB
"""fork-cleaner-install: install, uninstall or check the cleaner kit, as root (fork-kit/cleaner/README.md).

  fork-cleaner-install install --source KIT_FOLDER --sha RELEASE_SHA [--timer | --no-timer]
  fork-cleaner-install uninstall
  fork-cleaner-install self-check

install copies bin/fork-cleaner, sbin/fork-cleaner-install, lib/cleaner/, systemd/, README.md and
fork-kit/common/{machine_file,kit_install}.py of one release into /usr/local/libexec/fork-cleaner/versions/<sha>/
(with MANIFEST.sha256), checks the copy, switches the link `current` to it and links /usr/local/bin/fork-cleaner and
/usr/local/sbin/fork-cleaner-install to it. With --timer it also writes the kit's one timer: the user units
fork-cleaner.service and fork-cleaner.timer in /etc/systemd/user/, which run `fork-cleaner daily` once a day for each
user who enables the timer; --no-timer removes them. The choice is kept in /etc/fork-cleaner/config.json, so a run
without either option keeps it. What `daily` does (compare: plan, report and compare, nothing deleted; run: deletes,
and refuses while an old tool's timer is on) is set in the machine file (cleaner.daily), not here. Safe to run again,
and to stop at any step; one installer at a time. The steps every kit shares are in fork-kit/common/kit_install.py.
"""
import os, sys
_kit = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_common = os.path.join(_kit, 'common')
sys.path[:0] = [_common if os.path.isdir(_common) else os.path.join(os.path.dirname(_kit), 'common')]
try:
    import kit_install  # noqa: E402
except ImportError as e:     # a copy an installer from before kit_install.py made: it copied no common/kit_install.py
    sys.exit(f'fork-cleaner-install: cannot load its installer code ({e}): install again with the bootstrap, as root '
             '(fork-kit/cleaner/README.md, Install). An installer from before fork-kit/common/kit_install.py made '
             'this copy without it')

UNIT_DIR = '/etc/systemd/user'
TIMER_UNITS = ('fork-cleaner.service', 'fork-cleaner.timer')
UNIT_HEADER = '# cleaner kit: written by fork-cleaner-install.'
ENABLE = 'systemctl --user daemon-reload && systemctl --user enable --now fork-cleaner.timer'
DISABLE = 'systemctl --user disable --now fork-cleaner.timer'


class CleanerInstaller(kit_install.Installer):
    PROG = 'fork-cleaner-install'
    KIT = 'cleaner'
    ETC = '/etc/fork-cleaner'
    LIBEXEC = '/usr/local/libexec/fork-cleaner'
    LINKS = {'/usr/local/bin/fork-cleaner': 'bin/fork-cleaner',
             '/usr/local/sbin/fork-cleaner-install': 'sbin/fork-cleaner-install'}
    SOURCE_FILES = ('bin/fork-cleaner', 'sbin/fork-cleaner-install', 'README.md', 'common/machine_file.py',
                    'common/kit_install.py', 'systemd/fork-cleaner.service', 'systemd/fork-cleaner.timer')
    EXECUTABLE = frozenset({'bin/fork-cleaner', 'sbin/fork-cleaner-install'})
    PACKAGE = 'cleaner'
    MODULES = ('__init__', 'compare', 'compress', 'config', 'daily', 'dedupe', 'engine', 'facts', 'guard', 'report',
               'rules')
    HELP = ('bin/fork-cleaner', 'fork-cleaner daily')
    HAS_CONFIG = True
    KIT_STEPS = ('timer-units',)

    def add_install_options(self, parser):
        parser.add_argument('--timer', dest='timer', action='store_true', default=None)
        parser.add_argument('--no-timer', dest='timer', action='store_false')

    def unit_paths(self):
        return [f'{UNIT_DIR}/{name}' for name in TIMER_UNITS]

    def ours_unit(self, path):
        """A unit file this kit wrote (its first line says so), and no link."""
        real = self.p(path)
        if os.path.islink(real):
            return False
        try:
            with open(real, encoding='utf-8') as f:
                return f.readline().startswith(UNIT_HEADER)
        except OSError:
            return False

    def plan(self, a):
        timer = a.timer if a.timer is not None else bool(self.read_config().get('timer'))
        foreign = [u for u in self.unit_paths() if os.path.lexists(self.p(u)) and not self.ours_unit(u)]
        if timer and foreign:
            raise self.Refused(f'{foreign[0]} exists and was not written by this kit: remove it and run again, or '
                               'run with --no-timer to leave it alone')
        return {'timer': timer}

    def config(self, a, plan):
        return {'version': 1, 'timer': plan['timer']}

    def kit_step(self, step, a, plan, dest):
        # after the links: the timer is only written once the release it runs is the one in use
        for name, path in zip(TIMER_UNITS, self.unit_paths()):
            if plan['timer']:
                if os.path.lexists(self.p(path)) and not self.ours_unit(path):
                    raise self.Refused(f'{path} exists and was not written by this kit: remove it and run again, '
                                       'or run with --no-timer to leave it alone')
                self.ensure_dir(UNIT_DIR)
                with open(os.path.join(dest, 'systemd', name), encoding='utf-8') as f:
                    if self.write_file(path, f.read()):
                        self.say(f'wrote {path}: each user runs `{ENABLE}`')
            elif self.ours_unit(path):
                os.unlink(self.p(path))
                self.say(f'removed {path} (users run `{DISABLE}`)')

    def kit_rows(self, plan):
        if not plan['timer']:
            return []
        return [(path, 'file', kit_install.sha256_file(self.p(path))) for path in self.unit_paths()]

    def kit_uninstall(self):
        for path in self.unit_paths():
            if self.ours_unit(path):
                os.unlink(self.p(path))
                self.say(f'removed {path} (users run `{DISABLE}`)')

    def installed_summary(self, plan):
        return ', daily timer units written' if plan['timer'] else ', no timer'


INSTALLER = CleanerInstaller()


def main(argv, stop_after=None):
    return INSTALLER.main(argv, stop_after, doc=__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
