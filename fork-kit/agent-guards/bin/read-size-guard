#!/usr/bin/python3 -IB
"""Claude Code PreToolUse hook (Read): refuse a whole-file Read of a big text file. Part of fork-kit/agent-guards
(README.md there: install, settings entry, the machine file's "agent-guards" section).

Why: results over 20,000 characters were 28% of all tool result text, and each stayed in the context, sent again
with every turn, until the next compaction. 2,073 whole-file Reads returned more than 20,000 characters each. Most
needed only a part: `grep -n` finds it, and a Read with offset and limit returns just that.

Refuses a Read with no offset and no limit when the text it would return (its first 2000 lines, as Read returns
them) has more than maxChars characters (default 20000). Characters, not lines: one minified line can be the whole
file. Lets through: a Read with offset or limit (any value), with allow_large, of a file that is not there, not a
regular file, not text (a NUL byte in its start; images, PDFs and notebooks by name), or not readable; a relative path;
and every file of at most maxChars bytes (read by size alone: a fast path, no file read).

Settings (machine file, readSize): enabled (default true), maxChars (20000).
Fail open: a broken settings part, a lib that cannot load, broken input or its own error lets the Read run, with one
line saying so. Exit 2 (refuse) only answers a big whole-file Read. Tests: fork-kit/agent-guards/tests/read-size.test.py
"""
import json, os, stat, sys

NAME = 'read-size-guard'
DEFAULTS = {'enabled': True, 'maxChars': 20000}
READ_LINES = 2000                      # what Read returns with no limit
NOT_TEXT = ('.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.ico', '.tif', '.tiff', '.pdf', '.ipynb')
COUNT_LINES_UP_TO = 16 * 1024 * 1024   # bytes: count every line of a file up to this size, else give its size


def _settings():
    """(readSize settings, problem or None). A problem means the guard lets every call through."""
    try:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))
        from agent_guards import config
        return config.load('readSize')
    except BaseException as e:   # noqa: BLE001 - fail open
        return dict(DEFAULTS), f'cannot load the kit\'s config code ({type(e).__name__}: {e})'


def measure(path, max_chars):
    """None (let it through) or (characters Read would return, the file's size text)."""
    if not isinstance(path, str) or not os.path.isabs(path) or path.lower().endswith(NOT_TEXT):
        return None
    try:
        st = os.stat(path)
    except (OSError, ValueError):
        return None
    if not stat.S_ISREG(st.st_mode) or (st.st_size and st.st_size <= max_chars):
        return None
    try:
        with open(path, 'rb') as f:
            head = f.read(max_chars * 4 + 4)    # a UTF-8 character is at most 4 bytes
            if b'\0' in head[:8192]:
                return None
            lines = head.split(b'\n')[:READ_LINES]
            chars = len(b'\n'.join(lines).decode('utf-8', errors='replace'))
            if chars <= max_chars:
                return None
            cut = len(head) > max_chars * 4 and len(lines) < READ_LINES   # only the start was read
            if st.st_size <= COUNT_LINES_UP_TO:
                f.seek(0)
                n = f.read().count(b'\n')
                size = f'{n} lines, {st.st_size} bytes'
            else:
                size = f'{st.st_size // (1024 * 1024)} MB'
    except OSError:
        return None
    return (f'at least {chars}' if cut else str(chars)), size


def reason(path, shown, size, max_chars):
    return (f'Refused by {NAME}: a Read of all of {path} ({size}) returns {shown} characters, more than '
            f'{max_chars}, and it stays in the context until the next compaction. Find the part you need with '
            f'`grep -n PATTERN {path}` (or `sed -n 1,80p`), then Read only that range with offset and limit. A Read '
            'with offset or limit is not refused; when you really need the whole file (a full rewrite, a brief '
            'that asks for it), Read it again with allow_large: true.')


def _first(text, event):
    """True when this session has not had this notice yet (the kit's lib; a lib that cannot load: always)."""
    try:
        from agent_guards import config
        return config.first_notice(text, event)
    except BaseException:   # noqa: BLE001
        return True


def _problem_out(problem, event):
    text = (f'{NAME}: the machine file\'s "agent-guards" section cannot be used as written ({problem}); built-in '
            f'defaults used for that part, and {NAME} lets every Read through until it is fixed. Tell the owner; '
            '`agent-guards self-check` names every problem.')
    try:
        sys.stderr.write(text + '\n')
    except Exception:  # noqa: BLE001
        pass
    if not _first(text, event):
        return
    out = {'systemMessage': text}
    if isinstance(event, dict) and event.get('hook_event_name') == 'PreToolUse':
        out['hookSpecificOutput'] = {'hookEventName': 'PreToolUse', 'additionalContext': text}
    print(json.dumps(out))


def main(argv=None):
    """Exit 2 with the reason on stderr refuses; 0 lets the Read run; 1 (this guard failed) lets it run, loudly."""
    argv = sys.argv[1:] if argv is None else argv
    if argv:
        sys.stderr.write(f'usage: {NAME} (hook: PreToolUse JSON on stdin; its settings entry: `agent-guards hooks`)\n')
        return 1
    try:
        settings, problem = _settings()
        event = json.loads(sys.stdin.read())
        if problem:
            _problem_out(problem, event)
            return 0
        if not settings['enabled'] or not isinstance(event, dict) or event.get('tool_name') != 'Read':
            return 0
        ti = event.get('tool_input') or {}
        if not isinstance(ti, dict) or any(ti.get(k) is not None and ti.get(k) is not False
                                           for k in ('offset', 'limit', 'allow_large', 'pages')):
            return 0
        path = ti.get('file_path')
        found = measure(path, settings['maxChars'])
    except BaseException as e:   # noqa: BLE001 - fail open
        sys.stderr.write(f'{NAME}: failed ({type(e).__name__}: {e}); the Read is NOT checked and runs. '
                         'Tell the owner if this repeats.\n')
        return 1
    if not found:
        return 0
    sys.stderr.write(reason(path, found[0], found[1], settings['maxChars']) + '\n')
    return 2


if __name__ == '__main__':
    sys.exit(main())
