#!/usr/bin/python3 -IB
"""fork-ci-why: why a pull request's required checks fail: each failing check's job link and only its error lines.
`fork-ci-why --help` for the usage (lib/agent_guards/kitcmds.py; COMMANDS.md). Tests: fork-kit/agent-guards/tests/kitcmds.test.py
"""
import os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))

if __name__ == '__main__':
    from agent_guards import kitcmds
    try:
        sys.exit(kitcmds.ci_why(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
