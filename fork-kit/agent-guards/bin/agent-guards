#!/usr/bin/python3 -IB
"""agent-guards: the command of the agent-guards kit (fork-kit/agent-guards/README.md).

  agent-guards self-check              the machine file's "agent-guards" section, the hook files, the managed
                                       settings drop-in (exit 1 on a problem)
  agent-guards check [--settings F]    run each hook wired in F (default: the managed settings drop-in) with one
                                       case it must refuse and one it must pass (exit 1 on a problem). As root,
                                       F must be root's and only root may write it (its commands are run)
  agent-guards hooks [--bin DIR]       print the "hooks" settings of every hook of the kit, for a settings file
  agent-guards approve [--hours N] [--cwd DIR] --command 'CMD'
                                       as root: approve ONE command that actions-disable-guard refuses, run in
                                       DIR (default: this folder), once, within N hours (default 1, at most 24);
                                       prints the code the command must end with
  agent-guards approve --revoke        as root: end the approval now
"""
import argparse, grp, json, os, pwd, subprocess, sys

_kit = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_kit, 'lib'))

PROG = 'agent-guards'
ROOT_UID = 0   # tests only


def root_ways(user):
    """How `user` can become root without the owner (sudo without a password, the docker group): one text each.
    The approval file and the managed settings are root's; such a user can write them."""
    out = []
    try:
        pw = pwd.getpwnam(user)
        docker = grp.getgrnam('docker')
        if user in docker.gr_mem or pw.pw_gid == docker.gr_gid:
            out.append(f'{user} is in the docker group (a container can write any root file)')
    except KeyError:
        pass
    try:
        if os.geteuid() == ROOT_UID:
            r = subprocess.run(['sudo', '-n', '-l', '-U', user], capture_output=True, text=True, timeout=10)
            if 'NOPASSWD' in r.stdout:
                out.append(f'{user} may run sudo without a password (NOPASSWD)')
        else:
            r = subprocess.run(['sudo', '-n', 'true'], capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                out.append(f'{user} can run sudo now without typing a password')
    except (OSError, subprocess.SubprocessError):
        pass
    return out


def leak_notes(path, notes, repos=()):
    """leak-guard's pattern file: there or not, usable, out of every checkout, not writable by the agents. Its
    problems (the notes are added to `notes`); never a pattern."""
    from agent_guards import leak
    pats = leak.load(path)
    if not pats.present:
        notes.append(f'leak-guard: no pattern file at {path}: posts and pushes are NOT checked for personal details '
                     '(README: Leak guard)')
        return []
    if pats.problem:
        return [f'leak-guard: {pats.problem} ({path}): every post and push is refused until it is fixed']
    out = []
    repo = leak.in_checkout(path)
    if repo:
        out.append(f'leak-guard: the pattern file {path} is inside the git checkout {repo}: move it out, it must '
                   'never be committed')
    if os.access(path, os.W_OK) and os.geteuid() != 0:
        notes.append(f'WARNING: leak-guard: this user can change the pattern file {path} (an agent could weaken it)')
    if not pats.rows:
        notes.append(f'WARNING: leak-guard: the pattern file {path} holds no pattern (only empty lines or comments): '
                     'posts and pushes are NOT checked')
    else:
        notes.append(f'leak-guard: {len(pats.rows)} pattern(s) in {path}')
    notes.append('leak-guard: ' + (f'posts and pushes to {", ".join(repos)} are checked (leakGuard.repos)' if repos
                                   else 'posts and pushes to every repo are checked (leakGuard.repos is empty)'))
    return out


def self_check(bin_dir, drop_in, links_dir=None):
    from agent_guards import approval, config, wiring
    links_dir = links_dir or wiring.BIN
    problems, notes = [], []
    settings, cfg_problems = config.load_all()
    problems += [f'machine file: {p}' for p in cfg_problems]
    for hook in wiring.HOOKS:
        if not os.access(os.path.join(bin_dir, hook), os.R_OK):
            problems.append(f'{os.path.join(bin_dir, hook)} is missing or cannot be read')
    wired = False
    try:
        with open(drop_in, encoding='utf-8') as f:
            text = f.read()
        data = json.loads(text)
        if not isinstance(data, dict) or set(data) - {'hooks', 'env'} or data.get('hooks') != wiring.hooks() \
                or ('env' in data and not wiring.env_ok(data['env'])):
            problems.append(f'{drop_in} is not the kit\'s drop-in of this release: run the installer again '
                            '(agent-guards-install install ... --settings)')
        else:
            wired = True
            notes.append(f'{drop_in}: every hook is wired in managed settings')
            have = data.get('env', {})
            notes.append('managed settings env: ' + (' '.join(f'{k}={v}' for k, v in have.items()) or 'none'))
            section, _ = config._section()          # a broken file: the defaults, as the installer writes them
            want = wiring.env_for(config.harness_env(section or {})[0], drop_in)[0]
            for k in sorted(set(have) | set(want)):
                if have.get(k) != want.get(k):
                    problems.append(f'{drop_in}: {k} is {have.get(k, "not set")} in the drop-in, the machine file '
                                    f'gives {want.get(k, "not set")}: run the installer again (the drop-in\'s env is '
                                    'written at install)')
    except FileNotFoundError:
        notes.append(f'{drop_in} is not there: the hooks are not in managed settings (installer --settings, or '
                     'by hand from `agent-guards hooks`)')
    except (OSError, ValueError) as e:
        problems.append(f'{drop_in} cannot be read ({e})')
    for hook in wiring.HOOKS:   # what the settings entries run: the links, not this version folder
        link = os.path.join(links_dir, hook)
        if os.path.realpath(link) != os.path.realpath(os.path.join(bin_dir, hook)):
            (problems if wired else notes).append(
                f'{link} is not this kit\'s {hook} ({os.path.realpath(link) if os.path.lexists(link) else "missing"})')
    data, why = approval.read()
    if data is not None:
        import time
        left = data['until'] - time.time()
        notes.append(f'an owner approval for actions-disable-guard is open for {int(left // 60)} more minutes '
                     f'(one command, run once in {data["cwd"]})'
                     if left > 0 else 'an owner approval file is there, its time is over')
    user = os.environ.get('SUDO_USER') or pwd.getpwuid(os.getuid()).pw_name
    if user == 'root':
        notes.append('run the self-check as the agents\' user, or through sudo, to see whether that user can become '
                     'root without the owner')
    for way in root_ways(user) if user != 'root' else ():
        notes.append(f'WARNING: {way}: an agent of that user can become root, and then write the managed settings, '
                     'the machine file and the approval file; the hooks do not hold against it')
    problems += leak_notes(settings['leakGuard']['patternsFile'], notes, settings['leakGuard']['repos'])
    for hook, s in settings.items():
        notes.append(f'{hook}: {json.dumps(s, sort_keys=True)}')
    for n in notes:
        print(f'note: {n}')
    for p in problems:
        print(f'PROBLEM: {p}')
    print(f'{PROG} self-check: ' + ('OK' if not problems else f'{len(problems)} problem(s)'))
    return 0 if not problems else 1


def main(argv):
    if argv in (['-h'], ['--help']):
        print(__doc__.strip())
        return 0
    from agent_guards import check, wiring
    ap = argparse.ArgumentParser(prog=PROG)
    sub = ap.add_subparsers(dest='cmd', required=True)
    sub.add_parser('self-check')
    c = sub.add_parser('check')
    c.add_argument('--settings', default=wiring.DROP_IN)
    h = sub.add_parser('hooks')
    h.add_argument('--bin', default=wiring.BIN)
    p = sub.add_parser('approve')
    p.add_argument('--hours', type=float, default=1.0)
    p.add_argument('--revoke', action='store_true')
    p.add_argument('--command', help='the one command approved (exactly; blanks may differ)')
    p.add_argument('--cwd', help='the folder it runs in (default: this one)')
    a = ap.parse_args(argv)
    if a.cmd == 'self-check':
        return self_check(os.path.dirname(os.path.realpath(__file__)), wiring.DROP_IN)
    if a.cmd == 'hooks':
        print(json.dumps({'hooks': wiring.hooks(a.bin)}, indent=2))
        return 0
    if a.cmd == 'approve':
        return approve(a)
    try:
        settings = json.loads(read_settings(a.settings))
    except (OSError, ValueError) as e:
        print(f'{PROG}: cannot read {a.settings} ({e})', file=sys.stderr)
        return 1
    return check.run(settings, a.settings)


def read_settings(path):
    """The text of a settings file whose commands `check` runs. As root only a file root owns, that only root can
    write, in folders only root can write (else anyone who can write it runs commands as root)."""
    if os.geteuid() != ROOT_UID:
        with open(path, encoding='utf-8') as f:
            return f.read()
    from agent_guards import approval   # noqa: F401 - puts fork-kit/common on the path
    import machine_file
    try:
        return machine_file.read_protected_text(os.path.abspath(path), ROOT_UID)
    except machine_file.MachineFileError as e:
        raise OSError(f'not safe to run as root: {e}') from None


def approve(a):
    from agent_guards import approval
    if os.geteuid() != ROOT_UID:
        print(f'{PROG} approve: run this as root (sudo {PROG} approve): only root can write the approval',
              file=sys.stderr)
        return 1
    if a.revoke:
        print(f'{PROG}: approval removed' if approval.revoke() else f'{PROG}: there was no approval')
        return 0
    if not 0 < a.hours <= approval.MAX_HOURS:
        print(f'{PROG} approve: --hours must be above 0 and at most {approval.MAX_HOURS}', file=sys.stderr)
        return 1
    if not a.command or not approval.normalise(a.command):
        print(f'{PROG} approve: name the one command you approve: --command \'<the exact command>\' (the approval '
              'passes that command only, once)', file=sys.stderr)
        return 1
    cwd = os.path.realpath(a.cwd or os.getcwd())
    code = approval.new_code()
    try:
        data = approval.write(code, a.hours, a.command, cwd)
    except (OSError, ValueError) as e:
        print(f'{PROG} approve: cannot write {approval.PATH} ({e})', file=sys.stderr)
        return 1
    import time
    until = time.strftime('%Y-%m-%d %H:%M UTC', time.gmtime(data['until']))
    print(f'Approved, once, until {until}: this command, run in {cwd}:\n'
          f'  {approval.normalise(a.command)}\n'
          f'Give the agent this marker; the command passes actions-disable-guard with it at its end:\n'
          f'  {approval.MARK}{code}\n'
          f'Any other command, or a second run, is refused. End it early with `sudo {PROG} approve --revoke`.')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
