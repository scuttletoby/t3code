#!/usr/bin/python3 -IB
"""Claude Code PreToolUse hook (Bash, Monitor): refuse a command that pipes the output of a capacity check.
Part of fork-kit/agent-guards (README.md there: install, settings entry, the machine file's "agent-guards" section).

The checks are the commands in the machine file's capacityPipe.commands (default ["t3-capacity"]): a tool that
answers OK (exit 0) or NOT OK (exit 1) before a heavy step. Why: agents ran `t3-capacity 2048 | tail -1 && <heavy
step>`. A pipeline's exit status is its LAST command's, so NOT OK (exit 1) was lost and the heavy step ran on a full
machine. A line in the agents' briefs did not stop it.

Rule: EVERY pipe (`|`, `|&`) out of such a command is refused, also one that decides nothing (`t3-capacity | cat`)
and one under `set -o pipefail`: nothing needs the pipe, and "is the status used" cannot be read from the text
reliably. Passes: `t3-capacity N && cmd`, `t3-capacity`, `t3-capacity; echo $?`, `if t3-capacity N; then ..`,
`t3-capacity N > file && cmd`, `out=$(t3-capacity N) && cmd`, `t3-capacity N || ..`, and a group that gates inside
and is piped as a whole (`{ t3-capacity N && cmd; } | tail`).

How it reads a command (small on purpose; actions-disable-guard is the full shell reader, and what it guards is an
attack, this is a mistake):
  - shell text as a shell reads it: quotes, backslashes, comments, redirections, `&& || ; & |` and newlines;
  - the check must be the command word (any path; after NAME=value, `!`, if/while/until/then/do/else, and the
    wrappers sudo, env, command, exec, nohup, nice, ionice, timeout, stdbuf, setsid, time, builtin, chrt, taskset,
    flock, numactl, doas, runuser, systemd-run, unbuffer, chronic and the kit's heavy with their flags (and the
    priority, CPU mask or lock file the first three take before the command; heavy's --wait, --kind, --mb, --measure),
    read letter by letter so a glued value is a value (`sudo -uroot`, `sudo -iu someone`); `env -S 'TEXT'` and
    `--split-string` run the words of TEXT, which are read as the command; the keyword `time [-p]` before a group);
  - commands inside `$(..)`, backticks, `<(..)`, and a `( .. )` or `{ ..; }` group whose LAST command is the check;
  - shell text handed on, read again by the same rules: `bash -c '..'` (sh, zsh, dash, ksh, su, runuser; also behind
    another word: `heavy bash -c`, `timeout 60 bash -lc`; su and runuser also glued `-c'..'`, `-lc'..'`,
    `--command[=]..` and `--session-command[=]..`), `eval ..`, `ssh host '..'`, `watch '..'`, and a heredoc into
    a shell.
Text that only mentions it passes: echo, grep, commit messages, a heredoc into cat/tee/a file (briefs), comments.

Not covered (the check's own stderr line is the second layer when it has one: say "NOT OK .. never pipe it" on
stderr whenever it answers NOT OK into a pipe or a file): a command kept in a variable (`$C | tail`), a script file,
`sh t3-capacity`, a heredoc piped into a shell (`cat <<EOF | bash`), `$(..)` inside `${..}` or inside an unquoted
heredoc into a non-shell, xargs / find -exec, a wrapper's long flag with its value as the next word
(`sudo --user someone`), `flock FILE -c TEXT`, text more than 40 levels deep. Tools other than Bash and
Monitor are not read.

Fail open: on its own failure (broken input, a bug) it writes one line to stderr and exits 1, which Claude Code
treats as "hook failed, run the command". Exit 2 (refuse) is only ever the answer to a pipe it found. The settings
entry (`agent-guards hooks`) also exits 1 with a line on stderr when this file is missing (a bare `python3 <missing>`
would exit 2 and refuse every Bash call). A broken machine file section: the default command list, one line on
stderr. Tests: fork-kit/agent-guards/tests/capacity-pipe.test.py
"""
import json, os, re, shlex, sys


def _settings():
    """(capacityPipe settings, problem or None); a copy without the kit's lib keeps the defaults and says so."""
    try:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))
        from agent_guards import config
        return config.load('capacityPipe')
    except BaseException as e:   # noqa: BLE001 - the guard works without its config
        return {'commands': ['t3-capacity']}, f'cannot load the kit\'s config code ({type(e).__name__}: {e})'


SETTINGS, SETTINGS_PROBLEM = _settings()
CHECKS = tuple(SETTINGS['commands'])   # the capacity checks whose output must not be piped
NAME = 'capacity-pipe-guard'
HID = '\x00'   # text the guard cannot know ($X, ${..}, the output of $(..)), as part of a word
MAX_DEPTH = 40
SHELLS = {'sh', 'bash', 'zsh', 'dash', 'ksh', 'su', 'runuser'}   # `<shell> .. -c TEXT`; a heredoc into one is commands
TEXT_ARGS = {'ssh', 'watch'}                           # each argument that names the tool is shell text
TOOLS = {'Bash', 'Monitor'}                            # the tools whose `command` is shell text
WRAPPERS = {   # a command follows them; value: their one-letter flags that take a value (glued or the next word)
    'sudo': 'ughpCDRTUrt', 'env': 'uCS', 'timeout': 'ks', 'nice': 'n', 'ionice': 'cnp', 'stdbuf': 'ioe', 'exec': 'a',
    'time': 'fo', 'command': '', 'builtin': '', 'nohup': '', 'setsid': '', 'chrt': 'TPD', 'taskset': '',
    'flock': 'wEc', 'numactl': 'CNmpiu', 'doas': 'uCa', 'runuser': 'ugGwsc', 'systemd-run': 'puEMH', 'unbuffer': '',
    'chronic': '', 'heavy': ''}
LONG_VALUES = {'heavy': {'--wait', '--kind', '--mb', '--measure'}}   # long flags whose value is the next word
POSITIONAL = {'chrt': 1, 'taskset': 1, 'flock': 1}   # words they take before the command: priority, mask, lock file
KEYWORDS = {'!', '{', 'if', 'then', 'elif', 'else', 'while', 'until', 'do'}   # a command follows them
OPENERS = {'{', 'if', 'while', 'until'}        # ... and these open a group that CLOSERS end
HEADS = {'for', 'case', 'select'}              # open a group too; the rest of their line is no command
CLOSERS = {'}', 'fi', 'done', 'esac'}
ASSIGN = re.compile(r'[A-Za-z_]\w*\+?=')
PLAIN = re.compile(r'-|\d+(\.\d+)?[smhd]?$')   # a wrapper's flag, or its number / duration (timeout 5m, nice 10)
C_FLAG = re.compile(r'-[A-Za-z]*c[A-Za-z]*$')  # -c, -lc, -ec
GETOPT_SHELLS = {'su': 'gGsw', 'runuser': 'ugGsw'}   # read their flags like getopt; value: letters taking a value
REDIR = re.compile(r'&>>|&>|<<<|<<-|<<|<>|<&|>>|>&|>\||<|>')
VAR = re.compile(r'\$(?:[A-Za-z_]\w*|[0-9@*#?$!-])')


def reason(tool):
    return (f'Refused by {NAME}: this command pipes the output of {tool} (`{tool} N | ...`). A pipeline has the exit '
            f'status of its LAST command, so NOT OK (exit 1) is lost and the step after `&&` runs on a full machine. '
            f'Every pipe out of {tool} is refused, also a harmless one: nothing needs it. Gate with '
            f'`{tool} N && <cmd>` (or `if {tool} N; then ..`, `{tool} N; echo $?`). For less output: '
            f'`{tool} N > "$f" && <cmd>` or `out=$({tool} N) && <cmd>`. Text that only mentions such a command '
            f'(echo, grep, a commit message, a heredoc into a file) is not refused.')


REASON = reason(CHECKS[0])


class Piped(Exception):
    """The command pipes a check's output (args[0]: the check)."""


def base(word):
    return word.rsplit('/', 1)[-1]


def split_string(text):
    """The words of `env -S TEXT`: env splits TEXT itself, with shell-like quotes (shlex), else at blanks."""
    try:
        return shlex.split(text)
    except ValueError:
        return text.split()


def command_at(ws):
    """(words, index of the command word) of a simple command: behind NAME=value and wrappers; index len(words) when
    there is none. words is ws, or ws with an `env -S TEXT` value split into the words env runs."""
    i, splits = 0, 0
    while i < len(ws):
        if ASSIGN.match(ws[i]):
            i += 1
            continue
        if base(ws[i]) not in WRAPPERS:
            return ws, i
        name = base(ws[i])
        asks, values, left = name == 'command', WRAPPERS[name], POSITIONAL.get(name, 0)
        i += 1
        while i < len(ws) and (PLAIN.match(ws[i]) or ASSIGN.match(ws[i]) or left):
            w = ws[i]
            if left and not w.startswith('-'):   # chrt 10 / taskset 0x3 / flock FILE, then the command
                left, i = left - 1, i + 1
                continue
            if asks and w in ('-v', '-V'):
                return ws, len(ws)   # `command -v x` only looks x up
            split = None   # env -S TEXT / --split-string TEXT: the words env runs are the words of TEXT
            step = 1
            if w.startswith('--'):   # a long flag with its value as the next word: only those in LONG_VALUES
                if w in LONG_VALUES.get(name, ()):   # (else see "Not covered")
                    step = 2
                elif name == 'env' and (w == '--split-string' or w.startswith('--split-string=')):
                    split = ((w.partition('=')[2], ws[i + 1:]) if '=' in w else
                             (ws[i + 1] if i + 1 < len(ws) else '', ws[i + 2:]))
            elif len(w) > 1 and w[0] == '-':
                for j, ch in enumerate(w[1:], 1):   # letters left to right: the first one that takes a value takes the
                    if ch in values:                # rest of the word (-uroot, -n10), else the next word (-iu someone)
                        glued = w[j + 1:]
                        if name == 'env' and ch == 'S':
                            split = (glued, ws[i + 1:]) if glued else (ws[i + 1] if i + 1 < len(ws) else '', ws[i + 2:])
                        step = 1 if glued else 2
                        break
                    if not ch.isalpha():
                        break
            if split and splits < MAX_DEPTH:
                ws, splits = ws[:i] + split_string(split[0]) + split[1], splits + 1
                continue
            i += step
    return ws, len(ws)


def shell_text(shell, w, rest):
    """The shell text the word w (and the words behind it, rest) hands to shell, or None. `-c TEXT` and a cluster
    (-lc, -ec); su and runuser read their options as getopt does, so also a glued `-cTEXT` / `-lcTEXT` (a letter that
    takes a value before the c ends the cluster: `-uc` is user c), `--command[=]TEXT`, `--session-command[=]TEXT`
    and any unambiguous start of those (`--co=`, `--se`)."""
    if shell not in GETOPT_SHELLS:
        return (rest[0] if rest else None) if C_FLAG.match(w) else None
    if w.startswith('--'):
        name, eq, value = w[2:].partition('=')
        if name and ('command'.startswith(name) or len(name) > 1 and 'session-command'.startswith(name)):
            return value if eq else (rest[0] if rest else None)
        return None
    if len(w) < 2 or w[0] != '-':
        return None
    for j, ch in enumerate(w[1:], 1):
        if ch == 'c':
            return w[j + 1:] or (rest[0] if rest else None)
        if ch in GETOPT_SHELLS[shell] or not ch.isalpha():
            return None
    return None


GETOPT_LONG = ('shell', 'group', 'supp-group', 'whitelist-environment', 'user')   # su/runuser long flags with a value


def takes_value(shell, w):
    """Whether the flag word w of su/runuser takes the next word as its value: -s, -g, -G, -w (runuser -u) alone or
    last in a cluster (-ls), --shell and any start of the long flags that take one."""
    if shell not in GETOPT_SHELLS or not w.startswith('-') or w == '-':
        return False
    if w.startswith('--'):
        name, eq, _ = w[2:].partition('=')
        return not eq and len(name) > 1 and any(f.startswith(name) for f in GETOPT_LONG)
    for j, ch in enumerate(w[1:], 1):
        if ch in GETOPT_SHELLS[shell]:
            return j == len(w) - 1
    return False


def handed_on(ws, depth):
    """Read the shell text a simple command hands on. True when a shell is among its words (its heredoc is commands)."""
    ws, k = command_at(ws)   # first: env -S TEXT puts the words of TEXT in place
    shell, skip = None, False
    for n, w in enumerate(ws):
        if skip:   # su -s /bin/sh -c ..: the value of a flag is no shell of its own
            skip = False
        elif base(w) in SHELLS and not w.startswith('-'):   # -ls/bin/sh is a flag cluster, not sh
            shell = base(w)
        elif shell:
            text = shell_text(shell, w, ws[n + 1:])
            if text is not None:
                read(text, depth=depth + 1)
                break
            skip = takes_value(shell, w)
    if k < len(ws):
        word, args = base(ws[k]), ws[k + 1:]
        if word == 'eval':
            read(' '.join(args), depth=depth + 1)
        elif word in TEXT_ARGS:
            for a in args:
                if any(t in a for t in CHECKS):
                    read(a, depth=depth + 1)
    return bool(shell)


def dollar(s, i, out, depth):
    """s[i] is `$` or a backtick: commands inside are read, the value is hidden. Returns the index behind it."""
    n = len(s)
    if s[i] == '`':
        j, buf = i + 1, []
        while j < n and s[j] != '`':
            if s[j] == '\\' and s[j + 1:j + 2] in ('`', '\\', '$'):
                j += 1
            buf.append(s[j])
            j += 1
        read(''.join(buf), depth=depth + 1)
        out.append(HID)
        return j + 1
    nxt = s[i + 1:i + 2]
    if nxt == '(':
        out.append(HID)
        return read(s, i + 2, ')', depth + 1)
    if nxt == '{':
        j, open_ = i + 2, 1
        while j < n and open_:
            open_ += (s[j] == '{') - (s[j] == '}')
            j += 2 if s[j] == '\\' else 1
        out.append(HID)
        return j
    m = VAR.match(s, i)
    out.append(HID if m else '$')
    return m.end() if m else i + 1


def word(s, i, depth):
    """One word from s[i:], as the shell would hand it on (quotes gone): (text, index behind it)."""
    n, out = len(s), []
    while i < n and s[i] not in ' \t\n;&|()<>':
        c = s[i]
        if c == '\\':
            if s[i + 1:i + 2] != '\n':
                out.append(s[i + 1:i + 2])
            i += 2
        elif c == "'":
            j = s.find("'", i + 1)
            j = n if j < 0 else j
            out.append(s[i + 1:j])
            i = j + 1
        elif c == '$' and s[i + 1:i + 2] == "'":
            j = i + 2
            while j < n and s[j] != "'":
                j += 1 if s[j] == '\\' else 0
                out.append(s[j:j + 1])
                j += 1
            i = j + 1
        elif c == '"':
            i += 1
            while i < n and s[i] != '"':
                if s[i] == '\\' and i + 1 < n:
                    if s[i + 1] != '\n':
                        out.append(s[i + 1] if s[i + 1] in '"\\$`' else s[i:i + 2])
                    i += 2
                elif s[i] in '$`':
                    i = dollar(s, i, out, depth)
                else:
                    out.append(s[i])
                    i += 1
            i += 1
        elif c in '$`':
            i = dollar(s, i, out, depth)
        else:
            out.append(c)
            i += 1
    return ''.join(out), i


def heredoc(s, i, delim, tabs):
    """(body, index behind it) of the heredoc that starts at s[i:]."""
    lines = []
    while i < len(s):
        j = s.find('\n', i)
        j = len(s) if j < 0 else j
        line, i = s[i:j], j + 1
        if (line.lstrip('\t') if tabs else line) == delim:
            break
        lines.append(line)
    return '\n'.join(lines), min(i, len(s))


def read(s, i=0, closer='', depth=0):
    """Read the commands in s[i:], to the `)` that ends this $(..) (closer) or to the end; raise Piped where
    a check's output goes into a pipe. Returns the index it stopped at."""
    n = len(s)
    if depth > MAX_DEPTH or (i == 0 and not any(t in s for t in CHECKS)):   # i == 0: once per text, not once per $(..) in it
        return n   # nothing (more) to find; past MAX_DEPTH the rest is not read
    ws, doc, groups, pending = [], {}, [], []
    tool = False   # the command or group that just ended is a check (its last command is): its name

    def end():
        nonlocal ws, doc, tool
        cmd, ws, mine, doc = ws, [], doc, {}
        while cmd and (cmd[0] in KEYWORDS or cmd[0] in ('function', 'time')):
            if cmd[0] == 'time':   # the keyword `time [-p] [--]` times what follows, also `{ ..; }` and `if ..`
                j = 1
                while j < len(cmd) and cmd[j] in ('-p', '--'):
                    j += 1
                if j == len(cmd) or cmd[j] not in KEYWORDS:
                    break   # `time cmd`: a wrapper (command_at)
                cmd = cmd[j:]
                continue
            if cmd[0] in OPENERS:
                groups.append(cmd[0])
            cmd = cmd[2:] if cmd[0] == 'function' else cmd[1:]   # `function NAME { ..`: the rest is a command
        if not cmd:
            return
        if cmd[0] in HEADS:
            groups.append(cmd[0])
            tool = False
        elif cmd[0] in CLOSERS:
            if groups and groups[-1] != '(':
                groups.pop()   # tool stays: the group ends with what its last command was
        else:
            cmd, k = command_at(cmd)
            tool = base(cmd[k]) if k < len(cmd) and base(cmd[k]) in CHECKS else False
            mine['shell'] = handed_on(cmd, depth)

    while i < n:
        c = s[i]
        if c in ' \t':
            i += 1
        elif c == '\\' and s[i + 1:i + 2] == '\n':
            i += 2
        elif c == '#':
            j = s.find('\n', i)
            i = n if j < 0 else j
        elif c == '\n':
            end()
            i += 1
            for delim, tabs, owner in pending:
                body, i = heredoc(s, i, delim, tabs)
                if owner.get('shell'):
                    read(body, depth=depth + 1)
            pending = []
        elif c == ';':
            end()
            i += 1
        elif c == '(':
            end()
            groups.append('(')
            tool = False
            i += 1
        elif c == ')':
            end()
            i += 1
            if groups and groups[-1] == 'case':
                tool = False   # the `)` of a case pattern
            elif groups and groups[-1] == '(':
                groups.pop()   # tool stays, as for `}`
            elif closer:
                return i
            else:
                tool = False
        elif c == '|':
            end()
            if s.startswith('||', i):
                i += 2
            elif tool:
                raise Piped(tool)
            else:
                i += 2 if s.startswith('|&', i) else 1
            tool = False
        elif c == '&' and not s.startswith('&>', i):
            end()
            tool = False
            i += 2 if s.startswith('&&', i) else 1
        elif c in '<>&':
            op = REDIR.match(s, i).group()
            i += len(op)
            if op in ('<', '>') and s[i:i + 1] == '(':
                i = read(s, i + 1, ')', depth + 1)   # <(..) and >(..) are commands
                continue
            while i < n and s[i] in ' \t':
                i += 1
            target, i = word(s, i, depth)
            if op in ('<<', '<<-'):
                pending.append((target, op == '<<-', doc))
        else:
            text, j = word(s, i, depth)
            if not (text.isdigit() and s[j:j + 1] in ('<', '>')):   # the 2 of 2>&1 is no word
                ws.append(text)
            i = max(j, i + 1)
    end()
    return n


def piped(command):
    """The check whose output this Bash command pipes, or None."""
    try:
        read(command)
    except Piped as e:
        return e.args[0]
    return None


def main(argv=None):
    """Exit 2 with the reason on stderr refuses; 0 lets the command run; 1 (this guard failed) lets it run, loudly."""
    argv = sys.argv[1:] if argv is None else argv
    if argv:
        sys.stderr.write(f'usage: {NAME} (hook: PreToolUse JSON on stdin; its settings entry: `agent-guards hooks`)\n')
        return 1
    event = None
    try:
        event = json.loads(sys.stdin.read())
        tool = None
        if event.get('tool_name') in TOOLS:
            command = (event.get('tool_input') or {}).get('command')
            tool = piped(command) if isinstance(command, str) else None
        if not tool:
            _say_problem(event)
            return 0
    except BaseException as e:   # fail open: this guards a mistake, not an attack
        sys.stderr.write(f'{NAME}: failed ({type(e).__name__}: {e}); the command is NOT checked and runs. '
                         'Tell the owner if this repeats.\n')
        return 1
    sys.stderr.write(reason(tool) + '\n')
    if SETTINGS_PROBLEM:    # exit 2: stderr is what the agent reads
        sys.stderr.write(_problem_text() + '\n')
    return 2


def _problem_text():
    try:
        from agent_guards import config
        return config.problem_text(NAME, SETTINGS_PROBLEM)
    except BaseException:   # noqa: BLE001 - no lib
        return f'{NAME}: {SETTINGS_PROBLEM}; built-in defaults used. Tell the owner.'


def _say_problem(event):
    """A config problem, where the agent and the owner see it (the call runs: exit 0 with an answer)."""
    if not SETTINGS_PROBLEM:
        return
    text = _problem_text()
    try:
        sys.stderr.write(text + '\n')
    except Exception:  # noqa: BLE001
        pass
    try:
        from agent_guards import config
        out = config.notice(NAME, SETTINGS_PROBLEM, event, None)
    except BaseException:   # noqa: BLE001
        out = {'systemMessage': text}
    print(json.dumps(out))


if __name__ == '__main__':
    sys.exit(main())
