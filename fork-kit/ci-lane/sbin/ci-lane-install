#!/usr/bin/python3 -IB
"""ci-lane-install: install, uninstall or check the ci-lane kit, as root (fork-kit/ci-lane/README.md).

  ci-lane-install install --source KIT_FOLDER --sha RELEASE_SHA [--timer | --no-timer]
  ci-lane-install uninstall
  ci-lane-install self-check

install copies bin/ci-lane, sbin/ci-lane-install, lib/cilane/, systemd/, README.md and fork-kit/common/kit_install.py
of one release into /usr/local/libexec/ci-lane/versions/<sha>/ (with MANIFEST.sha256), checks the copy, switches the
link `current` to it and links /usr/local/bin/ci-lane and /usr/local/sbin/ci-lane-install to it. With --timer it
also writes the kit's timer: the user units ci-lane.service and ci-lane.timer in /etc/systemd/user/, which run
`ci-lane tick` every 2 minutes for each user who enables them (that user's own config file names the repository, the
CI App and the launcher); --no-timer removes them. Written is not enabled: no user runs the lane until it enables
the timer itself. The choice is kept in /etc/ci-lane/config.json, so a run without either option keeps it. Safe to
run again, and to stop at any step; one installer at a time. The steps every kit shares are in
fork-kit/common/kit_install.py.
"""
import os, sys
_kit = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_common = os.path.join(_kit, 'common')
sys.path[:0] = [_common if os.path.isdir(_common) else os.path.join(os.path.dirname(_kit), 'common')]
try:
    import kit_install  # noqa: E402
except ImportError as e:     # a copy without common/kit_install.py (changed or partly removed by hand)
    sys.exit(f'ci-lane-install: cannot load its installer code ({e}): install again with the bootstrap, as '
             'root (fork-kit/ci-lane/README.md, Install)')

UNIT_DIR = '/etc/systemd/user'
TIMER_UNITS = ('ci-lane.service', 'ci-lane.timer')
UNIT_HEADER = '# ci-lane kit: written by ci-lane-install.'
ENABLE = 'systemctl --user daemon-reload && systemctl --user enable --now ci-lane.timer'
DISABLE = 'systemctl --user disable --now ci-lane.timer'


class CiLaneInstaller(kit_install.Installer):
    PROG = 'ci-lane-install'
    PROGRAM = __file__
    KIT = 'ci-lane'
    ETC = '/etc/ci-lane'
    LIBEXEC = '/usr/local/libexec/ci-lane'
    LINKS = {'/usr/local/bin/ci-lane': 'bin/ci-lane',
             '/usr/local/sbin/ci-lane-install': 'sbin/ci-lane-install'}
    SOURCE_FILES = ('bin/ci-lane', 'sbin/ci-lane-install', 'README.md', 'common/kit_install.py') + \
        tuple(f'systemd/{u}' for u in TIMER_UNITS)
    EXECUTABLE = frozenset({'bin/ci-lane', 'sbin/ci-lane-install'})
    PACKAGE = 'cilane'
    MODULES = ('__init__', 'cli', 'github', 'lane', 'parity', 'plan')
    HELP = ('bin/ci-lane', 'tick')
    HAS_CONFIG = True
    KIT_STEPS = ('timer-units',)

    def add_install_options(self, parser):
        parser.add_argument('--timer', dest='timer', action='store_true', default=None)
        parser.add_argument('--no-timer', dest='timer', action='store_false')

    def unit_paths(self):
        return [f'{UNIT_DIR}/{name}' for name in TIMER_UNITS]

    def ours_unit(self, path):
        """A unit file this kit wrote (its first line says so), and no link."""
        real = self.p(path)
        if os.path.islink(real):
            return False
        try:
            with open(real, encoding='utf-8') as f:
                return f.readline().startswith(UNIT_HEADER)
        except OSError:
            return False

    def plan(self, a):
        timer = a.timer if a.timer is not None else bool(self.read_config().get('timer'))
        foreign = [u for u in self.unit_paths() if os.path.lexists(self.p(u)) and not self.ours_unit(u)]
        if timer and foreign:
            raise self.Refused(f'{foreign[0]} exists and was not written by this kit: remove it and run again, or '
                               'run with --no-timer to leave it alone')
        return {'timer': timer}

    def config(self, a, plan):
        return {'version': 1, 'timer': plan['timer']}

    def kit_step(self, step, a, plan, dest):
        # after the links: the timer is only written once the release it runs is the one in use
        for name, path in zip(TIMER_UNITS, self.unit_paths()):
            if plan['timer']:
                if os.path.lexists(self.p(path)) and not self.ours_unit(path):
                    raise self.Refused(f'{path} exists and was not written by this kit: remove it and run again, '
                                       'or run with --no-timer to leave it alone')
                self.ensure_dir(UNIT_DIR)
                with open(os.path.join(dest, 'systemd', name), encoding='utf-8') as f:
                    if self.write_file(path, f.read()):
                        self.say(f'wrote {path}: each user with a config runs `{ENABLE}`')
            elif self.ours_unit(path):
                os.unlink(self.p(path))
                self.say(f'removed {path} (users run `{DISABLE}`)')

    def kit_rows(self, plan):
        if not plan['timer']:
            return []
        return [(path, 'file', kit_install.sha256_file(self.p(path))) for path in self.unit_paths()]

    def kit_uninstall(self):
        for path in self.unit_paths():
            if self.ours_unit(path):
                os.unlink(self.p(path))
                self.say(f'removed {path} (users run `{DISABLE}`)')

    def installed_summary(self, plan):
        return ', timer units written (tick every 2 minutes, off until a user enables it)' if plan['timer'] else \
            ', no timer'


INSTALLER = CiLaneInstaller()


def main(argv, stop_after=None):
    return INSTALLER.main(argv, stop_after, doc=__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
