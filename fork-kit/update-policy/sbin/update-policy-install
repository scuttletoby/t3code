#!/usr/bin/python3 -IB
"""update-policy-install: install, uninstall or check the update-policy kit, as root (fork-kit/update-policy/README.md).

  update-policy-install install --source KIT_FOLDER --sha RELEASE_SHA [--timer | --no-timer]
  update-policy-install uninstall
  update-policy-install self-check

install copies bin/update-policy, sbin/update-policy-install, lib/updatepolicy/, systemd/, apt/, README.md and
fork-kit/common/{machine_file,free_contract,kit_install}.py of one release into
/usr/local/libexec/update-policy/versions/<sha>/ (with MANIFEST.sha256), checks the copy, switches the link `current`
to it and links /usr/local/bin/update-policy and /usr/local/sbin/update-policy-install to it. With --timer the kit
takes over restarts: it writes /etc/apt/apt.conf.d/zz-update-policy (unattended-upgrades never restarts by itself)
and the system units update-policy.{service,timer} (the restart policy, every 5 minutes),
update-policy-baseline.{service,timer} (the daily baseline check) and update-policy-boot.service (the look after a
boot) in /etc/systemd/system/; the owner then enables them. --no-timer removes them (refused while they are
enabled). The choice is kept in /etc/update-policy/config.json, so a run without either option keeps it. Safe to
run again, and to stop at any step; one installer at a time. The steps every kit shares are in
fork-kit/common/kit_install.py.
"""
import os, shutil, subprocess, sys
_kit = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_common = os.path.join(_kit, 'common')
sys.path[:0] = [_common if os.path.isdir(_common) else os.path.join(os.path.dirname(_kit), 'common')]
try:
    import kit_install  # noqa: E402
except ImportError as e:     # a copy without common/kit_install.py (changed or partly removed by hand)
    sys.exit(f'update-policy-install: cannot load its installer code ({e}): install again with the bootstrap, as '
             'root (fork-kit/update-policy/README.md, Install)')

UNIT_DIR = '/etc/systemd/system'
UNITS = ('update-policy.service', 'update-policy.timer', 'update-policy-baseline.service',
         'update-policy-baseline.timer', 'update-policy-boot.service')
APT_FILE = '/etc/apt/apt.conf.d/zz-update-policy'
STATE_DIR = '/var/lib/update-policy'
HEADERS = ('# update-policy kit: written by update-policy-install.',
           '// update-policy kit: written by update-policy-install.')
# what `systemctl enable` makes: while one is there, the units are in use and stay
WANTS = (f'{UNIT_DIR}/timers.target.wants/update-policy.timer',
         f'{UNIT_DIR}/timers.target.wants/update-policy-baseline.timer',
         f'{UNIT_DIR}/multi-user.target.wants/update-policy-boot.service')
ENABLE = ('systemctl daemon-reload && systemctl enable --now update-policy.timer update-policy-baseline.timer && '
          'systemctl enable update-policy-boot.service')
DISABLE = ('systemctl disable --now update-policy.timer update-policy-baseline.timer update-policy-boot.service '
           '&& systemctl daemon-reload')


class UpdatePolicyInstaller(kit_install.Installer):
    PROG = 'update-policy-install'
    PROGRAM = __file__
    KIT = 'update-policy'
    ETC = '/etc/update-policy'
    LIBEXEC = '/usr/local/libexec/update-policy'
    LINKS = {'/usr/local/bin/update-policy': 'bin/update-policy',
             '/usr/local/sbin/update-policy-install': 'sbin/update-policy-install'}
    SOURCE_FILES = ('bin/update-policy', 'sbin/update-policy-install', 'README.md', 'common/machine_file.py',
                    'common/free_contract.py', 'common/kit_install.py', 'apt/zz-update-policy') \
        + tuple(f'systemd/{name}' for name in UNITS)
    EXECUTABLE = frozenset({'bin/update-policy', 'sbin/update-policy-install'})
    PACKAGE = 'updatepolicy'
    MODULES = ('__init__', 'baseline', 'cli', 'idle', 'settings', 'tick', 'window')
    HELP = ('bin/update-policy', 'update-policy tick')
    HAS_CONFIG = True
    KIT_STEPS = ('policy-files',)

    def add_install_options(self, parser):
        parser.add_argument('--timer', dest='timer', action='store_true', default=None)
        parser.add_argument('--no-timer', dest='timer', action='store_false')

    def files(self):
        """[(host path, file of the release)] the timer choice writes: the units, then the apt file."""
        return [(f'{UNIT_DIR}/{name}', f'systemd/{name}') for name in UNITS] + [(APT_FILE, 'apt/zz-update-policy')]

    def ours_file(self, path):
        """A file this kit wrote (its first line says so), and no link."""
        real = self.p(path)
        if os.path.islink(real):
            return False
        try:
            with open(real, encoding='utf-8') as f:
                return f.readline().startswith(HEADERS)
        except (OSError, UnicodeDecodeError):
            return False

    def enabled(self):
        return [w for w in WANTS if os.path.lexists(self.p(w))]

    def plan(self, a):
        timer = a.timer if a.timer is not None else bool(self.read_config().get('timer'))
        if timer:
            foreign = [path for path, _ in self.files() if os.path.lexists(self.p(path)) and not self.ours_file(path)]
            if foreign:
                raise self.Refused(f'{foreign[0]} exists and was not written by this kit: remove it and run again, '
                                   'or run with --no-timer to leave it alone')
        elif self.enabled():
            raise self.Refused(f'the units are enabled ({self.enabled()[0]}): run `{DISABLE}` first, then '
                               '--no-timer again')
        return {'timer': timer}

    def config(self, a, plan):
        return {'version': 1, 'timer': plan['timer']}

    def kit_step(self, step, a, plan, dest):
        # after the links: the units and the apt file are written only once the release they run is the one in use
        for path, rel in self.files():
            if plan['timer']:
                if os.path.lexists(self.p(path)) and not self.ours_file(path):
                    raise self.Refused(f'{path} exists and was not written by this kit: remove it and run again, '
                                       'or run with --no-timer to leave it alone')
                self.ensure_dir(os.path.dirname(path))
                with open(os.path.join(dest, rel), encoding='utf-8') as f:
                    if self.write_file(path, f.read()):
                        self.say(f'wrote {path}')
            elif self.ours_file(path):
                os.unlink(self.p(path))
                self.say(f'removed {path}')
        if plan['timer']:
            self.say(f'restarts are the kit\'s now; enable it: `{ENABLE}`')
            self.check_apt()
        else:
            self.say('no timer: unattended-upgrades\' own Automatic-Reboot setting applies')

    def check_apt(self):
        """On the real host: apt's effective Automatic-Reboot after the write (a later file may still win)."""
        if self.PREFIX:
            return
        try:
            out = subprocess.run(['apt-config', 'dump'], capture_output=True, text=True, timeout=30).stdout
        except (OSError, subprocess.TimeoutExpired):
            self.say('apt-config cannot run: check Unattended-Upgrade::Automatic-Reboot by hand')
            return
        lines = [x for x in out.splitlines() if x.startswith('Unattended-Upgrade::Automatic-Reboot ')]
        if lines and lines[-1].split(' ', 1)[1].strip('";').lower() in ('1', 'true', 'yes', 'on'):
            self.say(f'WARNING: apt still says {lines[-1]} (/etc/apt/apt.conf or a file named after '
                     f'{os.path.basename(APT_FILE)} wins): unattended-upgrades would restart by itself; remove it')

    def kit_rows(self, plan):
        if not plan['timer']:
            return []
        return [(path, 'file', kit_install.sha256_file(self.p(path))) for path, _ in self.files()]

    def uninstall_guard(self):
        if self.enabled():
            raise self.Refused(f'the units are enabled ({self.enabled()[0]}): run `{DISABLE}` first, then uninstall '
                               'again')
        return super().uninstall_guard()

    def kit_uninstall(self):
        for path, _ in self.files():
            if self.ours_file(path):
                os.unlink(self.p(path))
                self.say(f'removed {path}')
        state = self.p(STATE_DIR)
        if os.path.isdir(state) and not os.path.islink(state):
            shutil.rmtree(state)
            self.say(f'removed {STATE_DIR}')
        self.say('unattended-upgrades\' own Automatic-Reboot setting applies again')

    def installed_summary(self, plan):
        return ', units and the apt file written (restarts are the kit\'s)' if plan['timer'] else ', no timer'


INSTALLER = UpdatePolicyInstaller()


def main(argv, stop_after=None):
    return INSTALLER.main(argv, stop_after, doc=__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
