#!/usr/bin/python3 -IB
"""gardener-install: install, uninstall or check the gardener kit, as root (fork-kit/gardener/README.md).

  gardener-install install --source KIT_FOLDER --sha RELEASE_SHA [--timer | --no-timer]
  gardener-install uninstall
  gardener-install self-check

install copies bin/gardener, sbin/gardener-install, lib/gardener/, checks/, systemd/, README.md and
fork-kit/common/{machine_file,kit_install}.py of one release into /usr/local/libexec/gardener/versions/<sha>/ (with
MANIFEST.sha256), checks the copy, switches the link `current` to it and links /usr/local/bin/gardener and
/usr/local/sbin/gardener-install to it. With --timer it also writes the kit's one timer: the user units
gardener.service and gardener.timer in /etc/systemd/user/, which run `gardener run --timer` every hour for each
user who enables the timer (the machine file's "gardener" section names the projects and their checks); --no-timer
removes them. Installing never enables the timer for anyone. The choice is kept in /etc/gardener/config.json, so
a run without either option keeps it. Safe to run again, and to stop at any step; one installer at a time. The
steps every kit shares are in fork-kit/common/kit_install.py.
"""
import os, sys
_kit = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_common = os.path.join(_kit, 'common')
sys.path[:0] = [_common if os.path.isdir(_common) else os.path.join(os.path.dirname(_kit), 'common')]
try:
    import kit_install  # noqa: E402
except ImportError as e:     # a copy without common/kit_install.py (changed or partly removed by hand)
    sys.exit(f'gardener-install: cannot load its installer code ({e}): install again with the bootstrap, as '
             'root (fork-kit/gardener/README.md, Install)')

UNIT_DIR = '/etc/systemd/user'
TIMER_UNITS = ('gardener.service', 'gardener.timer')
UNIT_HEADER = '# gardener kit: written by gardener-install.'
ENABLE = 'systemctl --user daemon-reload && systemctl --user enable --now gardener.timer'
DISABLE = 'systemctl --user disable --now gardener.timer'


class GardenerInstaller(kit_install.Installer):
    PROG = 'gardener-install'
    PROGRAM = __file__
    KIT = 'gardener'
    ETC = '/etc/gardener'
    LIBEXEC = '/usr/local/libexec/gardener'
    LINKS = {'/usr/local/bin/gardener': 'bin/gardener',
             '/usr/local/sbin/gardener-install': 'sbin/gardener-install'}
    CHECKS = ('checks/context-budget', 'checks/facts', 'checks/install-drift', 'checks/workflows-off',
              'checks/worktrees')
    SOURCE_FILES = ('bin/gardener', 'sbin/gardener-install', 'README.md', 'common/machine_file.py',
                    'common/kit_install.py', 'systemd/gardener.service', 'systemd/gardener.timer') + CHECKS
    EXECUTABLE = frozenset({'bin/gardener', 'sbin/gardener-install'} | set(CHECKS))
    PACKAGE = 'gardener'
    MODULES = ('__init__', 'cli', 'config', 'contract', 'judge', 'report', 'runner')
    HELP = ('bin/gardener', 'gardener run')
    HAS_CONFIG = True
    KIT_STEPS = ('timer-units',)

    def add_install_options(self, parser):
        parser.add_argument('--timer', dest='timer', action='store_true', default=None)
        parser.add_argument('--no-timer', dest='timer', action='store_false')

    def unit_paths(self):
        return [f'{UNIT_DIR}/{name}' for name in TIMER_UNITS]

    def ours_unit(self, path):
        """A unit file this kit wrote (its first line says so), and no link."""
        real = self.p(path)
        if os.path.islink(real):
            return False
        try:
            with open(real, encoding='utf-8') as f:
                return f.readline().startswith(UNIT_HEADER)
        except OSError:
            return False

    def plan(self, a):
        timer = a.timer if a.timer is not None else bool(self.read_config().get('timer'))
        foreign = [u for u in self.unit_paths() if os.path.lexists(self.p(u)) and not self.ours_unit(u)]
        if timer and foreign:
            raise self.Refused(f'{foreign[0]} exists and was not written by this kit: remove it and run again, or '
                               'run with --no-timer to leave it alone')
        return {'timer': timer}

    def config(self, a, plan):
        return {'version': 1, 'timer': plan['timer']}

    def kit_step(self, step, a, plan, dest):
        # after the links: the timer is only written once the release it runs is the one in use
        for name, path in zip(TIMER_UNITS, self.unit_paths()):
            if plan['timer']:
                if os.path.lexists(self.p(path)) and not self.ours_unit(path):
                    raise self.Refused(f'{path} exists and was not written by this kit: remove it and run again, '
                                       'or run with --no-timer to leave it alone')
                self.ensure_dir(UNIT_DIR)
                with open(os.path.join(dest, 'systemd', name), encoding='utf-8') as f:
                    if self.write_file(path, f.read()):
                        self.say(f'wrote {path}: each user with a config runs `{ENABLE}`')
        if not plan['timer']:
            self.remove_units()

    def kit_rows(self, plan):
        if not plan['timer']:
            return []
        return [(path, 'file', kit_install.sha256_file(self.p(path))) for path in self.unit_paths()]

    def remove_units(self):
        """Remove our timer units. Users who enabled the timer disable it first: said before anything goes, so
        nobody is left with a link in timers.target.wants to a unit that is gone."""
        ours = [path for path in self.unit_paths() if self.ours_unit(path)]
        if ours:
            self.say(f'the timer goes: each user who enabled it runs `{DISABLE}` first')
        for path in ours:
            os.unlink(self.p(path))
            self.say(f'removed {path}')

    def kit_uninstall(self):
        self.remove_units()

    def installed_summary(self, plan):
        return ', timer units written (every hour; each user enables their own)' if plan['timer'] else ', no timer'


INSTALLER = GardenerInstaller()


def main(argv, stop_after=None):
    return INSTALLER.main(argv, stop_after, doc=__doc__)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
