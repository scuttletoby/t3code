#!/usr/bin/python3 -IB
"""heavy: run a command in a capped systemd user slice, and stop whatever it leaves behind.

  heavy [--wait S] <command> [args...]
                                  run <command> in its own scope in the slice, wait for it, stop the scope; first
                                  wait (up to S seconds, default 7200, then exit 76) until the machine's capacity
                                  rule (`heavy facts`) says free, unless heavy.queue.capacityCheck is false
  HEAVY_KEEP=1 heavy <command>    the same, but processes the command leaves running are kept (a daemon)
  heavy --self-check              check the config, the slice and the installed files (exit 1 on a problem), and
                                  warn when the t3-capacity on PATH is not this kit's
  heavy sweep [--dry-run|--json]  stop or report what commands left behind outside heavy (lib/heavy_sweep.py)
  heavy leftovers [--older-than AGE] [--json]
                                  look only: what is left behind (processes, heavy scopes, containers) older
                                  than AGE (seconds, 30m, 2h, 1d), each with its owner and age; needs no settings
  heavy docker-label [--value]    the owner label for a container a test starts, so heavy (when its command ends)
                                  and the sweep can remove it (--owner-pid PID: the long-lived test process; README)
  heavy --kind <name> [--mb N] [--wait S] [--] <command> [args...]
                                  the same, but first wait in the memory queue until the job's memory fits and
                                  the capacity rule admits it (lib/heavy_queue.py; exit 76 after --wait seconds,
                                  default 7200, with the
                                  line "heavy: gave up after waiting" on stderr: a command that exits 76 by itself
                                  has no such line)
  heavy --measure <kind> [--] <command> [args...]
                                  the same, and record the job's peak memory under <kind> for `heavy capacity`
                                  (lib/heavy_measure.py; a --kind job is recorded under its kind too)
  heavy capacity --kinds FILE --check PROGRAM [<kind> | <MB>] [args...]
                                  the machine's capacity check with a kind turned into its measured MB
  heavy capacity --kinds FILE --show [--json] [<kind>...]
                                  each kind's amount and how it was found
  heavy queue [--json]            what the memory queue runs and holds, and the figures behind it
  heavy facts [--kind K] [--mb N] may one more piece of work start? The capacity rule's answer as a free/v1
                                  object with per-kind "fits" (lib/heavy_facts.py; exit 0 free, 75 busy)
  heavy waits [--days N] [--json] minutes waited for memory per day
  heavy -- <command> [args...]    run a command named like one of the words above

The command runs with the same folder, environment, stdin, stdout, stderr and open files, and heavy exits with
its exit code (or dies of the same signal). When the command ends, every process it left in its scope is stopped
(TERM, then KILL after the grace time) and heavy prints one line on stderr:

  heavy: stopped N leftover processes (<names>)

Docker containers labelled with the scope (heavy docker-label) are removed then too:

  heavy: removed N leftover containers (<names>)

Nothing is printed when nothing was left. Docker is asked only when heavy docker-label noted the scope (in
/run/user/<uid>/heavy/labelled), or when that folder is not usable. If heavy itself dies without cleaning up
(kill -9 of heavy, its process group or its process tree; a crash), its guard (a small process of its own, outside
the scope, in a session of its own and not heavy's child, named scope-guard) stops the scope and removes those
containers.
When heavy itself gets INT, TERM, HUP or QUIT, the command gets the signal too (from heavy when someone sent it
to heavy alone; a terminal's Ctrl-C reaches both); after the grace time, or at a second signal, the whole scope
is stopped.

heavy never runs a command uncapped: it refuses (exit 1) when the systemd user manager cannot be reached, or the
slice has no unit or no memory limit. Inside another heavy command it runs the command in the outer scope, which
the outer heavy cleans up (HEAVY_KEEP=1 still gets a scope of its own).

The command's environment is exactly heavy's, plus HEAVY_SCOPE (the scope's unit name) and HEAVY_MARKS (which
folders heavy reads the notes of `heavy docker-label` from, as device:inode). Kept scopes are named
heavy-keep-<name>-<random>.scope, all others heavy-<name>-<random>.scope (never heavy-keep-...).

Settings: /etc/heavy/config.json ({"slice": "heavy.slice", "grace_seconds": 30}), or the file HEAVY_CONFIG names;
HEAVY_SLICE and HEAVY_GRACE override single values (HEAVY_SYSTEMCTL: another systemctl, HEAVY_QUEUE_ROOT: another
folder for the memory queue's state, HEAVY_STATE_DIR: another folder for the measured history, HEAVY_DOCKER:
another docker; all for tests). Standard library only; Linux with systemd and cgroup v2.
"""
import hashlib, json, os, pwd, re, secrets, signal, stat, subprocess, sys, time

CONFIG = '/etc/heavy/config.json'
INSTALLED = '/etc/heavy/installed.tsv'
DEFAULTS = {'slice': 'heavy.slice', 'grace_seconds': 30}
SLICE_RE = re.compile(r'^[A-Za-z0-9_.:-]{1,200}\.slice\Z')
CGROUP_ROOTS = ('/sys/fs/cgroup', '/sys/fs/cgroup/unified')
SCOPE_START_SECONDS = 5  # a job without --kind keeps the queue lock at most this long, until its scope can be counted
SETTLE = 1               # seconds stop_scope still looks after a step that sent nothing (processes ending anyway)
WATCH = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)   # stop the scope after the grace time
FORWARD = (signal.SIGUSR1, signal.SIGUSR2)                               # only passed on to the command
# Signals heavy dies of again itself (the caller sees the same signal). Signals that dump core are reported as
# exit 128+N instead, so heavy never leaves a core file of its own.
RERAISE = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGKILL, signal.SIGPIPE, signal.SIGUSR1,
           signal.SIGUSR2, signal.SIGALRM}
PR_SET_PDEATHSIG = 1
PR_SET_NAME = 15
PROBE_NAME = b'grp-sigprobe'   # no 'heavy' in it: `pkill heavy` / `killall heavy` must not signal the probe too
GUARD_NAME = b'scope-guard'    # the same for the guard: `pkill -9 heavy` must leave it to clean up after heavy
LABEL = 'fork-kit.heavy.owner'  # the container owner label (lib/heavy_sweep.py writes and reads it too)
DOCKER_SOCKET = '/var/run/docker.sock'
DOCKER_DIRS = ('/usr/bin', '/bin', '/usr/local/bin')
RUNTIME_ROOT = '/run/user'      # <root>/<uid>/heavy/labelled: the scopes `heavy docker-label` labelled a container for
STATE_ROOT = ''                 # <root>/heavy/labelled: the same, where /run/user is out of reach ('' = ~/.local/state)
DOCKER_TIMEOUT = 20
MAX_NAMES = 5
DEFAULT_WAIT = 7200             # seconds a job waits for memory (--kind) or capacity (any job, #866) before exit 76
# Python sets these to SIG_IGN at startup, and SIG_IGN survives exec: put them back before the command starts
# (subprocess does the same for its children)
PYTHON_IGNORED = [getattr(signal, n) for n in ('SIGPIPE', 'SIGXFSZ', 'SIGXFZ') if hasattr(signal, n)]


class Refused(Exception):
    pass


def say(msg):
    try:
        sys.stderr.write(f'heavy: {msg}\n')
        sys.stderr.flush()
    except OSError:
        pass


def tool(name):
    if name == 'systemctl' and os.environ.get('HEAVY_SYSTEMCTL'):     # tests: a systemctl that fails on purpose
        path = os.environ['HEAVY_SYSTEMCTL']
        if os.path.isabs(path) and os.access(path, os.X_OK):
            return path
        raise Refused(f'HEAVY_SYSTEMCTL {path!r} is not an absolute path to a program')
    for folder in ('/usr/bin', '/bin'):
        path = os.path.join(folder, name)
        if os.access(path, os.X_OK):
            return path
    raise Refused(f'{name} not found in /usr/bin or /bin (heavy needs systemd)')


def load_config():
    path = os.environ.get('HEAVY_CONFIG') or CONFIG
    cfg = dict(DEFAULTS)
    try:
        with open(path, encoding='utf-8') as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    except (OSError, ValueError) as e:
        raise Refused(f'cannot read {path}: {e}')
    if not isinstance(data, dict):
        raise Refused(f'{path} must hold a JSON object')
    for key in ('slice', 'grace_seconds'):
        if key in data:
            cfg[key] = data[key]
    if os.environ.get('HEAVY_SLICE'):
        cfg['slice'] = os.environ['HEAVY_SLICE']
    if os.environ.get('HEAVY_GRACE'):
        cfg['grace_seconds'] = os.environ['HEAVY_GRACE']
    if not isinstance(cfg['slice'], str) or not SLICE_RE.match(cfg['slice']):
        raise Refused(f'bad slice name {cfg["slice"]!r} (it must end in .slice)')
    try:
        grace = float(cfg['grace_seconds'])
    except (TypeError, ValueError):
        grace = -1
    if not 0 < grace <= 600:
        raise Refused(f'bad grace_seconds {cfg["grace_seconds"]!r} (a number of seconds, more than 0, at most 600)')
    cfg['grace_seconds'] = grace
    return cfg


def show(systemctl, unit, props):
    r = subprocess.run([systemctl, '--user', 'show', unit, '-p', ','.join(props)], stdin=subprocess.DEVNULL,
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        err = (r.stderr.strip() or f'exit {r.returncode}').splitlines()[-1]
        raise Refused(f'cannot reach the systemd user manager ({err})')
    out = {}
    for line in r.stdout.splitlines():
        k, _, v = line.partition('=')
        out[k] = v
    return out


def check_slice(systemctl, name, limits=None):
    """The slice's cgroup path ('' while it is not active). Refuses anything that would run the command uncapped.
    `limits` (a dict) gets the slice's MemoryHigh and MemoryMax in bytes (None for infinity)."""
    p = show(systemctl, name, ['LoadState', 'ActiveState', 'ControlGroup', 'MemoryMax', 'MemoryHigh',
                               'FragmentPath', 'DropInPaths'])
    # systemd makes up any missing slice on the fly (loaded, no file, no limits): that is "no unit" too
    if p.get('LoadState') != 'loaded' or not (p.get('FragmentPath') or p.get('DropInPaths')):
        raise Refused(f'{name} has no unit file: the command would run uncapped. '
                      f'Add one with a memory limit (fork-kit/heavy/README.md)')
    if p.get('MemoryMax', 'infinity') == 'infinity' and p.get('MemoryHigh', 'infinity') == 'infinity':
        raise Refused(f'{name} has no MemoryMax or MemoryHigh: the command would run uncapped')
    if limits is not None:
        for key in ('MemoryHigh', 'MemoryMax'):
            limits[key] = int(p[key]) if p.get(key, '').isdigit() else None
    return p.get('ControlGroup', '') if p.get('ActiveState') == 'active' else ''


def cgroup_of(pid):
    """The cgroup v2 path of a process ('self' for heavy itself), '' when it cannot be read."""
    try:
        with open(f'/proc/{pid}/cgroup', encoding='utf-8') as f:
            for line in f:
                if line.startswith('0::'):
                    return line[3:].strip()
    except OSError:
        pass
    return ''


def own_cgroup():
    return cgroup_of('self')


def in_heavy_scope(slice_cg):
    """True inside a scope a heavy made in this slice (not a service or another tool's scope in the slice)."""
    own = own_cgroup()
    if not slice_cg or not own:
        return False
    parent, _, leaf = own.rpartition('/')
    return parent == slice_cg and leaf.startswith('heavy-') and leaf.endswith('.scope')


def unit_name(cmd, keep):
    """heavy-keep-<label>-<random>.scope with HEAVY_KEEP=1, else heavy-<label>-<random>.scope, which never starts with
    heavy-keep- (the leftover sweep tells kept scopes apart by that name). The label has no '-'."""
    label = re.sub(r'[^A-Za-z0-9_.]', '_', os.path.basename(cmd))[:32].strip('.') or 'cmd'
    if keep:
        return f'heavy-keep-{label}-{secrets.token_hex(4)}.scope'
    if label == 'keep':
        label = 'keep_'
    return f'heavy-{label}-{secrets.token_hex(4)}.scope'


def caller_environ():
    """The environment heavy was started with. Python's C-locale coercion (PEP 538, which -I cannot switch off) adds
    LC_CTYPE=C.UTF-8 to its own environment; /proc/self/environ still holds what the caller passed."""
    try:
        with open('/proc/self/environ', 'rb') as f:
            data = f.read()
    except OSError:
        return dict(os.environb)
    env = {}
    for item in data.split(b'\0'):
        key, sep, value = item.partition(b'=')
        if sep and key:
            env.setdefault(key, value)     # the first one wins, as for getenv() and os.environ
    return env


def cgroup_pids(cg):
    """Every pid in the cgroup and below it, or None when the cgroup cannot be read."""
    if not cg:
        return None
    for root in CGROUP_ROOTS:
        top = root + cg
        if not os.path.isfile(os.path.join(top, 'cgroup.procs')):
            continue
        pids = []
        for folder, _dirs, files in os.walk(top):
            if 'cgroup.procs' in files:
                try:
                    with open(os.path.join(folder, 'cgroup.procs'), encoding='ascii') as f:
                        pids += [int(x) for x in f.read().split()]
                except (OSError, ValueError):
                    pass
        return pids
    return None


def comm(pid):
    try:
        with open(f'/proc/{pid}/comm', encoding='utf-8', errors='replace') as f:
            return f.read().strip() or '?'
    except OSError:
        return '?'


def describe(pids):
    names = []
    for pid in pids:
        n = comm(pid)
        if n not in names:
            names.append(n)
    shown = ', '.join(names[:MAX_NAMES]) + (', ...' if len(names) > MAX_NAMES else '')
    noun = 'process' if len(pids) == 1 else 'processes'
    return f'{len(pids)} leftover {noun} ({shown})'


def scope_state(systemctl, unit):
    """(cgroup path, pids) of the scope; ('', []) once it is gone."""
    for attempt in range(3):
        try:
            p = show(systemctl, unit, ['ActiveState', 'ControlGroup'])
        except (Refused, subprocess.SubprocessError, OSError):
            return '', None
        if p.get('ActiveState') not in ('active', 'activating', 'deactivating') or not p.get('ControlGroup'):
            return '', []
        pids = cgroup_pids(p['ControlGroup'])
        if pids is not None or attempt == 2:
            return p['ControlGroup'], pids
        time.sleep(0.1)     # systemd removes an empty scope's cgroup a moment before it marks the scope inactive


def in_cgroup(pid, cg):
    """True while the process is in the cgroup or below it."""
    path = cgroup_of(pid)
    return bool(path) and (path == cg or path.startswith(cg + '/'))


def signal_in(pids, cg, sig):
    """Send sig to each of the pids that is still in the cgroup; returns how many got it. A pid read from
    cgroup.procs can be another process by now (the first one ended, the pid was reused): a pidfd pins the process
    before its cgroup is checked, so such a pid is never signalled. Without pidfds (Linux before 5.3, Python before
    3.9) nothing is sent: between the check and a kill by pid the pid could go to another process. The KILL then goes
    to cgroup.kill alone, or the processes are reported as still running (and the leftover sweep looks again)."""
    pidfd_open = getattr(os, 'pidfd_open', None)
    if pidfd_open is None:
        return 0
    sent = 0
    for pid in pids:
        try:
            fd = pidfd_open(pid)
        except OSError:         # gone (ProcessLookupError), or no pidfds in this kernel: never by pid
            continue
        try:
            if in_cgroup(pid, cg):
                signal.pidfd_send_signal(fd, sig)
                sent += 1
        except OSError:
            pass
        finally:
            os.close(fd)
    return sent


def kill_cgroup(cg):
    """KILL every process in the cgroup and below it at once through cgroup.kill (Linux 5.14+): no pid is read,
    so none can be reused. False when there is no cgroup.kill (or it cannot be written)."""
    for root in CGROUP_ROOTS:
        path = os.path.join(root + cg, 'cgroup.kill')
        if os.path.isfile(path):
            try:
                with open(path, 'w', encoding='ascii') as f:
                    f.write('1')
                return True
            except OSError:
                return False
    return False


def stop_scope(systemctl, unit, cg, grace):
    """Stop the scope (systemd sends TERM, then KILL after TimeoutStopSec = the grace time). If systemd cannot do
    it, stop what is left by hand: TERM to each process still in the scope, then after the grace time KILL to the
    whole cgroup (cgroup.kill; each process by hand only without it). After a step that sent nothing (no pidfds,
    or none of the pids still in the scope) only a short settle (SETTLE seconds), not the grace time: nothing heavy
    did would end them sooner, but systemd's own failed stop may already have signalled them, and those are not
    named as still running while they end. Returns the pids still alive afterwards (empty when all are gone)."""
    try:
        subprocess.run([systemctl, '--user', 'stop', unit], stdin=subprocess.DEVNULL, capture_output=True,
                       timeout=grace * 2 + 30)
    except (subprocess.SubprocessError, OSError):
        pass
    left = cgroup_pids(cg) or []
    if left:
        for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 5)):
            if sig == signal.SIGKILL and kill_cgroup(cg):
                sent = True
            else:
                sent = signal_in(left, cg, sig) > 0
            end = time.monotonic() + (wait if sent else SETTLE)
            while True:
                left = cgroup_pids(cg) or []
                if not left or time.monotonic() >= end:
                    break
                time.sleep(0.05)
            if not left:
                break
    return left


def docker_tool():
    """The docker program, or None when this user has no Docker to clean up: not installed, or no DOCKER_HOST, no
    DOCKER_CONTEXT, no context picked with `docker context use` (rootless Docker) and a default socket this user
    cannot use (such a user could not have started a container through it either)."""
    if os.environ.get('HEAVY_DOCKER'):          # tests: a fake docker
        path = os.environ['HEAVY_DOCKER']
        return path if os.path.isabs(path) and os.access(path, os.X_OK) else None
    path = next((os.path.join(d, 'docker') for d in DOCKER_DIRS if os.access(os.path.join(d, 'docker'), os.X_OK)),
                None)
    if (path and not os.environ.get('DOCKER_HOST') and not os.environ.get('DOCKER_CONTEXT')
            and not docker_context() and not os.access(DOCKER_SOCKET, os.R_OK | os.W_OK)):
        return None
    return path


def docker_context():
    """The context `docker context use` picked (currentContext in the Docker CLI's config.json), '' for none or
    the default one."""
    folder = os.environ.get('DOCKER_CONFIG') or os.path.join(os.path.expanduser('~'), '.docker')
    try:
        with open(os.path.join(folder, 'config.json'), encoding='utf-8') as f:
            name = json.load(f).get('currentContext')
    except (OSError, ValueError, AttributeError):
        return ''
    return name if isinstance(name, str) and name not in ('', 'default') else ''


def repair(folder, st, uid):
    """The command that makes a refused folder usable: chown when another user owns it (a root-owned ~/.local from an
    older heavy run as root, #760), else chmod go-w (a ~/.local of mode 775, as umask 002 makes it). A link or a file
    in its place is not a folder at all."""
    if not stat.S_ISDIR(st.st_mode):
        return f'replace {folder} with a real folder'
    if st.st_uid != uid:
        return f'sudo chown "$USER:" {folder}'
    return f'chmod go-w {folder}'


def own_folder(base, make_base=False):
    """<base>/heavy/labelled, made if missing: '' unless it, its parent and base are folders this user owns and
    only this user can write. make_base: base (~/.local/state) and its parent (~/.local) are made too, one at a
    time, and the parent must be a real folder (no symlink) this user owns that no one else can write, so a planted
    ~/.local link never leads heavy to make folders elsewhere, and no one else can swap state for a link (#771). A
    folder refused there is said (#945: a ~/.local of mode 775, as umask 002 makes it, would drop it silently)."""
    uid = os.getuid()
    path = os.path.join(base, 'heavy', 'labelled')

    def refused(folder, st):
        if make_base:
            say(f'no second notes folder for docker-label: {folder} must be a real folder of yours that no one else '
                f'can write (`{repair(folder, st, uid)}`; README, Docker leftovers)')
        return ''
    try:
        if make_base:
            parent = os.path.dirname(base)
            try:
                os.mkdir(parent, 0o700)
            except FileExistsError:
                pass
            st = os.lstat(parent)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or st.st_mode & 0o022:
                return refused(parent, st)
        for folder in (base, os.path.dirname(path), path):
            if folder != base or make_base:
                try:
                    os.mkdir(folder, 0o700)
                except FileExistsError:
                    pass
            st = os.lstat(folder)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or st.st_mode & 0o022:
                return refused(folder, st)
    except OSError:
        return ''
    return path


def marks_dir():
    """The folder in which `heavy docker-label` notes each scope it labelled a container for (lib/heavy_sweep.py
    note_label, the same rule), made if missing: heavy asks Docker after a run only when the run's scope is noted
    there, so a run that never labelled a container never starts or waits for the Docker daemon. '' when there is
    no such folder this user alone owns."""
    return own_folder(os.path.join(RUNTIME_ROOT, str(os.getuid())))


def others_can_swap(path):
    """True when a folder above `path` (links resolved) is not root's or this user's, or a group or others can write it
    and it is not sticky: someone else could swap a part of the path after it was checked (#951; lib/heavy_sweep.py
    others_can_swap and lib/heavy_facts.py swappable, the same rule: tests/facts.test.py OneRule checks they agree;
    plain heavy loads no kit module, so this copy stays)."""
    uid, at = os.geteuid(), path
    while at != '/':
        at = os.path.dirname(at)
        try:
            st = os.lstat(at)
        except OSError:
            return True
        if st.st_uid not in (0, uid) or (st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX):
            return True
    return False


def state_base():
    """<home>/.local/state for the second notes folder (lib/heavy_sweep.py state_base, the same rule), or '' for none.
    The home is $HOME, else the password database's; only an absolute folder this user owns, that no group or other
    user can write, not /, and in no folder someone else could swap it in (others_can_swap, #951). heavy makes the
    folder when it is missing, so never in another user's home (root with a user's HOME, `sudo -E heavy ...`, uses
    root's own home), never under a folder anyone can write (root with HOME=/tmp: another user could plant
    /tmp/.local first) and never relative to the job's working folder (no HOME and no passwd entry: no second
    folder)."""
    if STATE_ROOT:
        return STATE_ROOT
    homes = [os.environ.get('HOME') or '']
    try:
        homes.append(pwd.getpwuid(os.getuid()).pw_dir)
    except KeyError:
        pass
    for home in homes:
        if not home or not os.path.isabs(home):
            continue
        home = os.path.realpath(home)   # resolved once: a HOME link swapped after this check changes nothing (#771)
        try:
            st = os.lstat(home)
        except OSError:
            continue
        if stat.S_ISDIR(st.st_mode) and st.st_uid == os.geteuid() and not st.st_mode & 0o022 and home != '/' \
                and not others_can_swap(home):
            return os.path.join(home, '.local', 'state')
    return ''


def state_marks_dir():
    """The second folder for those notes, in the user's state folder: `heavy docker-label` writes there when its
    note in marks_dir() cannot reach heavy (/run/user full, or another one in a sandbox's own mount namespace)."""
    base = state_base()
    return own_folder(base, make_base=True) if base else ''


def marks_dirs():
    """The folders heavy reads notes from: none when it has neither (then it asks Docker after every run)."""
    return tuple(m for m in (marks_dir(), state_marks_dir()) if m)


def marks_ids(marks):
    """HEAVY_MARKS for the command: device:inode of each folder, so `heavy docker-label` can tell whether the folder
    it wrote its note into is one heavy reads (the same path in another mount namespace is another folder)."""
    ids = []
    for m in marks:
        try:
            st = os.stat(m)
        except OSError:
            continue
        ids.append(f'{st.st_dev}:{st.st_ino}')
    return ','.join(ids)


def give_marks(env, marks):
    """HEAVY_MARKS in the command's environment: this heavy's folders, or none (then heavy asks Docker after every
    run); never an outer heavy's value or one left in a shell, which docker-label would trust."""
    ids = marks_ids(marks)
    if ids:
        env[b'HEAVY_MARKS'] = ids.encode()
    else:
        env.pop(b'HEAVY_MARKS', None)


def labelled(marks, unit):
    """True when the scope labelled a container (a note in one of the folders), or when heavy cannot tell (none)."""
    return not marks or any(os.path.exists(os.path.join(m, unit)) for m in marks)


def forget(marks, unit):
    for m in marks:
        try:
            os.unlink(os.path.join(m, unit))
        except OSError:
            pass


def clean_containers(docker, unit, marks):
    """remove_containers, when the scope labelled a container (or heavy cannot tell); the note goes too."""
    result = remove_containers(docker, unit) if labelled(marks, unit) else ([], '')
    forget(marks, unit)
    return result


def owner_value(unit):
    """The owner label value `heavy docker-label` gives a container started in this scope (lib/heavy_sweep.py)."""
    return f'uid={os.getuid()},scope={unit}'


def short_name(name):
    name = name.lstrip('/') or '?'
    return name if len(name) <= 40 else name[:37] + '...'


def remove_containers(docker, unit):
    """Remove (with their anonymous volumes) the containers labelled as started in this scope, by full id. Returns
    (names removed, problem text or ''). Only an exact label match is touched: never another scope's, another user's
    or an unlabelled container."""
    if not docker:
        return [], ''
    value = owner_value(unit)
    try:
        r = subprocess.run([docker, 'ps', '-a', '-q', '--no-trunc', '--filter', f'label={LABEL}={value}'],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=DOCKER_TIMEOUT)
        if r.returncode != 0:
            return [], (r.stderr.strip() or f'docker ps: exit {r.returncode}').splitlines()[-1]
        ids = [i for i in r.stdout.split() if re.fullmatch(r'[0-9a-f]{64}', i)]
        if not ids:
            return [], ''
        r = subprocess.run([docker, 'inspect', '--type', 'container', *ids], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=DOCKER_TIMEOUT)
        found = json.loads(r.stdout or '[]')      # one gone since `ps` is left out (exit 1, the rest printed)
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        return [], f'docker: {e}'
    mine = {}
    for c in found if isinstance(found, list) else []:
        try:
            if ((c.get('Config') or {}).get('Labels') or {}).get(LABEL) == value and c['Id'] in ids:
                mine[c['Id']] = short_name(c.get('Name') or '')
        except (AttributeError, KeyError, TypeError):
            continue
    if not mine:
        return [], ''
    try:
        r = subprocess.run([docker, 'rm', '-f', '-v', '--', *mine], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=DOCKER_TIMEOUT * 6)
    except (OSError, subprocess.SubprocessError) as e:
        return [], f'docker rm: {e}'
    done = set(r.stdout.split())
    removed = [name for cid, name in mine.items() if cid in done]
    failed = [line for line in r.stderr.splitlines() if line.strip() and 'No such container' not in line]
    return removed, (failed[-1] if failed else '')


def say_containers(why, unit, removed, problem):
    if removed:
        shown = ', '.join(removed[:MAX_NAMES]) + (', ...' if len(removed) > MAX_NAMES else '')
        say(f'{why}removed {len(removed)} leftover {"container" if len(removed) == 1 else "containers"} ({shown})')
    if problem:
        say(f'{why}could not remove the containers of {unit} ({problem}); the leftover sweep looks again')


class ScopeGuard:
    """heavy's guard: a process in a session of its own, outside the scope, that cleans up when heavy cannot. heavy
    tells it "done" once heavy itself has cleaned up; when heavy goes away without that (kill -9, a crash), the guard
    stops the scope (every process in it, double-forked ones too) and removes its containers, as heavy would have.
    It is not heavy's child (a double fork): a tree kill that walks heavy's children (pkill -9 -P, npm tree-kill)
    never finds it, and a kill of heavy's process group (kill -9 -PGID) never reaches it. It ignores the signals heavy
    forwards or handles (a terminal's, a service stop's TERM): it waits for heavy. It holds no open file of heavy's
    but stderr, and keeps nothing of the scope: a queued job's ticket ends with it."""

    def __init__(self, systemctl, docker, unit, grace, marks=()):
        self.w = self.alive = None
        try:
            r, w = os.pipe()                # heavy -> guard: "d", or end of file when heavy is gone
            alive_r, alive_w = os.pipe()    # guard -> heavy: end of file once the guard has ended
        except OSError:
            return              # no guard: heavy still cleans up after itself; the sweep is the fallback
        try:
            pid = os.fork()
        except OSError:
            for fd in (r, w, alive_r, alive_w):
                os.close(fd)
            return
        if pid == 0:
            try:
                os.close(w)
                os.close(alive_r)
                os.setsid()     # a group kill of heavy's group (kill -9 -PGID) never reaches it
                for sig in WATCH + FORWARD:
                    signal.signal(sig, signal.SIG_IGN)
                if os.fork() != 0:      # the guard is the child of this one, which ends now: heavy has no guard child
                    os._exit(0)
                signal.pthread_sigmask(signal.SIG_SETMASK, [])
                null = os.open('/dev/null', os.O_RDWR)
                os.dup2(null, 0)
                os.dup2(null, 1)
                for fd in [int(x) for x in os.listdir('/proc/self/fd')]:
                    if fd > 2 and fd not in (r, alive_w):
                        try:
                            os.close(fd)
                        except OSError:
                            pass
                prctl = load_prctl()
                if prctl is not None:
                    prctl(PR_SET_NAME, GUARD_NAME, 0, 0, 0)
                word = b''
                while True:
                    try:
                        word = os.read(r, 1)
                        break
                    except InterruptedError:
                        continue
                if word != b'd':
                    self.clean(systemctl, docker, unit, grace, marks)
            except BaseException:
                pass
            finally:
                os._exit(0)
        os.close(r)
        os.close(alive_w)
        try:
            os.waitpid(pid, 0)          # the first child ends at once
        except OSError:
            pass
        self.w, self.alive = w, alive_r

    @staticmethod
    def clean(systemctl, docker, unit, grace, marks=()):
        cg, pids = scope_state(systemctl, unit)
        text = describe(pids) if pids else ''
        left = stop_scope(systemctl, unit, cg, grace) if cg else []
        removed, problem = clean_containers(docker, unit, marks)
        why = 'heavy was killed: '
        if text:
            say(f'{why}stopped {text}')
        if left:
            say(f'{why}{len(left)} processes are still running in {unit}: {", ".join(map(str, left[:10]))}')
        say_containers(why, unit, removed, problem)

    def done(self):
        """heavy has cleaned up: the guard ends without doing anything. Returns once it has ended (it holds heavy's
        stderr: a pipe after heavy ends when both are gone)."""
        if self.w is None:
            return
        try:
            os.write(self.w, b'd')
        except OSError:
            pass
        self.abandon()
        try:
            while os.read(self.alive, 1):
                pass
        except OSError:
            pass
        os.close(self.alive)
        self.alive = None

    def abandon(self):
        """heavy cleaned up nothing (an error on the way): the end of file has the guard do it."""
        if self.w is not None:
            os.close(self.w)
            self.w = None


def load_prctl():
    try:   # loaded before a fork: the child only calls it
        import ctypes
        return ctypes.CDLL(None, use_errno=True).prctl
    except (ImportError, OSError, AttributeError):
        return None


class GroupProbe:
    """A child of heavy in heavy's process group that keeps the watched signals blocked. A signal sent to the whole
    group (kill -INT -PGID, timeout(1), a shell's `kill %1`) stays pending in it; one sent to heavy alone does not. So
    heavy passes a signal on to the command only when the command did not get it already."""

    def __init__(self, signals):
        self.pid = None
        prctl = load_prctl()
        try:
            r_cmd, self.w_cmd = os.pipe()
            self.r_ack, w_ack = os.pipe()
            pid = os.fork()
        except OSError:
            return
        if pid == 0:
            try:
                signal.pthread_sigmask(signal.SIG_BLOCK, signals)
                null = os.open('/dev/null', os.O_RDWR)
                for fd in (0, 1, 2):
                    os.dup2(null, fd)
                for fd in [int(x) for x in os.listdir('/proc/self/fd')]:
                    if fd > 2 and fd not in (r_cmd, w_ack):
                        try:
                            os.close(fd)
                        except OSError:
                            pass
                if prctl is not None:
                    prctl(PR_SET_PDEATHSIG, int(signal.SIGKILL), 0, 0, 0)
                    prctl(PR_SET_NAME, PROBE_NAME, 0, 0, 0)
                while os.read(r_cmd, 1):                      # 'd': drain; end of file: heavy is done
                    while signal.sigtimedwait(signals, 0) is not None:
                        pass
                    os.write(w_ack, b'k')
            finally:
                os._exit(0)
        os.close(r_cmd)
        os.close(w_ack)
        self.pid = pid

    def got(self, sig):
        """True when sig is pending in the probe: it was sent to the whole process group."""
        if self.pid is None:
            return False
        try:
            with open(f'/proc/{self.pid}/status', encoding='ascii') as f:
                for line in f:
                    if line.startswith(('ShdPnd:', 'SigPnd:')) and int(line.split()[1], 16) >> (sig - 1) & 1:
                        return True
        except (OSError, ValueError, IndexError):
            pass
        return False

    def drain(self):
        if self.pid is None:
            return
        import select
        try:
            os.write(self.w_cmd, b'd')
            if select.select([self.r_ack], [], [], 2)[0] and os.read(self.r_ack, 1):
                return
        except OSError:
            pass
        self.close()        # no answer: forward every signal from now on, as without a probe

    def close(self):
        if self.pid is None:
            return
        for fd in (self.w_cmd, self.r_ack):
            try:
                os.close(fd)
            except OSError:
                pass
        try:
            os.kill(self.pid, signal.SIGKILL)
            os.waitpid(self.pid, 0)
        except OSError:
            pass
        self.pid = None


def same_group(pid):
    try:
        return os.getpgid(pid) == os.getpgrp()
    except OSError:
        return False


def child_setup(restore_ignored, mask):
    prctl = load_prctl()
    parent = os.getpid()

    def setup():
        for sig in restore_ignored:
            signal.signal(sig, signal.SIG_IGN)
        signal.pthread_sigmask(signal.SIG_SETMASK, mask)
        if prctl is not None:   # heavy killed with -9: the command dies too, as when heavy and it were one process
            prctl(PR_SET_PDEATHSIG, int(signal.SIGKILL), 0, 0, 0)
            if os.getppid() != parent:      # heavy died before that took hold: never start the command alone
                os._exit(127)
    return setup


def finish(status, got):
    """Leave with the command's result: the same exit code, or die of the same signal."""
    code = os.waitstatus_to_exitcode(status)
    if code >= 0:
        return code
    sig = -code
    if got is not None and status_signal_was_ours(sig, got):
        sig = got
    if sig in RERAISE:
        try:
            signal.pthread_sigmask(signal.SIG_UNBLOCK, [sig])
            signal.signal(sig, signal.SIG_DFL)
            sys.stdout.flush()
            os.kill(os.getpid(), sig)
            time.sleep(1)
        except (OSError, ValueError):
            pass
    return 128 + sig


def status_signal_was_ours(sig, got):
    """The command died of the TERM/KILL the scope stop sent after heavy got `got`: report `got` instead."""
    return sig in (signal.SIGTERM, signal.SIGKILL) and got != sig


def slice_cgroup(systemctl, name):
    try:
        p = show(systemctl, name, ['ActiveState', 'ControlGroup'])
    except (Refused, subprocess.SubprocessError, OSError):
        return ''
    return p.get('ControlGroup', '') if p.get('ActiveState') == 'active' else ''


def cgroup_root():
    for root in CGROUP_ROOTS:
        if os.path.isfile(os.path.join(root, 'cgroup.controllers')):
            return root
    return CGROUP_ROOTS[0]


def queue_root():
    """HEAVY_QUEUE_ROOT (tests: a private queue, never the user's live one), else the default."""
    root = os.environ.get('HEAVY_QUEUE_ROOT')
    if root and not os.path.isabs(root):
        raise Refused(f'HEAVY_QUEUE_ROOT {root!r} is not an absolute path')
    return root or None


def queue_for(hq, cfg, systemctl, slice_cg, limits, capacity=None, settings=None):
    """The memory queue of the slice (lib/heavy_queue.py), with its settings from the machine file."""
    box = hq.Box(cfg['slice'], slice_cg, limits.get('MemoryHigh') or limits.get('MemoryMax'), cg_root=cgroup_root(),
                 queue_root=queue_root(), resolve=lambda: slice_cgroup(systemctl, cfg['slice']))
    return hq.Queue(box, settings or hq.settings(), capacity=capacity)


def capacity_check(slice_name=None):
    """(kind, mb) -> (free?, why): this kit's `heavy facts --fresh` for the job (#866), judged by free/v1's reader,
    with the same 20 s hold of a NOT OK as t3-capacity (lib/heavy_facts.py checked: one source); busy, no answer
    within 5 s or a broken answer is not free. Raises CheckCannotRun when this kit's facts can never answer free (the
    capacity rule not installed with it, a broken machine file, a basic tier machine: #981): waiting would only end
    at --wait. slice_name: heavy's slice (its folder must be listable)."""
    hf = kit_module('heavy_facts')
    heavy = hf.test_env('HEAVY_CHECK_HEAVY') or os.path.realpath(__file__)     # tests: a fake `heavy facts`
    if heavy == os.path.realpath(__file__):
        why = hf.ready(queue_module(), slice_name)
        if why:
            raise CheckCannotRun(why)

    def check(kind, mb):
        verdict, why, _ = hf.checked(heavy, kind, mb, fresh=True)
        return verdict == 'free', why
    return check


class CheckCannotRun(Exception):
    pass


def checker(argv, slice_name):
    """capacity_check(slice_name), or None after saying why heavy does not run argv (exit 1)."""
    try:
        return capacity_check(slice_name)
    except Exception as e:      # CheckCannotRun, or a kit that cannot load its facts: never a wait for nothing
        say(f'the capacity check cannot run: {e}; not running {argv[0]} (install the kit again with heavy-install, '
            f'fix the machine file, or set heavy.queue.capacityCheck to false)')
        return None


def scope_counted(box, unit, child, limit=SCOPE_START_SECONDS):
    """Wait until heavy facts can count the new scope (its cgroup has a memory.stat), at most `limit` seconds, or
    until the command has ended already (peeked at with WNOWAIT: wait_and_clean still reaps it). It runs under the
    queue lock, so it never asks systemd (Box.refresh may: a hung user manager would hold the lock past the queue
    verbs' 30 s, #981): a slice that was not active before (its first scope starts it) is read from the child's own
    cgroup, as systemd-run moves itself into the new scope before it runs the command."""
    deadline = time.monotonic() + limit
    while time.monotonic() < deadline:
        if not box.slice_cg:
            parent, _, leaf = cgroup_of(child.pid).rpartition('/')
            if leaf == unit and parent:
                box.slice_cg = parent
        folder = box.folder(unit)
        if folder and os.path.exists(os.path.join(folder, 'memory.stat')):
            return True
        try:
            if os.waitid(os.P_PID, child.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT) is not None:
                return False
        except ChildProcessError:
            return False
        time.sleep(0.02)
    return False


def run(argv, cfg, job=None):
    systemctl = tool('systemctl')
    systemd_run = tool('systemd-run')
    keep = os.environ.get('HEAVY_KEEP') == '1'
    limits = {}
    slice_cg = check_slice(systemctl, cfg['slice'], limits)
    env = caller_environ()
    nested = in_heavy_scope(slice_cg)
    if not keep and nested:     # the outer heavy holds the memory (and its queue place) for this command too
        env[b'HEAVY_SCOPE'] = own_cgroup().rpartition('/')[2].encode()
        for sig in PYTHON_IGNORED:
            signal.signal(sig, signal.SIG_DFL)
        try:
            os.execvpe(argv[0], argv, env)
        except OSError as e:
            say(f'{argv[0]}: {e.strerror}')
            return 127 if isinstance(e, FileNotFoundError) else 126
    grace = cfg['grace_seconds']
    unit = unit_name(argv[0], keep)
    env[b'HEAVY_SCOPE'] = unit.encode()
    queue = ticket = sampler = child_mask = admission = None
    if not nested and not (job is not None and job['kind']):
        # #866: a job without --kind waits for the machine's capacity rule too (a queued one asks it in the queue)
        hq = queue_module()
        try:
            settings = hq.settings()
        except Refused as e:        # the queue's settings only steer this wait: warn and wait as by default
            say(f'{e}; a job without --kind goes on with the default queue settings')
            settings = hq.default_settings()
        if settings['capacityCheck']:
            check = checker(argv, cfg['slice'])
            if check is None:
                return 1
            # under the queue lock, held until the scope can be counted: two waiters never take the same room
            admission = queue_for(hq, cfg, systemctl, slice_cg, limits, settings=settings)
            try:
                hq.capacity_wait(lambda: check(None, None), (job or {}).get('wait', DEFAULT_WAIT),
                                 settings['pollSeconds'], lock=admission)
            except OSError as e:
                say(f'memory queue: {e}; not running {argv[0]}')
                return 1
            except hq.GaveUp as e:
                say(f'{e}; not running {argv[0]}')
                return hq.EXIT_GAVE_UP
            except hq.Stopped as e:
                say(f'{signal.Signals(e.sig).name} while waiting for capacity; not running {argv[0]}')
                return finish(e.sig, None)
    if job is not None and job['kind'] and not nested:
        hq = queue_module()
        child_mask = signal.pthread_sigmask(signal.SIG_BLOCK, [])     # the mask now: the command's, as without a queue
        capacity = None
        if hq.settings()['capacityCheck']:
            capacity = checker(argv, cfg['slice'])
            if capacity is None:
                return 1
        try:
            queue = queue_for(hq, cfg, systemctl, slice_cg, limits, capacity=capacity)
            hq.check_kind(job['kind'])
            mb, _how = queue.reservation(job['kind'], job['mb'])
            # admitted: INT/TERM/HUP stay blocked from here until run_scope takes them, so one that comes just after
            # the admission is no traceback; one that came already stops heavy here, before the command starts
            ticket = queue.enter(job['kind'], mb, unit, os.path.basename(argv[0]), job['wait'], keep_blocked=True)
            hq.stopped_already()
        except OSError as e:
            say(f'memory queue: {e}; not running {argv[0]}')
            return 1
        except hq.GaveUp as e:
            say(f'{e}; not running {argv[0]}')
            return hq.EXIT_GAVE_UP
        except hq.Stopped as e:
            if ticket is not None:
                hq.release(queue, ticket)
                say(f'{signal.Signals(e.sig).name} just after the memory queue admitted it; not running {argv[0]}')
            else:
                say(f'{signal.Signals(e.sig).name} while waiting for memory; not running {argv[0]}')
            return finish(e.sig, None)
        sampler = hq.Sampler(queue, ticket)
        # The command inherits the ticket's flock: a heavy killed with -9 keeps the job's reservation until the
        # processes it started are gone (a normal end deletes the ticket, so a process that lives on holds nothing).
        os.set_inheritable(ticket.fd, True)
    measure_kind = (job or {}).get('measure') or (job or {}).get('kind')
    if measure_kind and not keep and not nested:     # a kept scope outlives the command: nothing to record
        try:
            hq = queue_module() if queue is None else hq
            hm = measure_module()
            hm.check_kind(measure_kind)
            box = queue.box if queue is not None else hq.Box(
                cfg['slice'], slice_cg, None, cg_root=cgroup_root(),
                resolve=lambda: slice_cgroup(systemctl, cfg['slice']))
            sampler = hm.Measurer(box, unit, measure_kind, hm.state_dir(), hq.cgroup_used, inner=sampler, out=say)
        except Exception as e:      # the measurement is never a reason not to run the job
            say(f'not recording the memory of {measure_kind}: {e}')
    started = None
    if admission is not None:
        def started(child):
            try:
                scope_counted(admission.box, unit, child)
            finally:
                admission.drop()
    try:
        return run_scope(argv, cfg, env, systemctl, systemd_run, keep, unit, grace, sampler, child_mask, started)
    finally:
        if admission is not None:
            admission.drop()
        if ticket is not None:
            hq.release(queue, ticket)


def run_scope(argv, cfg, env, systemctl, systemd_run, keep, unit, grace, sampler, child_mask=None, started=None):

    ignored = [s for s in WATCH + FORWARD if signal.getsignal(s) == signal.SIG_IGN]
    watch = [s for s in WATCH if s not in ignored]
    forward = [s for s in FORWARD if s not in ignored]
    chld_ignored = signal.getsignal(signal.SIGCHLD) == signal.SIG_IGN
    signal.signal(signal.SIGCHLD, signal.SIG_DFL)
    old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, watch + forward + [signal.SIGCHLD])
    restore = ignored + ([signal.SIGCHLD] if chld_ignored else [])
    cmd = [systemd_run, '--user', '--scope', '--quiet', '--collect', f'--slice={cfg["slice"]}', f'--unit={unit}',
           '-p', f'TimeoutStopSec={grace:g}s', '--', *argv]
    docker = docker_tool()
    marks = marks_dirs()    # also without Docker: a note `heavy docker-label` leaves is forgotten at the end
    give_marks(env, marks)
    # a kept scope outlives heavy on purpose: no guard for it (the command still dies with heavy)
    guard = None if keep else ScopeGuard(systemctl, docker, unit, grace, marks)
    probe = GroupProbe(list(WATCH + FORWARD))
    try:
        child = subprocess.Popen(cmd, close_fds=False, env=env,
                                 preexec_fn=child_setup(restore, old_mask if child_mask is None else child_mask))
    except OSError as e:
        probe.close()
        if guard is not None:
            guard.done()
        say(f'cannot start systemd-run: {e}')
        return 1
    try:
        if started is not None:     # the command runs: heavy's admission ends once its scope can be counted
            started(child)
        return wait_and_clean(child, probe, systemctl, unit, keep, grace, watch, forward, sampler, docker, guard,
                              marks)
    finally:
        probe.close()
        if guard is not None:       # an error on the way: heavy cleaned up nothing, the guard does
            guard.abandon()


def unchecked(why, unit):
    say(f'{why}could not check {unit} for leftovers (the systemd user manager did not answer); '
        f'look with: systemctl --user status {unit}')


def wait_and_clean(child, probe, systemctl, unit, keep, grace, watch, forward, sampler=None, docker=None, guard=None,
                   marks=()):

    # The first INT/TERM/HUP/QUIT reaches the command (heavy passes it on when it was sent to heavy alone); heavy
    # gives the command the grace time to end, then stops the whole scope. A second one stops the scope at once.
    got, status, deadline = None, None, None
    while status is None:
        pid, st = os.waitpid(child.pid, os.WNOHANG)
        if pid:
            status = st
            break
        if deadline is not None and time.monotonic() >= deadline:
            break
        wanted = watch + forward + [signal.SIGCHLD]
        if sampler is not None:         # a queued job: look at its memory every few seconds for its peak
            wait = sampler.interval if deadline is None else min(sampler.interval, deadline - time.monotonic())
            info = signal.sigtimedwait(wanted, max(0.0, wait))
            if info is None:
                sampler.sample()
        else:
            info = (signal.sigwaitinfo(wanted) if deadline is None
                    else signal.sigtimedwait(wanted, max(0.0, deadline - time.monotonic())))
        if info is None or info.si_signo == signal.SIGCHLD:
            continue
        sig = info.si_signo
        # A sender that signals heavy and then the whole group (timeout(1)) has done both after this moment; the
        # same signal again now is the same event, not a second signal.
        time.sleep(0.05)
        while signal.sigtimedwait([sig], 0) is not None:
            pass
        group = probe.got(sig) and same_group(child.pid)    # the command got this one itself
        probe.drain()
        # heavy passes on what a process sent to heavy alone; a terminal's signal (SI_KERNEL) reaches the command too
        pass_on = info.si_code <= 0 and not group
        if sig in forward:
            if pass_on:
                try:
                    os.kill(child.pid, sig)
                except OSError:
                    pass
            continue
        if got is not None:                         # a second signal: stop now
            got = sig
            break
        got = sig
        if pass_on:
            try:
                os.kill(child.pid, got)
            except OSError:
                pass
        deadline = time.monotonic() + grace

    if sampler is not None:             # one more look before the leftovers stop; every run teaches the queue,
        sampler.sample()                # failed and killed ones too (the reservation only ever goes up)
        if status is not None:          # after a signal to heavy only a short try for the lock: it wants out
            sampler.status = status     # the exit code goes into the measured record
            sampler.record() if got is None else sampler.record_soon()

    if status is None:                              # a signal to heavy, and the command is still running
        cg, pids = scope_state(systemctl, unit)
        if pids is None and not cg:
            unchecked(f'{signal.Signals(got).name}: ', unit)
        text = describe(pids) if pids else ''       # names now: the processes are gone after the stop
        left = stop_scope(systemctl, unit, cg, grace) if cg else []
        try:
            os.kill(child.pid, signal.SIGKILL)      # whatever happened to the scope, never leave the command behind
        except OSError:
            pass
        _, status = os.waitpid(child.pid, 0)
        if sampler is not None:         # stop now: after the scope stop, and only a short try for the queue lock
            sampler.status = status
            sampler.record_soon()
        name = signal.Signals(got).name
        if text:
            say(f'{name}: stopped {text}')
        if left:
            say(f'{name}: {len(left)} processes are still running in {unit}: {", ".join(map(str, left[:10]))}')
        say_containers(f'{name}: ', unit, *clean_containers(docker, unit, marks))
        if guard is not None:
            guard.done()
        return finish(status, got)

    why = f'{signal.Signals(got).name}: ' if got is not None else ''   # the command ended after a signal to heavy

    cg, pids = scope_state(systemctl, unit)
    if pids is None and not cg:                      # systemctl failed or timed out
        unchecked(why, unit)
    elif pids is None:                               # the scope is still there, but its cgroup cannot be read
        if keep and got is None:
            say(f'kept {unit} (HEAVY_KEEP=1; its processes cannot be read); stop it with: systemctl --user stop {unit}')
        else:
            left = stop_scope(systemctl, unit, cg, grace)
            say(f'{why}stopped {unit} (its processes cannot be read)' + (f'; {len(left)} still running' if left else ''))
    elif pids:
        if keep and got is None:
            say(f'kept {describe(pids)} in {unit} (HEAVY_KEEP=1); stop them with: systemctl --user stop {unit}')
        else:
            text = describe(pids)
            left = stop_scope(systemctl, unit, cg, grace)
            say(f'{why}stopped {text}')
            if left:
                say(f'{len(left)} processes are still running in {unit}: {", ".join(map(str, left[:10]))}')
    if not (keep and got is None):      # what the command left in Docker: kept with the scope, else removed
        say_containers(why, unit, *clean_containers(docker, unit, marks))
    else:
        forget(marks, unit)
    if guard is not None:
        guard.done()
    return finish(status, got)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 16), b''):
            h.update(block)
    return h.hexdigest()


def capacity_on_path():
    """None when the `t3-capacity` found on PATH is this kit's bin/t3-capacity (links resolved), else why not. Only a
    warning: a host may wire the command in itself, but another copy's readings can differ from the kit's."""
    import shutil
    kit = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'bin', 't3-capacity')
    found = shutil.which('t3-capacity')
    if found is None:
        return f't3-capacity is not on PATH (this kit\'s is {kit}; heavy-install links /usr/local/bin/t3-capacity)'
    if os.path.realpath(found) != os.path.realpath(kit):
        return (f't3-capacity on PATH is {found}, not this kit\'s {kit}: its readings can differ from the kit\'s '
                f'(heavy-install links /usr/local/bin/t3-capacity; remove the other copy or put that folder first)')
    return None


def self_check():
    problems = []
    try:
        cfg = load_config()
        print(f'config: slice {cfg["slice"]}, grace {cfg["grace_seconds"]:g}s')
        check_slice(tool('systemctl'), cfg['slice'])
        print(f'slice {cfg["slice"]}: loaded, has a memory limit')
    except (Refused, subprocess.SubprocessError, OSError) as e:
        problems.append(str(e))
    try:
        with open(INSTALLED, encoding='utf-8') as f:
            rows = [line.rstrip('\n').split('\t') for line in f if line.strip() and not line.startswith('#')]
    except FileNotFoundError:
        rows = None
        print(f'{INSTALLED}: not there (not installed by the kit); files not checked')
    except OSError as e:
        rows = None
        problems.append(f'cannot read {INSTALLED}: {e}')
    for row in rows or []:
        if len(row) != 3:
            problems.append(f'{INSTALLED}: bad row {row!r}')
            continue
        path, kind, want = row
        try:
            if kind == 'link':
                ok = os.readlink(path) == want
            elif kind == 'file':
                ok = sha256_file(path) == want
            else:
                ok = False
        except OSError:
            ok = False
        if not ok:
            problems.append(f'{path}: differs from what was installed ({kind})')
    if rows is not None:
        print(f'installed files: {len(rows)} checked')
    warning = capacity_on_path()
    print(f'WARNING: {warning}' if warning else 't3-capacity on PATH: this kit\'s')
    for p in problems:
        print(f'PROBLEM: {p}')
    print('self-check: ' + ('OK' if not problems else f'{len(problems)} problems'))
    return 0 if not problems else 1


def kit_module(name):
    """lib/<name>.py of this kit, loaded only when a verb or option needs it (plain heavy never does), by the kit's
    one loader (lib/kit_load.py, #800 item 5)."""
    lib = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib')
    sys.path[:0] = [] if lib in sys.path else [lib]
    import kit_load
    return kit_load.load(name, f'lib/{name}.py', __file__)


def job_options(argv):
    """(--kind/--mb/--wait/--measure as a dict, or None without them, or 'usage'; the rest of argv). --mb needs
    --kind; --measure works alone (no queue) or with --kind (another kind for the record); --wait alone is how long
    a job without --kind waits for capacity."""
    opts, rest = {}, list(argv)
    while rest and rest[0].split('=', 1)[0] in ('--kind', '--mb', '--wait', '--measure'):
        key, eq, value = rest.pop(0).partition('=')
        if not eq:
            if not rest:
                return 'usage', argv
            value = rest.pop(0)
        if key in opts:
            return 'usage', argv
        opts[key] = value
    if not opts:
        return None, argv
    # --mb needs --kind; --measure and --wait (how long a job without --kind waits for capacity, #866) work alone
    if not rest or ('--kind' not in opts and not set(opts) <= {'--measure', '--wait'}):
        return 'usage', argv
    try:
        mb = int(opts.get('--mb', 3072))
        wait = float(opts.get('--wait', DEFAULT_WAIT))
    except ValueError:
        return 'usage', argv
    if not 64 <= mb <= 1 << 20 or not 0 <= wait <= 7 * 86400:
        return 'usage', argv
    job = {'kind': opts.get('--kind'), 'mb': mb, 'wait': wait}
    if '--measure' in opts:
        job['measure'] = opts['--measure']
    return job, rest


def queue_module():
    hq = kit_module('heavy_queue')
    hq.Refused = Refused        # one Refused: the queue's refusals end heavy like its own (message, exit 1)
    return hq


def measure_module():
    hm = kit_module('heavy_measure')
    hm.Refused = Refused
    return hm


def queue_verb(verb, args):
    try:
        hq = queue_module()
        if args[:1] in (['-h'], ['--help']):
            print(hq.__doc__.split('\n\n')[0] + '\n\n' + hq.__doc__.split('\n\n')[1])
            return 0
        cfg = load_config()
        if verb == 'waits':
            return hq.waits_main(hq.Box(cfg['slice'], '', None).state_dir, args)
        systemctl = tool('systemctl')
        limits = {}
        slice_cg = check_slice(systemctl, cfg['slice'], limits)
        return hq.queue_main(queue_for(hq, cfg, systemctl, slice_cg, limits), args)
    except (Refused, OSError, ImportError, SyntaxError, subprocess.SubprocessError) as e:
        say(f'{verb}: {e}')
        return 1


def main(argv):
    if argv[:1] == ['--self-check']:
        return self_check()
    if argv[:1] in (['sweep'], ['leftovers'], ['docker-label']):
        try:
            mod = kit_module('heavy_sweep')
        except (OSError, ImportError, SyntaxError) as e:
            say(f'{argv[0]}: cannot load the sweep ({e})')
            return 1
        return {'sweep': mod.sweep_main, 'leftovers': mod.leftovers_main,
                'docker-label': mod.label_main}[argv[0]](argv[1:])
    if argv[:1] in (['queue'], ['waits']):
        return queue_verb(argv[0], argv[1:])
    if argv[:1] == ['facts']:
        try:
            hf = kit_module('heavy_facts')
            cfg = load_config()
            return hf.facts_main(argv[1:], cfg['slice'], queue_root(), queue_module())
        except (Refused, OSError, ImportError, SyntaxError, ValueError) as e:
            say(f'facts: {e}')
            return 1
    if argv[:1] == ['capacity']:
        try:
            hm = measure_module()
        except (OSError, ImportError, SyntaxError) as e:
            say(f'capacity: cannot load lib/heavy_measure.py ({e})')
            return 2
        return hm.capacity_main(argv[1:])
    job, argv = job_options(argv)
    if job == 'usage':
        print('usage: heavy --kind <name> [--mb N] [--wait SECONDS] [--measure <kind>] [--] <command> [args...]\n'
              '       heavy --measure <kind> [--] <command> [args...]', file=sys.stderr)
        return 2
    if argv[:1] == ['--']:
        argv = argv[1:]
        if not argv:
            print('usage: heavy <command> [args...]', file=sys.stderr)
            return 2
    if not argv or argv[:1] in (['-h'], ['--help']):
        print(__doc__.split('\n\n')[1] if argv else 'usage: heavy <command> [args...]',
              file=sys.stdout if argv else sys.stderr)
        return 0 if argv else 2
    try:
        return run(argv, load_config(), job)
    except (ImportError, SyntaxError) as e:
        say(f'cannot load the memory queue ({e}); not running {argv[0]}')
        return 1
    except OSError as e:
        say(f'{argv[0]}: {e}')
        return 1
    except Refused as e:
        say(f'{e}; not running {argv[0]}')
        return 1
    except subprocess.TimeoutExpired:
        say(f'the systemd user manager did not answer; not running {argv[0]}')
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
