#!/usr/bin/python3 -IB
"""t3-capacity: may one more piece of work start here? A thin caller of `heavy facts` (lib/heavy_facts.py).

  t3-capacity [--kind KIND] [--long] [MB]
  t3-capacity -h | --help

MB alone (default 3072): do MB fit the free budget at pressure level "ok". --kind: does the capacity rule admit one
piece of KIND (agent-writer, job-build, build, ...); with MB too, that piece declares MB (a floor of its cost), and
the rule alone decides (its job floor too).

Output: ONE line (#1150), so nobody needs to pipe it to see the answer:
  OK: free=<MB>MB need=<MB>MB available=<MB>MB swapfree=<MB>MB disk=<GB>GB
  NOT OK: <why> (free=<MB>MB need=<MB>MB available=<MB>MB swapfree=<MB>MB disk=<GB>GB)
with ` held=<MB>MB` after available= when reservations (reserve.d) hold memory back from this caller (--long names
them), and ` notes=<n>` at the end when heavy facts has notes (--long shows them). It reads the reservations itself,
so it needs no wrapper; a wrapper that prints a line of its own before it makes the output two lines. The
available= and swapfree= values are the ones of the long output's first line, so a reader that takes them from the
first line with available= in it reads the same numbers.
--long: the older t3-capacity's output, for people and for scripts that read its lines:
  line 1   available=<MB>MB swapfree=<MB>MB load=<load>/<n>cores agents=<n> jobs=<n> waiting=<n> reserved=<MB>MB
           need=<MB>MB free=<MB>MB level=<level> tier=<tier> disk=<GB>GB   (available: after the reservations
           that hold back this caller; reserved: what admitted jobs and agents may still grow into, so available -
           reserved counts each once; tier full, machine (no user manager: machine-wide numbers) or basic (never OK);
           disk: free GB on the work filesystem, `disk=<GB>GB<<floor>GB` when under the floor (NOT OK, #982),
           `disk=?` when it cannot be read (NOT OK))
  then     reservations: <name>:<MB>MB(using <MB>,holding <MB>) or <name>:own (a reservation of the caller's folder;
           holding is what is left after its use and the debts of agents and jobs working in it, ", owed <MB>")
           note: <text>, fits: <kind>=<n> ..., and last "NOT OK: <why>" or "OK".
Exit 0 OK, 1 NOT OK (busy, or heavy facts did not answer within 5 s: never OK), 2 a wrong call. A NOT OK holds 20 s
for the same question (kind and MB): an OK read within that time is "NOT OK: held: ..." (#861; heavy facts'
cache folder keeps it in t3-capacity-hold.json). A NOT OK with stdout
not a terminal also says on stderr that a pipe would hide the exit status.
"""
import os, stat, sys


KIT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def facts_module():
    """lib/heavy_facts.py of this kit, imported from the kit's own lib folder (root's once installed); it loads the
    rest with its own loader, the one copy (#800). Called inside the caller's try: a kit that cannot load is no
    answer, never a traceback."""
    lib = os.path.join(KIT, 'lib')
    if sys.path[:1] != [lib]:
        sys.path.insert(0, lib)
    import heavy_facts
    return heavy_facts


def main(argv):
    kind, need, long, rest = None, None, False, list(argv)
    while rest:
        a = rest.pop(0)
        if a in ('-h', '--help'):
            print(__doc__.strip())
            return 0
        if a in ('-l', '--long'):
            long = True
        elif a.startswith('--kind'):
            if kind is not None or (a == '--kind' and not rest):
                return usage()
            kind = rest.pop(0) if a == '--kind' else a.partition('=')[2]
        elif a.isdigit() and need is None and len(a) <= 7:
            need = int(a)
        else:
            return usage()
    need = 3072 if need is None and kind is None else need
    try:
        hf = facts_module()
        # ask, then the 20 s hold: the same check heavy makes before a job starts (#866, one source)
        verdict, why, d = hf.checked(hf.test_env('T3_CAPACITY_HEAVY') or os.path.join(KIT, 'bin', 'heavy'), kind, need)
    except Exception as e:      # the caller itself cannot run: never OK
        verdict, why, d = 'unavailable', f'{e.__class__.__name__}: {e}', None
    disk, disk_why = disk_answer()
    if disk_why is not None:    # #982: the disk's reason first, the memory's after it when that is NOT OK too
        why = f'disk: {disk_why}' + ('' if verdict == 'free' else f'; {why}')
        verdict = 'busy' if verdict == 'free' else verdict
    if not long:
        print(short_line(verdict, why, d, need, disk))
    elif d is None:
        print(f'available=0MB swapfree=0MB load=0/0cores need={need or 0}MB facts=unavailable {disk}')
        print(f'NOT OK: {why} (not free)')
    else:
        m, q, c = d['memory'], d['queue'], d['cpu']
        avail = max(0, (m['availableMb'] or 0) - (m['holdMb'] or 0))   # the rule's hold (all of it, not the
        # trimmed reservations list)
        print(f'available={avail}MB swapfree={m["swapFreeMb"]}MB load={c["load1"]}/{c["cores"]}cores '
              f'agents={q["agents"]} jobs={q["running"]} waiting={q["waiting"]} reserved={m["owedMb"]}MB '
              f'need={need if need is not None else m["costMb"]}MB free={m["freeMb"]}MB level={d["level"]} '
              f'tier={d["tier"]} {disk}')
        lines = []
        if d['reservations']:
            lines.append('reservations: ' + ' '.join(
                f'{r["name"]}:own' if r['own'] else
                f'{r["name"]}:{r["mb"]}MB(using {r["useMb"]},holding {held(r)}{owed(r)})'
                for r in d['reservations']))
        lines += [f'note: {n}' for n in d['notes']]
        lines.append('fits: ' + ' '.join(f'{k}={n}' for k, n in d['fits'].items()))
        lines.append('OK' if verdict == 'free' else f'NOT OK: {why}')
        print('\n'.join(lines))
    if verdict == 'free':
        return 0
    if not sys.stdout.isatty():
        print(not_ok_line(), file=sys.stderr)
    return 1


def short_line(verdict, why, d, need, disk):
    """The one line (#1150): the answer first, then the numbers a reader needs (the long output's own values)."""
    if d is None:
        return f'NOT OK: {why} (not free; available=0MB swapfree=0MB need={need or 0}MB {disk})'
    m = d['memory']
    nums = (f'free={m["freeMb"]}MB need={need if need is not None else m["costMb"]}MB '
            f'available={max(0, (m["availableMb"] or 0) - (m["holdMb"] or 0))}MB'
            + (f' held={m["holdMb"]}MB' if m['holdMb'] else '') + f' swapfree={m["swapFreeMb"]}MB {disk}'
            + (f' notes={len(d["notes"])}' if d['notes'] else ''))
    return f'OK: {nums}' if verdict == 'free' else f'NOT OK: {why} ({nums})'


def disk_answer():
    """(the first line's disk token, why NOT OK or None): free disk on the work filesystem against heavy.disk.floorGb
    (#982). A kit or setting that cannot be read is never OK."""
    try:
        hf = facts_module()
        import heavy_queue
        return hf.disk_check(heavy_queue)
    except Exception as e:
        return 'disk=?', f'{e.__class__.__name__}: {e}'


def not_ok_line():
    """The stderr line for NOT OK when stdout is no terminal (#931): a pipe or $(..) gets the warning, a file is told
    the gate holds (`t3-capacity N > f && cmd` is right, and the line used to warn there too), /dev/null by name."""
    try:
        mode = os.fstat(sys.stdout.fileno()).st_mode
        piped = stat.S_ISFIFO(mode) or stat.S_ISSOCK(mode)
    except (OSError, ValueError):
        mode, piped = 0, True
    if piped:
        return ('t3-capacity: NOT OK (exit 1). If this output goes through a pipe (`| tail`), the pipe hides this exit '
                'status: gate with `t3-capacity N && cmd`, never pipe it (`out=$(t3-capacity N) && cmd` is fine)')
    if stat.S_ISCHR(mode):   # > /dev/null (or another device)
        return ('t3-capacity: NOT OK (exit 1). The output went to /dev/null: the exit status is kept, so a gate like '
                '`t3-capacity N >/dev/null && cmd` holds and cmd does not run')
    return ('t3-capacity: NOT OK (exit 1). The output went to a file: the exit status is kept, so a gate like '
            '`t3-capacity N > f && cmd` holds and cmd does not run')


def held(r):
    """What a reservation holds back: its size less its use and the debts already counted (#923; an older heavy
    facts has no owedMb)."""
    return max(0, r['mb'] - r['useMb'] - (r.get('owedMb') or 0))


def owed(r):
    return f',owed {r["owedMb"]}' if r.get('owedMb') else ''


def usage():
    print('usage: t3-capacity [--kind KIND] [--long] [MB]  (t3-capacity --help says more)', file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
